# C++ style for core/, wasm/, harness/. Documents the existing convention;
# not auto-applied in bulk (run clang-format on files you touch).
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 0          # don't reflow hand-wrapped lines
AccessModifierOffset: -4
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
SortIncludes: false
