root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,cc}]
indent_style = space
indent_size = 4

[*.{ts,tsx,mts,mjs,js,jsx,json,css,html}]
indent_style = space
indent_size = 2

[*.{sh,py}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
