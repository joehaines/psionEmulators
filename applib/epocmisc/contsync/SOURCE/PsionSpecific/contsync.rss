RESOURCE DIALOG r_options_dialog
	{
	title = "Options";
	buttons = R_EIK_BUTTONS_CONTINUE;
	flags = EEikDialogFlagWait;
	items = 
		{
		DLG_LINE
			{
			type = EEikCtChoiceList;
			prompt = "Existing Contact Set";
			id = EContactDbRole;
			control = CHOICELIST
				{
				array_id=r_choicelistarray_list_contact_db_role_options;
				flags=EEikChlistIncrementalMatching;
				}; // end of the control
			},// end of the dialog line
		DLG_LINE
			{
			type = EEikCtChoiceList;
			prompt = "Network Type";
			id = ENetworkType;
			control = CHOICELIST
				{
				array_id=r_choicelistarray_list_network_type_options;
				flags=EEikChlistIncrementalMatching;
				}; // end of the control
			},// end of the dialog line
		DLG_LINE
			{
			type = EEikCtChoiceList;
			prompt = "Network Role";
			id = ENetworkRole;
			control = CHOICELIST
				{
				array_id=r_choicelistarray_list_network_role_options;
				flags=EEikChlistIncrementalMatching;
				}; // end of the control
			}// end of the dialog line
		
			
		};// end of the DLG_LINE
	}// end of resource options dialog


//Resource array used in choicelist for "Network Type Options". 
