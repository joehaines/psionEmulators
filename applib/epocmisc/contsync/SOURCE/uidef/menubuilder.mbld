<?xml version="1.0" encoding="UTF-8"?>

<window xmlns:symbian="http://www.symbian.com/" xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul">
  <symbian:filelocations sourceandresourcefiles="D:\Epoc\ContSync\gui\" headerfile="D:\Epoc\ContSync\inc\" />
  <keyset>
    <key id="EEikCmdExitKey" key="E" control="true" />
  </keyset>
  <menubar>
    <menu value="File">
      <menupopup>
	<menuitem value="Close" oncommand="EEikCmdExit" key="EEikCmdExitKey" />
      </menupopup>
    </menu>
    <menu value="Tools">
      <menupopup>
	<menuitem value="Database" oncommand="EContsyncDatabase" />
	<menuitem value="Connect" oncommand="EContsyncConnect" />
	<menuitem value="Synchronise" oncommand="EContsyncSynchronise" />
	<menuitem value="Options" oncommand="EContsyncOptions" />
      </menupopup>
    </menu>
  </menubar>
</window>

