\ls3\adjustright {\f1 a special code that will personalise your copy of Mileage, and remove all the nagging shareware screens.  Just enter the registration code provided under the System menu, Register option. 
\par {\pntext\pard\plain\s17 \f3\fs20\cf1\lang1033\cgrid \loch\af3\dbch\af0\hich\f3 \'b7\tab}}\pard \s17\fi-360\li360\widctlpar
\jclisttab\tx360\tx720\tx1080\tx1440\tx1800\tx2160\tx2520\tx2880\tx3240\tx3600\tx3960\tx4320\tx4680\tx5040\tx5400\tx5760\tx6120\tx6480\tx6840\tx7200\tx7560\tx7920\tx8280{\*\pn \pnlvlblt\ilvl0\ls3\pnrnot0\pnf3\pnstart1\pnindent360\pnhang{\pntxtb \'b7}}
\ls3\adjustright {\f1 Use of all three vehicles
\par }\pard \s17\fi-491\li851\widctlpar\adjustright {
