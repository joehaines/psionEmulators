{\rtf1\ansi\ansicpg1252\uc1 \deff0\deflang1033\deflangfe1033{\fonttbl{\f0\froman\fcharset0\fprq2{\*\panose 02020603050405020304}Times New Roman;}{\f2\fmodern\fcharset0\fprq1{\*\panose 02070309020205020404}Courier New;}}{\colortbl;\red0\green0\blue0;\red0\green0\blue255;\red0\green255\blue255;\red0\green255\blue0;\red255\green0\blue255;\red255\green0\blue0;\red255\green255\blue0;\red255\green255\blue255;\red0\green0\blue128;\red0\green128\blue128;\red0\green128\blue0;\red128\green0\blue128;\red128\green0\blue0;\red128\green128\blue0;\red128\green128\blue128;\red192\green192\blue192;}{\stylesheet{\qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid \snext0 Normal;}{\s1\qc\sa240\sl480\slmult0\nowidctlpar\widctlpar\adjustright \b\fs48\cf1\cgrid \snext1 heading 1;}{\s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\adjustright \b\cf1\cgrid \snext2 heading 2;}{\*\cs10 \additive Default Paragraph Font;}{\s15\qj\fi-360\li720\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\adjustright \cf1\cgrid \snext15 Bulleted List;}{\s16\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \f2\fs20\cf1\cgrid \snext16 Code;}}{\info{\operator Kevin Golding}{\creatim\yr1997\mo6\dy24\hr8\min6}{\revtim\yr1997\mo6\dy24\hr8\min18}{\version2}{\edmins12}{\nofpages5}{\nofwords652}{\nofchars3720}{\*\company UK Alarms}{\nofcharsws4568}{\vern71}}\paperw11906\paperh16838\margt1800\margb1800 \facingp\ftnbj\aenddoc\hyphhotz0\aftnnar\lytprtmet\hyphcaps0\viewkind1\viewscale117\viewzk2\pgbrdrhead\pgbrdrfoot \fet0\sectd \linex0\headery709\footery709\colsx709\sectdefaultcl {\footerl \pard\plain \qc\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {\field{\*\fldinst {\f2 PAGE  }}{\fldrslt {\f2\lang1024 2}}}{\f2 
\par }}{\footerr \pard\plain \qc\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {\field{\*\fldinst {\f2 PAGE  }}{\fldrslt {\f2\lang1024 1}}}{\f2 
\par }}{\*\pnseclvl1\pnucrm\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl2\pnucltr\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl3\pndec\pnstart1\pnindent720\pnhang{\pntxta .}}{\*\pnseclvl4\pnlcltr\pnstart1\pnindent720\pnhang{\pntxta )}}{\*\pnseclvl5\pndec\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl6\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl7\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl8\pnlcltr\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}{\*\pnseclvl9\pnlcrm\pnstart1\pnindent720\pnhang{\pntxtb (}{\pntxta )}}\pard\plain \s1\qc\sa240\sl480\slmult0\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\fs48\cf1\cgrid {LISTBOX for opl programmers
\par }\pard\plain \s2\qc\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {Copyright K.Golding 1997 \endash  24 June 1997
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {LISTBOX is an opo module to allow opl programmers to create a user friendly scrolling list box from within their own programs.
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {Whilst written entirely in opl, LISTBOX is fast enough to be usable - retrieving/redrawing data only when required.
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {LISTBOX can handle many lists in any one program, each lists requires only 40 bytes of memory, an integer handle and a single user defined procedure to draw the rows.
\par Please see the accompanying program "Listdemo.opl" for a quick start example, and the program "Test_lb.opl" for a more in depth example.
\par LISTBOX is provided as freeware to the private individual for use in Freeware programs, commercial/money making users please contact me before distribution of any programs to arrange contractual details.
\par I only ask that private users to please eMail me if you use LISTBOX, and a mention of LISTBOX in your about box of any programs using it!
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {Installing LISTBOX
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Copy the following files to your PSION's directorys as shown below, the open the "Listdemo.opl" file from the "Program" opl editor. Translate and run!
\par }\pard\plain \s16\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \f2\fs20\cf1\cgrid {\tab }{\ul File\tab \tab \tab Directory\tab Description
\par }{\tab Listbox.opo\tab \tab \\OPO\tab \tab The LISTBOX code module
\par \tab Listdemo.opl\tab \\OPL\tab \tab Simple demo program using LISTBOX
\par \tab Test_lb.opl\tab \tab \\OPL\tab \tab More in-depth demo program
\par 
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {Contacting the author
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {\tab eMail\tab UK_Alarms@cix.compulink.co.uk
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {Or join the superb CIX conference PSION.
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {
\par }\pard\plain \s1\qc\sa240\sl480\slmult0\nowidctlpar\widctlpar\outlinelevel0\adjustright \b\fs48\cf1\cgrid {List of available procedures
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LCreate%:(x%,y%,w%,h%,size%,font%,proc$)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Creates a new list
\par Where:
\par \tab x%, y%\tab Top left hand corner of the list box
\par \tab w%, h%\tab Width and height of the list box
\par \tab size%\tab \tab Size/amount of items in the list (can be zero)
\par \tab font%\tab \tab Font to use for the list box (see gFONT)
\par \tab proc$\tab \tab Name of custom line drawing procedure
\par Returns:
\par \tab Integer handle to the new list box
\par Example:
\par }\pard\plain \s16\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \f2\fs20\cf1\cgrid {\tab mylist% = LCreate%:(0,0,gWIDTH,gHEIGHT,100,10,"drawline")
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {This code creates a list which will fill the entire window, with 100 items, using font 10, and calling the user defined procedure "drawline:(item%, width%)"
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LClose%:(handle%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Closes the list box, clearing the used screen area and freeing any memory.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par Returns:
\par \tab 0 - zero
\par Example:
\par \tab mylist% = LClose%:(mylist%)
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {By using the LClose% procedure, any memory used by the list will be correctly freed, and the handle will be set to 0. You can therefore compare the value of the list handle with 0 to see if the list has been created or not. You can safely pass an undefined handle to LClose%, so long as the handle's value is 0.
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {\page LProcess:(handle%, key%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Handles users key presses (up/down arrows, page up/down, home and end keys).
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par \tab key%\tab \tab Key code as returned by GET or KEY
\par Example:
\par }\pard\plain \s16\sa120\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \f2\fs20\cf1\cgrid {\tab DO
\par \tab \tab k% = GET
\par \tab \tab LProcess:(mylist%, k%)
\par \tab UNTIL k% = 27
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LGoto:(handle%,index%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Jumps to a given items index, scrolling the list as required. If passed an invalid index (I.E less than 1 or more than the size) it moves the first or last item.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par \tab index%\tab The index of the item to move too (1 to size of list)
\par 
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LSelect%:(handle%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Returns the currently highlighted items index (1 to size).
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par Returns:
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {\tab An integer holding the current highlighted items index from 1 to the size of the list box, or 0 if no row selected
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {\page LChanged:(handle%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Redraws the current row (only), used when the underlying data has changed and the screen needs updating.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par 
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LFont:(handle%, font%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Changes the font used by the list, and redraws. Used for zooming.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {
\par }\pard \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright {LSize:(a%,size%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Resizes the list, and redraws. Used for example if viewing a datafile, to redraw the list showing any ordering changes due to UPDATE.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par 
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LInfo%:(a%,i%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Returns information about the list box.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par \tab i%\tab Used to determine which information is to be returned, see table below.
\par }\pard \qj\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {\tab }{\ul i%\tab Returned value
\par }{\tab 1\tab Size
\par \tab 2\tab X co-ordinate of top left corner
\par \tab 3\tab Y co-ordinate of top left corner
\par \tab 4\tab Width
\par \tab 5\tab Height
\par }\pard \qj\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {\tab 19\tab Font
\par }\pard \qj\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {Other, unlisted values for i% return garbage.
\par }\pard\plain \s2\sa120\sl240\slmult0\nowidctlpar\widctlpar\outlinelevel1\adjustright \b\cf1\cgrid {LBorder:(handle%,flags%)
\par }\pard\plain \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright \cf1\cgrid {Draws a simple border around the list box. This requires an additional four pixel gap around the sides of the list box.
\par Where:
\par \tab handle%\tab Integer handle as returned from LCreate%:
\par \tab flags%\tab \tab Style of border as for gBORDER
\par }\pard \qj\sa240\sl240\slmult0\nowidctlpar\widctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\adjustright {\f2 
\par }}