rem (c)Copyright 1997-1999 Twiddlebit Software

const KUidOpxGPrinter&=&10000542
const KOpxGPrinterVersion%=$110

DECLARE OPX GPRINTER,KUidOpxGPrinter&,KOpxGPrinterVersion%

	GPSetPenColor:(red%, green%, blue%) : 1
	GPSetPenWidth:(width&) : 2
	GPSetPenStyle:(style%) : 3
	GPSetBrushColor:(red%, green%, blue%) : 4
	GPSetBrushStyle:(style%) : 5
	GPSetDrawMode:(mode%) : 6
	GPSetClipRect:(x&,y&,w&,h&) : 7
	GPCancelClipRect: : 8

	GPAt:(x&, y&) : 20
	GPMove:(x&, y&) : 21
	GPLineBy:(x&, y&) : 22
	GPLineTo:(x&, y&) : 23
	GPBox:(width&, height&) : 24
	GPFill:(width&, height&) : 25

	GPSetFont:(font$,height&) : 40
	GPGetFontSpec:(BYREF array&) : 41
	GPTWidth&:(text$) : 42
	GPPrint:(text$) : 43
	GPPrintb:(text$, width&, align%, top&, bottom&, margin&) : 44
	GPPrintClip:(text$, width&) : 45

	GPSetCallback:(num%, proc$) : 60
	GPErrorMsg$: : 61
	GPPageSetup:(page_w&, page_h&, margin&, orient%, header$, footer$) : 62
	GPPageSetupDialog: : 63
	GPPrintPreviewDialog: : 64
	GPPrintRangeDialog: : 65
	GPPrintDialog: : 66

END DECLARE
