+ 	 return 0;
+ }
+ int Perl_my_pclose( int a) {
+ 	 return 0;
+ }
+ 
+ kill() {}
+ signal() {}
+ 
+ void execv() {}
+ void execvp() {}
+ void do_spawn() {}
+ void do_aspawn() {}
+ void Perl_do_exec() {}
+ 
