# Messages file for !ArcLink5. ©1997 Paul Vigay

# The following line defines the Wimp_Poll time delay
# (the higher, the quicker the transfer, but the less responsive the Acorn desktop.
wp:20

# The following defines the timeout period in mS. (ie. max time allowed before 'No link' status)
timeout:500
tfact:4

# Decide which side of the iconbar to put ArcLink (1=right, 2=left)
ib:1

# The following line defines the main menu block size (shouldn't need to be changed!)
mb:2000

# The following line defines the main menu indirected data block size (shouldn't need to be changed!)
md:1200

