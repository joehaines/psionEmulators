APP  moc
 TYPE $1003                    REM 1
 PATH "\MOC"                   REM 2
 EXT  "MOC"                    REM 3
 ICON "\OPL\MOCA.PIC"          REM 4
ENDA

PROC moc:
 TRAP CACHE 2048,10000         REM 5
 LOADM "\APP\LIB\FRAMELBA.OPO" REM 6
 LOADM "\APP\MOC\MOCLIBA.OPO"  REM 7
 LOADM "\APP\MOC\MOCS3A.OPO"   REM 8
 runMocA:                      REM 9
ENDP
