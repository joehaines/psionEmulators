PROC DGinit%:(title$)	LOCAL dg%,win%,oldwin%	oldwin%=gIDENTITY	win%=gCREATE(0,0,1,1,0,-1)	IF win%<>0		gUSE oldwin%		dg%=ALLOC(LEN(title$)+27)		IF dg%<>0			POKEW dg%,0			POKEW UADD(dg%,2),0			POKEW UADD(dg%,4),win%			POKEW UADD(dg%,6),0			POKEW UADD(dg%,8),0			POKEW UADD(dg%,10),0			POKEW UADD(dg%,12),0			POKEW UADD(dg%,14),0			POKEW UADD(dg%,16),0			POKEW UADD(dg%,18),0			POKEW UADD(dg%,20),0			POKEW UADD(dg%,22),0			POKEW UADD(dg%,24),0			POKE$ UADD(dg%,26),title$		ELSE			gCLOSE win%		ENDIF	ENDIF	RETURN dg%ENDPPROC DGtext%:(dg%,label$,flags%)	RETURN creafld%:(dg%,1,label$,flags%)ENDPPROC DGaddtx%:(field%,text$,def%)	LOCAL ptext%,line%,offset%,len%	IF def%		line%=PEEKW(UADD(field%,18))		ptext%=PEEKW(UADD(field%,34))	ELSE		line%=PEEKW(UADD(field%,20))		ptext%=PEEKW(UADD(field%,36))	ENDIF	IF ptext%<>0		offset%=PEEKW(UADD(field%,22))	ENDIF	len%=offset%+LEN(text$)+1	ptext%=REALLOC(ptext%,len%)	IF ptext%=0		RETURN -10	ENDIF	POKE$ UADD(ptext%,offset%),text$	POKEW UADD(field%,22),len%	IF def%		POKEW UADD(field%,18),line%+1		POKEW UADD(field%,34),ptext%	ENDIF	IF (PEEKW(UADD(field%,2)) AND 2)=0 OR NOT def%		POKEW UADD(field%,20),line%+1		POKEW UADD(field%,36),ptext%	ENDIF	RETURN 0ENDPPROC DGbuttn%:(dg%,key%,text$)	LOCAL bt%,nbuttn%,next%	bt% = ALLOC(LEN(text$)+15)	IF bt%<>0		POKEW bt%,0		POKEW UADD(bt%,12),key%		POKE$ UADD(bt%,14),text$		nbuttn%=PEEKW(UADD(dg%,2)) 		POKEW UADD(dg%,2),nbuttn%+1		next%=UADD(dg%,10)		WHILE nbuttn%>0			next%=PEEKW(next%)			nbuttn%=nbuttn%-1		ENDWH		POKEW next%,bt%	ENDIF	RETURN bt%ENDPPROC DGshow%:(dg%,font%)	GLOBAL winfo%(32)	LOCAL fldwdth%,titwdth%,maxwdth%,maxhght%	LOCAL nfields%,field%,width%,win%,ypos%	LOCAL oldwin%,height%,xpos%,mod%,p%,i%	LOCAL nbuttns%,btwdth%,button%,btxpos%,key%	LOCAL dglines%,dgline%,l%,line%,select%	LOCAL selypos%,nlines%,maxline%,topline%	LOCAL ptext%,p1%,p2%,l2%,str1%,str2%	LOCAL txtwdth%,labwdth%,cursabs%,selabs%	oldwin%=gIDENTITY	gUSE 1	maxwdth%=gWIDTH	maxhght%=gHEIGHT	win%=PEEKW(UADD(dg%,4))	gUSE win%	gCLS	gGREY 2	gFONT font%	gINFO winfo%()	nfields%=PEEKW(dg%)	nbuttns%=PEEKW(UADD(dg%,2))	titwdth%=gtWIDTH(PEEK$(UADD(dg%,26)))	IF titwdth%>0		height%=winfo%(3)+16	ELSE		height%=12	ENDIF	field%=PEEKW(UADD(dg%,6))	gSTYLE 1	WHILE field%<>0		labwdth%=MAX(labwdth%,gTWIDTH(PEEK$(UADD(field%,38))))		mod%=mod% OR ((PEEKW(UADD(field%,2)) AND 6)<>0)		field%=PEEKW(UADD(field%,4))	ENDWH	gSTYLE 0	IF labwdth%=0		xpos%=10	ELSE		xpos%=labwdth%+30	ENDIF	POKEW UADD(dg%,20),xpos%	txtwdth%=maxwdth%-xpos%-10	select%=PEEKW(UADD(dg%,8))	cursabs%=abspos%:(select%,26)	selabs%=abspos%:(select%,30)	field%=PEEKW(UADD(dg%,6))	WHILE field%<>0		nlines%=PEEKW(UADD(field%,20))		IF nlines%=0			ptext%=ALLOC(1)			IF ptext%=0				RETURN 0			ENDIF			POKEB ptext%,0			POKEW UADD(field%,36),ptext%			POKEW UADD(field%,20),1			nlines%=1		ELSE			nlines%=wraptxt%:(field%,-1,0,0,nlines%,txtwdth%,0)+1			IF nlines%<1				RETURN 0			ENDIF		ENDIF		POKEW UADD(field%,14),dglines%		dglines%=dglines%+nlines%		IF NOT mod%			i%=0 :p%=PEEKW(UADD(field%,36))			WHILE i%<nlines%				fldwdth%=MAX(fldwdth%,txtwdth%:(PEEK$(p%)))				p%=UADD(p%,PEEKB(p%)+1)				i%=i%+1			ENDWH		ENDIF		nfields%=nfields%-1		field%=PEEKW(UADD(field%,4))	ENDWH	button%=PEEKW(UADD(dg%,10))	WHILE nbuttns%>0		key%=PEEKW(UADD(button%,12))		IF key%=13			width%=gtWIDTH("Enter")		ELSEIF key%=27			width%=gtWIDTH("Esc")		ELSEIF key%=9			width%=gtWIDTH("Tab")		ELSEIF key%=290			width%=gtWIDTH("Menu")		ELSEIF key%=291			width%=gtWIDTH("Help")		ELSE			width%=gtWIDTH(CHR$(key%))		ENDIF		btwdth%=MAX(btwdth%,width%+12,gtWIDTH(PEEK$(UADD(button%,14))))		button%=PEEKW(button%)		nbuttns%=nbuttns%-1	ENDWH	nbuttns%=PEEKW(UADD(dg%,2))	nfields%=PEEKW(dg%)	IF mod%		width%=maxwdth%	ELSE		width%=MIN(maxwdth%,MAX(xpos%+fldwdth%+10,titwdth%+20,nbuttns%*(btwdth%+12)+20))	ENDIF	POKEW UADD(dg%,22),width%-xpos%-10	IF nbuttns%>0		height%=height%+winfo%(3)*2+18	ENDIF	POKEW UADD (dg%,14),dglines%	maxline% = (maxhght%-height%)/(winfo%(3)+1)	POKEW UADD (dg%, 16),maxline%	topline%=PEEKW(UADD(dg%,18))	IF dglines%-topline%<maxline%		topline%= MAX(0,dglines%-maxline%)	ENDIF	IF mod% OR dglines%>maxline%		dglines%=maxline%	ENDIF	height%=height%+dglines%*(winfo%(3)+1)	IF select%<>0		setpos:(select%,26,cursabs%)		setpos:(select%,30,selabs%)		selypos%=PEEKW(UADD(select%,28))		line%=PEEKW(UADD(select%,14))+selypos%		topline%=MIN(topline%,line%)		topline%=MAX(topline%,line%-dglines%+1)	ENDIF	ONERR winfail	gSETWIN (maxwdth%-width%)/2,(maxhght%-height%)/2,width%,height%	ONERR OFF	gVISIBLE ON	gXBORDER 1,$201	ypos%=winfo%(5)+7	IF titwdth%>0		gAT (width%-titwdth%)/2,ypos%		gPRINT PEEK$(UADD(dg%,26))		gAT 5,winfo%(3)+8 		gLINEBY width%-10,0		ypos%=ypos%+winfo%(3)+4	ENDIF	POKEW UADD(dg%,24), ypos%	dispall:(dg%,topline%,-1)	btxpos%=(width%-(nbuttns%-1)*(btwdth%+12))/2	button%=PEEKW(UADD(dg%,10))	ypos%=ypos%+dglines%*(winfo%(3)+1)	WHILE nbuttns%>0		gAT btxpos%-gtWIDTH(PEEK$(UADD(button%,14)))/2, ypos%+4		gPRINT PEEK$(UADD(button%,14))		POKEW UADD(button%,2), win%		POKEW UADD(button%,4),btxpos%-btwdth%/2		POKEW UADD(button%,6),ypos%+winfo%(4) + 6		POKEW UADD(button%,8),btwdth%		dispbutn:(button%,0)		button%=PEEKW(button%)		nbuttns%=nbuttns%-1		btxpos%=btxpos%+btwdth%+12	ENDWH	gVISIBLE ON	IF select%=0		gUSE oldwin%		RETURN -1	ELSEIF PEEKW(UADD(select%,2))=1		p%=PEEKW(UADD(select%,36))		i%=PEEKW(UADD(select%,20))-1		WHILE i%>0			p%=UADD(p%,PEEKB(p%)+1)			i%=i%-1		ENDWH		hilite:(select%,0,0,PEEKB(p%),PEEKW(UADD(select%,20))-1)	ELSEIF PEEKW(UADD(select%,30))<0		cursor:(select%,PEEKW(UADD(select%,26)),PEEKW(UADD(select%,28)))	ENDIF	gUSE oldwin%	RETURN select%winfail::	gUSE oldwin%	RETURN 0ENDPPROC DGmove%:(dg%,key%,mod%)	GLOBAL winfo%(32)	LOCAL nlines%,cursx%,cursy%,selx%,sely%	LOCAL field%,oldwin%,flags%,ulines%	LOCAL back%,textpos%,textlen%,ch$(1)	LOCAL space%,nospace%,maxline%,y%	field%=PEEKW(UADD(dg%,8))	maxline%=PEEKW(UADD(dg%,16))	oldwin%=gIDENTITY	gUSE PEEKW(UADD(dg%,4))	gINFO winfo%()	IF field%=0		IF key%=256			scrolldn:(dg%,1)		ELSEIF key%=257			scrollup:(dg%,1)		ELSEIF key%=260			scrolldn:(dg%,maxline%-1)		ELSEIF key%=261			scrollup:(dg%,maxline%-1)		ELSEIF key%=262			scrolldn:(dg%,32767)		ELSEIF key%=263			scrollup:(dg%,32767)		ENDIF		gUSE oldwin%		RETURN 0	ENDIF	flags%=PEEKW(UADD(field%,2))	IF (flags% AND 2)=0		IF key%=256			field%=newfld%:(field%,-1)		ELSEIF key%=257			field%= newfld%:(field%,1)		ENDIF		gUSE oldwin%		RETURN field%	ENDIF	ulines%=PEEKW(UADD(field%,20))	cursx%=PEEKW(UADD(field%,26))	cursy%=PEEKW(UADD(field%,28))	selx%=PEEKW(UADD(field%,30))	sely%=PEEKW(UADD(field%,32))	IF selx%>=0 AND (mod% AND 2)=0		IF key%=256 OR key%=259 OR key%=260			IF sely%<cursy% OR (sely%=cursy% AND selx%<cursx%)				cursx%=selx%				cursy%=sely%			ENDIF		ELSEIF key%=257 OR key%=258 OR key%=261			IF sely%>cursy% OR (sely%=cursy% AND selx%>cursx%)				cursx%=selx%				cursy%=sely%			ENDIF		ELSEIF key%=262			cursx%=0		ELSEIF key%=263			cursx%=255		ENDIF	ELSE		IF key%=256			cursy%=cursy%-1			back%=-1		ELSEIF key%=257			cursy%=cursy%+1			back%=-1		ELSEIF key%=258			IF (mod% AND 4)=4				textpos%=PEEKW(UADD(field%,36))				textlen%=PEEKB(textpos%)				WHILE y%<cursy%					textpos%=UADD(textpos%,textlen%+1)					textlen%=PEEKB(textpos%)					y%=y%+1				ENDWH				WHILE -1					ch$=MID$(PEEK$(textpos%),cursx%+1,1)					IF cursx%>=textlen%						ch$=CHR$(21)					ELSE						ch$=MID$(PEEK$(textpos%),cursx%+1,1)					ENDIF					IF ch$=CHR$(21)						IF cursy%>=ulines%-1							BREAK						ENDIF						cursy%=cursy%+1						cursx%=-1						textpos%=UADD(textpos%,textlen%+1)						textlen%=PEEKB(textpos%)						space%=-1					ELSEIF ch$=" "						space%=-1					ELSEIF space%						BREAK					ENDIF					cursx%=cursx%+1				ENDWH			ELSE				cursx%=cursx%+1			ENDIF		ELSEIF key%=259			IF (mod% AND 4) = 4				textpos%=PEEKW(UADD(field%,36))				textlen%=PEEKB(textpos%)				WHILE y%<cursy%					textpos%=UADD(textpos%,textlen%+1)					textlen%=PEEKB(textpos%)					y%=y%+1				ENDWH				WHILE -1					IF cursx%<=0						IF nospace% OR cursy%<=0							BREAK						ENDIF						cursy%=cursy%-1						textpos%=PEEKW(UADD(field%,36))						textlen%=PEEKB(textpos%)						y%=0						WHILE y%<cursy%							textpos%=UADD(textpos%,textlen%+1)							textlen%=PEEKB(textpos%)							y%=y%+1						ENDWH						cursx%=textlen%					ELSE						ch$=MID$(PEEK$(textpos%),cursx%,1) 						IF ch$<>" " AND ch$<>CHR$(21)							nospace%=-1						ELSEIF nospace%							BREAK						ENDIF					ENDIF					cursx%=cursx%-1				ENDWH			ELSE				cursx%=cursx%-1			ENDIF		ELSEIF key%=260			cursy%=MAX(0,cursy%-maxline%+1)			back%=-1		ELSEIF key%=261			cursy%=MIN(ulines%-1,cursy%+maxline%-1)			back%=-1		ELSEIF key%=262			cursx%=0			back%=0		ELSEIF key%=263			cursx%=255			back%=-1		ENDIF	ENDIF	IF selx%<0		IF cursy%<0			field%=newfld%:(field%,-1)		ELSEIF cursy%>=ulines%			field%=newfld%:(field%,1)		ELSE			moveto:(field%,cursx%,cursy%,mod%,back%)		ENDIF	ELSEIF (mod% AND 2)=0		endselct:(field%,cursx%,cursy%)	ELSE		moveto:(field%,cursx%,cursy%,mod%,back%)	ENDIF	gUSE oldwin%	RETURN field%ENDPPROC DGinsrt%:(dg%,text$)	GLOBAL winfo%(32)	LOCAL field%,cursx%,cursy%,selx%,sely%	LOCAL prevlns%,offset%,txtwdth%,p%,flags%	LOCAL addlns%,lastmod%,oldwin%,ret%,nlines%	field%=PEEKW(UADD(dg%,8))	IF field%=0		RETURN 0	ENDIF	flags%=PEEKW(UADD(field%,2))	prevlns%=PEEKW(UADD(field%,20))	IF (flags% AND 2)=2		cursx%=PEEKW(UADD(field%,26))		cursy%=PEEKW(UADD(field%,28))		selx%=PEEKW(UADD(field%,30))		sely%=PEEKW(UADD(field%,32))		offset%=adjfld%:(field%,cursx%,cursy%,selx%,sely%,LEN(text$)+1,1)		IF offset%<0			RETURN 0		ENDIF		cursx%=PEEKW(UADD(field%,26))		cursy%=PEEKW(UADD(field%,28))		p%=UADD(PEEKW(UADD(field%,36)),offset%+cursx%+1)	ELSEIF (flags% AND 4)=4		IF RIGHT$(text$,1)=CHR$(21)			p%=ALLOC(LEN(text$)+2)			IF p%=0				RETURN 0			ENDIF			POKEB UADD(p%,LEN(text$)+1),0			nlines%=2		ELSE			p%=ALLOC(LEN(text$)+1)			IF p%=0				RETURN 0			ENDIF			nlines%=1		ENDIF		POKEW UADD(field%,20),nlines%		POKEW UADD(field%,36),p%	ELSE		RETURN field%	ENDIF	POKE$ p%,text$	txtwdth%=PEEKW(UADD(dg%,22))	oldwin%=gIDENTITY	gUSE PEEKW(UADD(dg%,4))	gINFO winfo%()	IF (flags% AND 2)=2		lastmod%=wraptxt%:(field%,offset%,offset%+cursx%+1,cursy%+1,2,txtwdth%,$A)	ELSE		lastmod%=wraptxt%:(field%,-1,0,0,nlines%,txtwdth%,$A)	ENDIF	IF lastmod%<0		gUSE oldwin%		RETURN 0	ENDIF	POKEW UADD(dg%,12),-1	addlns%=PEEKW(UADD(field%,20))-prevlns%	IF RIGHT$(text$,1)=CHR$(21)		ret%=rdspfld%:(field%,0,cursy%+1,addlns%,lastmod%-cursy%)	ELSE		ret%=rdspfld%:(field%,cursx%+LEN(text$),cursy%,addlns%,lastmod%-cursy%)	ENDIF	gUSE oldwin%	RETURN ret%ENDPPROC DGpaste%:(dg%,paste%)	GLOBAL winfo%(32)	LOCAL field%,cursx%,cursy%,selx%,sely%	LOCAL prevlns%,offset%,txtwdth%,p%	LOCAL addlns%,lastmod%,oldwin%,ret%	LOCAL npaste%,pp%,l%,modlns%,plen%,n%	LOCAL flags%	field%=PEEKW(UADD(dg%,8))	IF field%=0		RETURN 0	ENDIF	flags%=PEEKW(UADD(field%,2))	prevlns%=PEEKW(UADD(field%,20))	IF paste%<>0		npaste%=PEEKW(paste%)	ENDIF	IF npaste%=0		RETURN field%	ENDIF	plen%=PEEKW(UADD(paste%,2))	IF (flags% AND 2)=2		cursx%=PEEKW(UADD(field%,26))		cursy%=PEEKW(UADD(field%,28))		selx%=PEEKW(UADD(field%,30))		sely%=PEEKW(UADD(field%,32))		offset%=adjfld%:(field%,cursx%,cursy%,selx%,sely%,plen%,npaste%)		IF offset%<0			RETURN 0		ENDIF		cursx%=PEEKW(UADD(field%,26))		cursy%=PEEKW(UADD(field%,28))		p%=UADD(PEEKW(UADD(field%,36)),offset%+cursx%+1)	ELSEIF (flags% AND 4)=4		p%=ALLOC(plen%)		IF p%=0			RETURN 0		ENDIF		POKEW UADD(field%,36),p%		POKEW UADD(field%,20),npaste%	ELSE		RETURN field%	ENDIF	pp%=PEEKW(UADD(paste%,4))	WHILE n%<npaste%		POKE$ p%,PEEK$(pp%)		l%=PEEKB(pp%)+1		p%=UADD(p%,l%)		pp%=UADD(pp%,l%)		n%=n%+1	ENDWH	txtwdth%=PEEKW(UADD(dg%,22))	oldwin%=gIDENTITY	gUSE PEEKW(UADD(dg%,4))	gINFO winfo%()	IF (flags% AND 2)=2		lastmod%=wraptxt%:(field%,offset%,offset%+cursx%+1,cursy%+1,npaste%+1,txtwdth%,$A)	ELSE		lastmod%=wraptxt%:(field%,-1,0,0,npaste%,txtwdth%,$A)	ENDIF	IF lastmod%<0		gUSE oldwin%		RETURN 0	ENDIF	cursx%=plen%-npaste%+cursx%	p%=UADD(PEEKW(UADD(field%,36)),offset%)	l%=PEEKB(p%)	modlns%=lastmod%-cursy%	WHILE cursx%>l%		cursx%=cursx%-l%		cursy%=cursy%+1		p%=UADD(p%,l%+1)		l%=PEEKB(p%)	ENDWH	addlns%=PEEKW(UADD(field%,20))-prevlns%	POKEW UADD(dg%,12),-1	ret%=rdspfld%:(field%,cursx%,cursy%,addlns%,modlns%)	gUSE oldwin%	RETURN ret%ENDPPROC DGdelet%:(dg%,mod%,paste%)	GLOBAL winfo%(32)	LOCAL field%,cursx%,cursy%,selx%,sely%	LOCAL prevlns%,offset%,txtwdth%,p%	LOCAL addlns%,lastmod%,oldwin%,ret%	LOCAL ptext%,l%,pp%,flags%	field%=PEEKW(UADD(dg%,8))	IF field%=0		RETURN 0	ENDIF	flags%=PEEKW(UADD(field%,2))	IF (flags% AND 2)=0		RETURN field%	ENDIF	cursx%=PEEKW(UADD(field%,26))	cursy%=PEEKW(UADD(field%,28))	selx%=PEEKW(UADD(field%,30))	sely%=PEEKW(UADD(field%,32))	prevlns%=PEEKW(UADD(field%,20))	txtwdth%=PEEKW(UADD(dg%,22))	oldwin%=gIDENTITY	gUSE PEEKW(UADD(dg%,4))	gINFO winfo%()	IF selx%>=0		copysel%:(field%,paste%)		offset%=adjfld%:(field%,cursx%,cursy%,selx%,sely%,0,0)		cursx%=PEEKW(UADD(field%,26))		cursy%=PEEKW(UADD(field%,28))		lastmod%=wraptxt%:(field%,offset%,offset%+cursx%+1,cursy%+1,1,txtwdth%,8)		IF lastmod%<0			gUSE oldwin%			RETURN 0		ENDIF		addlns%=PEEKW(UADD(field%,20))-prevlns%		ret%=rdspfld%:(field%,cursx%,cursy%,addlns%,lastmod%-cursy%)	ELSEIF mod%=2		ptext%=PEEKW(UADD(field%,36))		offset%=linoffs%:(ptext%,cursy%)		p%=UADD(ptext%,offset%)		l%=PEEKB(p%)		IF cursx%=l% AND cursy%<prevlns%-1			offset%=offset%+l%+1			p%=UADD(ptext%,offset%)			l%=PEEKB(p%)			cursx%=0			cursy%=cursy%+1			POKEW UADD(field%,26),0			POKEW UADD(field%,28),cursy%		ENDIF		IF cursx%=l%			BEEP 5,300			RETURN field%		ENDIF		ADJUSTALLOC(ptext%,offset%+cursx%+1,-1)		POKEB p%,l%-1		lastmod%=wraptxt%:(field%,-1,offset%,cursy%,1,txtwdth%,8)		IF lastmod%<0			gUSE oldwin%			RETURN 0		ENDIF		addlns%=PEEKW(UADD(field%,20))-prevlns%		ret%=rdspfld%:(field%,cursx%,cursy%,addlns%,lastmod%-cursy%)	ELSEIF mod%=10		ptext%=PEEKW(UADD(field%,36))		offset%=linoffs%:(ptext%,cursy%)		p%=UADD(ptext%,offset%)		l%=PEEKB(p%)		IF RIGHT$(PEEK$(p%),1)=CHR$(21) OR RIGHT$(PEEK$(p%),1)=" "			l%=l%-1		ENDIF		IF cursx%=l%			RETURN field%		ENDIF		IF paste%<>0			pp%=REALLOC(PEEKW(UADD(paste%,4)),l%-cursx%+1)			IF pp%<>0				POKE$ pp%,MID$(PEEK$(p%),cursx%+1,l%-cursx%)				POKEW paste%,1				POKEW UADD(paste%,2),l%-cursx%+1				POKEW UADD(paste%,4),pp%			ENDIF		ENDIF		ADJUSTALLOC(ptext%,offset%+cursx%+1,cursx%-l%)		POKEB p%,PEEKB(p%)-l%+cursx%		lastmod%=wraptxt%:(field%,-1,offset%,cursy%,1,txtwdth%,8)		IF lastmod%<0			gUSE oldwin%			RETURN 0		ENDIF		addlns%=PEEKW(UADD(field%,20))-prevlns%		ret%=rdspfld%:(field%,cursx%,cursy%,addlns%,lastmod%-cursy%)	ELSE		ptext%=PEEKW(UADD(field%,36))		IF cursx%=0			IF cursy%=0				BEEP 5,300				RETURN field%			ENDIF			cursy%=cursy%-1			offset%=linoffs%:(ptext%,cursy%)			p%=UADD(ptext%,offset%)			cursx%=PEEKB(p%)		ELSE			offset%=linoffs%:(ptext%,cursy%)			p%=UADD(ptext%,offset%)		ENDIF		ADJUSTALLOC(ptext%,offset%+cursx%,-1)		POKEB p%,PEEKB(p%)-1		POKEW UADD(field%,26),cursx%-1		POKEW UADD(field%,28),cursy%		lastmod%=wraptxt%:(field%,-1,offset%,cursy%,1,txtwdth%,8)		IF lastmod%<0			gUSE oldwin%			RETURN 0		ENDIF		addlns%=PEEKW(UADD(field%,20))-prevlns%		ret%=rdspfld%:(field%,cursx%-1,cursy%,addlns%,lastmod%-cursy%)	ENDIF	POKEW UADD(dg%,12),-1	gUSE oldwin%	RETURN ret%ENDPPROC DGcopy%:(dg%,paste%)	LOCAL field%	IF dg%<>0		field%=PEEKW(UADD(dg%,8))	ENDIF	IF field%=0 OR paste%=0		RETURN 0	ENDIF	RETURN copysel%:(field%,paste%)ENDPPROC DGrelbt%:(dg%,key%)	GLOBAL winfo%(32)	LOCAL button%,oldwin%	button%=buttnof%:(dg%,key%)	IF button%<>0		oldwin%=gIDENTITY		gUSE PEEKW(UADD(dg%,4))		gINFO winfo%()		dispbutn:(button%,0)		gUSE oldwin%	ENDIF	RETURN button%ENDPPROC DGpshbt%:(dg%,key%)	GLOBAL winfo%(32)	LOCAL button%,oldwin%	button%=buttnof%:(dg%,key%)	IF button%<>0		oldwin%=gIDENTITY		gUSE PEEKW(UADD(dg%,4))		gINFO winfo%()		dispbutn:(button%,2)		gUSE oldwin%	ENDIF	RETURN button%ENDPPROC DGclear%:(dg%)	LOCAL nfields%,field%,nextfld%,win%,nbuttns%,button%,nextbtn%	IF dg%=0		RETURN 0	ENDIF	win%=PEEKW(UADD(dg%,4))	IF win%>0		gCLOSE win%	ENDIF	nfields%=PEEKW(dg%)	field%=PEEKW(UADD(dg%,6))	WHILE nfields%>0		nfields%=nfields%-1		nextfld%=PEEKW(UADD(field%,4))		FREEALLOC PEEKW(UADD(field%,36))		FREEALLOC field%		field%=nextfld%	ENDWH	nbuttns%=PEEKW(UADD(dg%,2))	button%=PEEKW(UADD(dg%,10))	WHILE nbuttns%>0		nextbtn%=PEEKW(button%)		nbuttns%=nbuttns%-1		FREEALLOC button%		button%=nextbtn%	ENDWH	FREEALLOC dg%	RETURN 0ENDPPROC DGmoddg%:(dg%)	RETURN PEEKW(UADD(dg%,12))ENDPPROC DGmodfd%:(field%)	RETURN ((PEEKW(UADD(field%,2)) AND 8) = 8)ENDPPROC DGismod%:(field%)	RETURN ((PEEKW(UADD(field%,2)) AND 2) = 2)ENDPPROC DGflns%:(field%)	LOCAL ulines%	IF field%=0		RETURN 0	ENDIF	ulines%=PEEKW(UADD(field%,20))	IF ulines%=1 AND PEEKB(PEEKW(UADD(field%,36)))=0		RETURN 0	ELSE		RETURN ulines%	ENDIFENDPPROC DGgetxy:(field%,pxy%)	POKEW pxy%,PEEKW(UADD(field%,26))	POKEW UADD(pxy%,2),PEEKW(UADD(field%,28))	POKEW UADD(pxy%,4),PEEKW(UADD(field%,30))	POKEW UADD(pxy%,6),PEEKW(UADD(field%,32))ENDPPROC DGfstln%:(field%)	LOCAL p%	p%=PEEKW(UADD(field%,36))	POKEW UADD(field%,22),PEEKB(p%)+1	RETURN p%ENDPPROC DGnxtln%:(field%)	LOCAL l%,p%	l%=PEEKW(UADD(field%,22))	p%=UADD(PEEKW(UADD(field%,36)),l%)	POKEW UADD(field%,22),l%+PEEKB(p%)+1	RETURN p%ENDPPROC DGselct%:(dg%)	IF dg%=0		RETURN 0	ELSE		RETURN PEEKW(UADD(dg%,8))	ENDIFENDPPROC DGmodtx%:(field%,text$)	LOCAL ptext%,dg%,line%,winfo%(32)	LOCAL xpos%,ypos%,oldwin%	ptext%=REALLOC(PEEKW(UADD(field%,36)),LEN(text$)+1)	IF ptext%=0		RETURN 0	ENDIF	POKE$ ptext%,text$	POKEW UADD(field%,36),ptext%	dg%=PEEKW(UADD(field%,12))	line%=PEEKW(UADD(field%,14))-PEEKW(UADD(dg%,18))	IF line%>=0 AND line%<PEEKW(UADD(dg%,16))		oldwin%=gIDENTITY		gUSE PEEKW(UADD(dg%,4))		gINFO winfo%()		xpos%=PEEKW(UADD(dg%,20))		ypos%=PEEKW(UADD(dg%,24))+line%*(winfo%(3)+1)		gAT xpos%-1,ypos%-winfo%(5)-1		gFILL gWIDTH-xpos%-9,winfo%(3)+1,1		gAT xpos%,ypos%		gPRINT text$		IF field%=PEEKW(UADD(dg%,8)) AND (PEEKW(UADD(field%,2)) AND 7)=1 AND LEN(text$)>0			gAT xpos%-1,ypos%-winfo%(5)-1			gFILL gTWIDTH(text$)+1,winfo%(3)+1,2		ENDIF		gUSE oldwin%	ENDIF	RETURN -1ENDP