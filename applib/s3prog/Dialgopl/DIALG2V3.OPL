PROC moveto:(field%,tox%,toy%,mod%,goback%)	GLOBAL linelen%	LOCAL left%, textpos%, displen%, textlen%	LOCAL line%, dg%, fldwdth%, maxline%	LOCAL cursx%, cursy%, selx%, sely%	LOCAL topline%, ulines%, flags%,y%	textpos%=PEEKW(UADD(field%,36))	textlen%=PEEKB(textpos%)	WHILE y%<toy%		textpos%=UADD(textpos%,textlen%+1)		textlen%=PEEKB(textpos%)		y%=y%+1	ENDWH	flags%=PEEKW(UADD(field%,2))	IF (flags% AND 2)=0		textlen%=0	ELSEIF RIGHT$(PEEK$(textpos%),1)=CHR$(21) rem OR RIGHT$(PEEK$(textpos%),1)=" "		textlen%=textlen%-1	ENDIF	ulines%=PEEKW(UADD(field%,20))	IF toy%<0		BEEP 5,300		RETURN	ELSEIF toy%>=ulines%		moveto:(field%,255,ulines%-1,mod%,-1)		RETURN	ELSEIF tox%<0		moveto:(field%,255,toy%-1,mod%,-1)		RETURN	ELSEIF tox%>textlen%		IF goback%			moveto:(field%,textlen%,toy%,mod%, 0)		ELSE			moveto:(field%,0,toy%+1,mod%,0)		ENDIF		RETURN	ENDIF	dg%=PEEKW(UADD(field%,12))	maxline%=PEEKW(UADD(dg%,16))	topline%=PEEKW(UADD(dg%,18))	line%=PEEKW(UADD(field%,14))-topline%+toy%	IF line%<0		scrolldn:(dg%,-line%)	ELSEIF line%>=maxline%		scrollup:(dg%,line%-maxline%+1)	ENDIF	cursx%=PEEKW(UADD(field%,26))	cursy%=PEEKW(UADD(field%,28))	selx%=PEEKW(UADD(field%,30))	sely%=PEEKW(UADD(field%,32))	IF (mod% AND 2)=2		hilite:(field%,cursx%,cursy%,tox%,toy%)		IF selx%<0			POKEW UADD(field%,30),cursx%			POKEW UADD(field%,32),cursy%		ENDIF	ENDIF	POKEW UADD(field%,26),tox%	POKEW UADD(field%,28),toy%	IF (mod% AND 2)=0		cursor:(field%,tox%,toy%)	ENDIFENDPPROC buttnof%:(dg%,key%)	LOCAL button%,nbuttns%	nbuttns%=PEEKW(UADD(dg%,2))	button%=PEEKW(UADD(dg%,10))	WHILE nbuttns%>0		IF key%=PEEKW(UADD(button%,12))			RETURN button%		ENDIF		button%=PEEKW(button%)		nbuttns%=nbuttns%-1	ENDWH	RETURN 0ENDPPROC abspos%:(field%,offset%)	LOCAL pos%,l%,p%,y%	IF field%<>0		pos%=PEEKW(UADD(field%,offset%))		y%=PEEKW(UADD(field%,offset%+2))		p%=PEEKW(UADD(field%,36))		WHILE pos%>0 AND y%>0			l%=PEEKB(p%)			pos%=pos%+l%			p%=UADD(p%,l%+1)			y%=y%-1		ENDWH	ENDIF	RETURN pos%ENDPPROC setpos:(field%,offset%,pos%)	LOCAL x%,y%,p%,l%	x%=pos%	p%=PEEKW(UADD(field%,36))	WHILE -1		l%=PEEKB(p%)		IF x%<=l%			BREAK		ENDIF		x%=x%-l%		y%=y%+1		p%=UADD(p%,l%+1)	ENDWH	POKEW UADD(field%,offset%),x%	POKEW UADD(field%,offset%+2),y%ENDPPROC copysel%:(field%,paste%)	LOCAL xmin%,ymin%,xmax%,ymax%,p%,l%,len%	LOCAL ptext%,x%,y%	xmin%=PEEKW(UADD(field%,30))	IF xmin%<0		RETURN 0	ENDIF	ymin%=PEEKW(UADD(field%,32))	xmax%=PEEKW(UADD(field%,26))	ymax%=PEEKW(UADD(field%,28))	IF ymax%<ymin% OR (ymax%=ymin% AND xmax%<xmin%)		xmax%=xmin%		ymax%=ymin%		xmin%=PEEKW(UADD(field%,26))		ymin%=PEEKW(UADD(field%,28))	ENDIF	ptext%=PEEKW(UADD(field%,36))	WHILE y%<ymin%		ptext%=UADD(ptext%,PEEKB(ptext%)+1)		y%=y%+1	ENDWH	l%=PEEKB(ptext%)	p%=PEEKW(UADD(paste%,4))	x%=xmin%	WHILE y%<=ymax%		IF y%=ymax%			l%=xmax%-x%		ELSE			l%=PEEKB(ptext%)-x%		ENDIF		p%=REALLOC(p%,len%+l%+1)		IF p%=0			POKEW paste%,0			RETURN -1		ENDIF		POKEW UADD(paste%,4),p%		POKE$ UADD(p%,len%),MID$(PEEK$(ptext%),x%+1,l%)		len%=len%+l%+1		ptext%=UADD(ptext%,PEEKB(ptext%)+1)		y%=y%+1		x%=0	ENDWH	POKEW paste%,ymax%-ymin%+1	POKEW UADD(paste%,2),len%	RETURN ymax%-ymin%+1ENDPPROC linoffs%:(ptext%,line%)	LOCAL offset%,y%,l%,p%	p%=ptext%	WHILE y%<line%		l%=PEEKB(p%)		offset%=offset%+l%+1		p%=UADD(p%,l%+1)		y%=y%+1	ENDWH	RETURN offset%ENDPPROC rdspfld%:(field%,cursx%,cursy%,addlns%,modlns%)	LOCAL fline%,dg%,topline%,dglines%,f%	LOCAL maxline%,dsplns%,oldx%,oldy%,dline%	LOCAL x%,y%,p%,len%,add%,sline%,ypos%,pold%	LOCAL nscroll%,scroll%,gap%,width%,height%	LOCAL nwdslns%,xpos%,xwin%,ywin%	fline%=PEEKW(UADD(field%,14))	dg%=PEEKW(UADD(field%,12))	topline%=PEEKW(UADD(dg%,18))	dglines%=PEEKW(UADD(dg%,14))	maxline%=PEEKW(UADD(dg%,16))	dsplns%=MIN(maxline%,dglines%)	nwdslns%=MIN(maxline%,dglines%+addlns%)	POKEW UADD(dg%,14),dglines%+addlns%	ypos%=PEEKW(UADD(dg%,24))-winfo%(5)-1	oldx%=PEEKW(UADD(field%,26))	oldy%=PEEKW(UADD(field%,28))	p%=PEEKW(UADD(field%,36))	len%=PEEKB(p%)	WHILE y%<oldy%		p%=UADD(p%,len%+1)		len%=PEEKB(p%)		y%=y%+1	ENDWH	pold%=p%	x%=cursx%	WHILE -1		IF y%>=cursy%			IF x%<=len%				BREAK			ENDIF			x%=x%-len%		ENDIF		p%=UADD(p%,len%+1)		len%=PEEKB(p%)		y%=y%+1	ENDWH	IF addlns%<>0		f%=PEEKW(UADD(field%,4))		WHILE f%<>0			POKEW UADD(f%,14),PEEKW(UADD(f%,14))+addlns%			f%=PEEKW(UADD(f%,4))		ENDWH	ENDIF	dline%=fline%-topline%+y%	IF dline%<0		topline%=topline%+dline%		IF dline%=addlns%			POKEW UADD(dg%,18),topline%			dspdglns:(dg%,0,0)		ELSEIF addlns%>dline%			POKEW UADD(dg%,18),topline%			scroll%=addlns%-dline%			nscroll%=maxline%-MAX(scroll%,dline%+modlns%+1)			IF nscroll%<=0				dspdglns:(dg%,0,maxline%-1)			ELSE				dline%=maxline%-scroll%-nscroll%				gSCROLL 0,scroll%*(winfo%(3)+1),9,ypos%+dline%*(winfo%(3)+1),gWIDTH-19,nscroll%*(winfo%(3)+1)				dspdglns:(dg%,0,dline%+scroll%-1)			ENDIF		ELSE			gap%=MAX(0,nwdslns%-dglines%-addlns%+topline%)			scroll%=dline%-addlns%-gap%			topline%=topline%-gap%			POKEW UADD(dg%,18),topline%			IF scroll%=0				dspdglns:(dg%,0,gap%)			ELSE				dline%=dline%-addlns%+1				nscroll%=maxline%-dline%				IF nscroll%<=0					dspdglns:(dg%,0,nwdslns%-1)				ELSE					gSCROLL 0,-scroll%*(winfo%(3)+1),9,ypos%+dline%*(winfo%(3)+1),gWIDTH-19,nscroll%*(winfo%(3)+1)					dspdglns:(dg%,0,gap%)					dspdglns:(dg%,maxline%-scroll%,nwdslns%-1)				ENDIF				clrlns:(dg%,nwdslns%,maxline%-1)			ENDIF		ENDIF	ELSEIF dline%>=maxline%		scroll%=dline%-maxline%+1		topline%=topline%+scroll%		dline%=fline%-topline%+oldy%		POKEW UADD(dg%,18),topline%		nscroll%=dline%+1		IF nscroll%<0			dspdglns:(dg%,0,nwdslns%-1)		ELSE			gSCROLL 0,-scroll%*(winfo%(3)+1),9,ypos%+scroll%*(winfo%(3)+1),gWIDTH-19,nscroll%*(winfo%(3)+1)			disppart:(field%,pold%,dline%,oldx%,oldy%)			dspdglns:(dg%,dline%+1,maxline%-1)		ENDIF	ELSE		dline%=fline%-topline%+oldy%		IF dline%>=0			disppart:(field%,pold%,dline%,oldx%,oldy%)		ENDIF		IF addlns%<0			gap%=MAX(0,nwdslns%-dglines%-addlns%+topline%)			gSCROLL 0,gap%*(winfo%(3)+1),9,ypos%,gWIDTH-19,(dline%+1)*(winfo%(3)+1)			topline%=topline%-gap%			POKEW UADD(dg%,18),topline%			dspdglns:(dg%,0,gap%-1)			sline%=dline%+modlns%-addlns%+1			scroll%=-addlns%-gap%			nscroll%=dsplns%-sline%			IF nscroll%>0				gSCROLL 0,-scroll%*(winfo%(3)+1),9,ypos%+sline%*(winfo%(3)+1),gWIDTH-19,nscroll%*(winfo%(3)+1)			ENDIF			dspdglns:(dg%,dsplns%-scroll%,nwdslns%-1)			clrlns:(dg%,nwdslns%,dsplns%-1)			dline%=dline%+gap%		ELSEIF addlns%>0			sline%=dline%+modlns%-addlns%+1			nscroll%=nwdslns%-sline%-addlns%			IF nscroll%>0				gSCROLL 0,addlns%*(winfo%(3)+1),9,ypos%+sline%*(winfo%(3)+1),gWIDTH-19,nscroll%*(winfo%(3)+1)			ENDIF		ENDIF		dspdglns:(dg%,dline%+1,dline%+modlns%)	ENDIF	moveto:(field%,x%,y%,0,0)	RETURN field%ENDPPROC clrlns:(dg%,from%,to%)	IF from%<=to%		gAT 9,PEEKW(UADD(dg%,24))+from%*(winfo%(3)+1)-winfo%(5)-1		gFILL gWIDTH-19,(to%-from%+1)*(winfo%(3)+1),1	ENDIFENDPPROC disppart:(field%,ptext%,line%,fromx%,fromy%)	LOCAL x%,y%,dg%,n%,l%	n%=MIN(fromx%,PEEKB(ptext%))	dg%=PEEKW(UADD(field%,12))	x%=PEEKW(UADD(dg%,20))+gTWIDTH(LEFT$(PEEK$(ptext%),n%))	y%=PEEKW(UADD(dg%,24))+line%*(winfo%(3)+1)	gAT x%-1,y%-winfo%(5)-1	gFILL gWIDTH-x%-9,winfo%(3)+1,1	gAT x%,y%	IF (PEEKW(UADD(field%,2)) AND 6)=4		gGREY 1	ENDIF	IF RIGHT$(PEEK$(ptext%),1)=CHR$(21)		l%=PEEKB(ptext%)-n%-1	ELSE		l%=PEEKB(ptext%)-n%	ENDIF	IF l%>0		gPRINT MID$(PEEK$(ptext%),n%+1,l%)	ENDIF	gGREY 2ENDPPROC adjfld%:(field%,fromx%,fromy%,tox%,toy%,addlen%,addlns%)	LOCAL x%,y%,l%,p%,len%,ptext%,offset%	IF tox%<0		RETURN adjfld%:(field%,fromx%,fromy%,fromx%,fromy%,addlen%,addlns%)	ELSEIF toy%<fromy% OR (toy%=fromy% AND tox%<fromx%)		RETURN adjfld%:(field%,tox%,toy%,fromx%,fromy%,addlen%,addlns%)	ENDIF	ptext%=PEEKW(UADD(field%,36))	p%=ptext%	WHILE y%<fromy%		offset%=offset%+PEEKB(p%)+1		p%=UADD(ptext%,offset%)		y%=y%+1	ENDWH	x%=fromx%	len%=addlen%	l%=PEEKB(p%)+1	WHILE y%<toy%		len%=len%-l%+x%		p%=UADD(p%,l%)		x%=0		y%=y%+1		l%=PEEKB(p%)+1	ENDWH	len%=len%-tox%+x%+1	ptext%=ADJUSTALLOC(ptext%,offset%+fromx%+1,len%)	IF ptext%=0		RETURN -1	ENDIF	POKEB UADD(ptext%,offset%),fromx%	POKEB UADD(ptext%,offset%+fromx%+addlen%+1),l%-tox%-1	POKEW UADD(field%,36),ptext%	POKEW UADD(field%,26),fromx%	POKEW UADD(field%,28),fromy%	POKEW UADD(field%,30),-1	POKEW UADD(field%,20),PEEKW(UADD(field%,20))-toy%+fromy%+addlns%+1	RETURN offset%ENDPPROC creafld%:(dg%,type%,label$,flags%)	LOCAL d%,first%,last%,textpos%,oldwin%	d%=ALLOC(LEN(label$)+39)	IF d%<>0		POKEW d%,type%		POKEW UADD(d%,2),flags%		POKEW UADD(d%,12),dg%		POKEW UADD(d%,18),0		POKEW UADD(d%,20),0		POKEW UADD(d%,22),0		POKEW UADD(d%,24),0		POKEW UADD(d%,26),0		POKEW UADD(d%,28),0		POKEW UADD(d%,30),-1		POKEW UADD(d%,34),0		POKEW UADD(d%,36),0		POKE$ UADD(d%,38),label$		first%=PEEKW(UADD(dg%,6))		IF first%=0			POKEW UADD(d%,6),d%			POKEW UADD(dg%,6),d%		ELSE			last%=PEEKW(UADD(first%,6))			POKEW UADD(d%,6),last%			POKEW UADD(last%,4),d%			POKEW UADD(first%,6),d%		ENDIF		POKEW UADD(d%,4),0		IF (flags% AND 1)<>0			IF PEEKW(UADD(dg%,8))=0				POKEW UADD(d%,8),d%				POKEW UADD(d%,10),d%				POKEW UADD(dg%,8),d%			ELSE				WHILE (PEEKW(UADD(last%,2)) AND 1) = 0					last%=PEEKW(UADD(last%,10))				ENDWH				first%=PEEKW(UADD(last%,8))				POKEW UADD(d%,8),first%				POKEW UADD(d%,10),last%				POKEW UADD(last%,8),d%				POKEW UADD(first%,10),d%			ENDIF		ENDIF		POKEW dg%,PEEKW(dg%)+1		oldwin%=gIDENTITY		gUSE PEEKW(UADD(dg%,4))		gSTYLE 1		textpos%=gTWIdth(label$)+30		gSTYLE 0		IF textpos%>PEEKW(UADD(dg%,20))			gUSE 1			POKEW UADD(dg%,20),textpos%			POKEW UADD(dg%,22),gWIDTH-textpos%-10		ENDIF		gUSE oldwin%	ENDIF	RETURN d%ENDPPROC dispall:(dg%,top%,label%)	LOCAL lines%	POKEW UADD(dg%,18),top%	lines%=MIN(PEEKW(UADD(dg%,14)),PEEKW(UADD(dg%,16)))	gAT 9,PEEKW(UADD(dg%,24))-winfo%(5)-1	gFILL PEEKW(UADD(dg%,20))+PEEKW(UADD(dg%,22))-9,lines%*(winfo%(3)+1),1	dspdglns:(dg%,0,lines%-1)ENDPPROC selctfld:(field%,select%,hilabel%,cursor%)	LOCAL labpos%, linelen%, line%, textpos%, textlen%, flags%, win%	LOCAL selx%, sely%, cursx%, cursy%	LOCAL y%, maxline%, uline%, dg%, left%	dg%=PEEKW(UADD(field%,12))	flags%=PEEKW(UADD(field%,2))	line%=PEEKW(UADD(field%,14))-PEEKW(UADD(dg%,18))	maxline%=PEEKW(UADD(dg%,16))	uline%=PEEKW(UADD(field%,20))	IF (flags% AND 6)<>0 AND line%>=0 AND line%<maxline% AND hilabel%		gAT 9,PEEKW(UADD(dg%,24))+line%*(winfo%(3)+1)-winfo%(5)-1		labpos%=UADD(field%,38)		IF PEEKB(labpos%)>0			gSTYLE 1			gFILL gtWIDTH(PEEK$(labpos%))+1,winfo%(3)+1,2			gSTYLE 0		ENDIF	ENDIF	IF (flags% AND 6)=0		hilite:(field%,0,0,255,uline%-1)	ELSE		cursx%=PEEKW(UADD(field%,26))		cursy%=PEEKW(UADD(field%,28))		selx%=PEEKW(UADD(field%,30))		sely%=PEEKW(UADD(field%,32))		IF selx%>=0			hilite:(field%,cursx%,cursy%,selx%,sely%)		ELSEIF cursor%			cursor:(field%,cursx%,cursy%)		ENDIF		IF NOT select%			POKEW UADD(field%, 26), 0			POKEW UADD(field%, 28), 0			POKEW UADD(field%, 30), -1		ENDIF	ENDIFENDPPROC cursor:(field%,xpos%,ypos%)	LOCAL dg%,x%,y%,ptext%	dg%=PEEKW(UADD(field%,12))	ptext%=PEEKW(UADD(field%,36))	WHILE y%<ypos%		ptext%=UADD(ptext%,PEEKB(ptext%)+1)		y%=y%+1	ENDWH	x%=PEEKW(UADD(dg%,20))+gTWIDTH(LEFT$(PEEK$(ptext%),xpos%))-1	y%=PEEKW(UADD(dg%,24))+(winfo%(3)+1)*(ypos%+PEEKW(UADD(field%,14))-PEEKW(UADD(dg%,18)))	gAT x%,y%	CURSOR PEEKW(UADD(dg%,4))ENDPPROC hilite:(field%,fromx%,fromy%,tox%,toy%)	LOCAL dg%,topline%,maxline%	LOCAL y%,line%,start%,textlen%	LOCAL ptext%,fieldx%,len%,n%	LOCAL cursx%,cursy%,selx%,sely%	LOCAL minx%,miny%,maxx%,maxy%	IF fromy%>toy% OR (fromy%=toy% AND fromx%>tox%)		hilite:(field%,tox%,toy%,fromx%,fromy%)		RETURN	ENDIF	dg%=PEEKW(UADD(field%,12))	topline%=PEEKW(UADD(dg%,18))	fieldx%=PEEKW(UADD(dg%,20))	maxline%=PEEKW(UADD(dg%,16))	line%=PEEKW(UADD(field%,14))-topline%	ptext%=PEEKW(UADD(field%,36))	cursx%=PEEKW(UADD(field%,26))	cursy%=PEEKW(UADD(field%,28))	selx%=PEEKW(UADD(field%,30))	sely%=PEEKW(UADD(field%,32))	IF cursy%<sely% OR (cursy%=sely% AND cursx%<selx%)		minx%=cursx%		miny%=cursy%		maxx%=selx%		maxy%=sely%	ELSE		minx%=selx%		miny%=sely%		maxx%=cursx%		maxy%=cursy%	ENDIF	WHILE line%<maxline% AND y%<=toy%		IF line%>=0 AND y%>=fromy%			IF y%>fromy% OR fromx%=0				start%=-1			ELSEIF selx%<0 OR fromy%<miny% OR (fromy%=miny% AND fromx%<=minx%)				start%=gTWIDTH(LEFT$(PEEK$(ptext%),fromx%))-1			ELSE				start%=gTWIDTH(LEFT$(PEEK$(ptext%),fromx%))			ENDIF			IF RIGHT$(PEEK$(ptext%),1)=CHR$(21)				textlen%=PEEKB(ptext%)-1			ELSE				textlen%=PEEKB(ptext%)			ENDIF			IF y%=toy%				n%=tox%			ELSE				n%=textlen%			ENDIF			IF n%=0 OR (n%=fromx% AND y%=fromy%)				len%=0			ELSEIF selx%<0 OR toy%>maxy% OR (toy%=maxy% AND tox%>=maxx%) OR n%=textlen%				len%=gTWIDTH(LEFT$(PEEK$(ptext%),n%))-start%			ELSE				len%=gTWIDTH(LEFT$(PEEK$(ptext%),n%))-start%-1			ENDIF			gAT fieldx%+start%,PEEKW(UADD(dg%,24))+line%*(winfo%(3)+1)-winfo%(5)-1			gFILL len%,winfo%(3)+1,2		ENDIF		line%=line%+1		y%=y%+1		ptext%=UADD(ptext%,PEEKB(ptext%)+1)	ENDWH	CURSOR OFFENDPPROC endselct:(field%,tox%,toy%)	LOCAL cursx%,cursy%,selx%,sely%	cursx%=PEEKW(UADD(field%,26))	cursy%=PEEKW(UADD(field%,28))	selx%=PEEKW(UADD(field%,30))	sely%=PEEKW(UADD(field%,32))	hilite:(field%,cursx%,cursy%,selx%,sely%)	POKEW UADD(field%,30),-1	moveto:(field%,tox%,toy%,0,-1)ENDPPROC dispbutn:(button%,state%)	LOCAL key%,btwdth%,x%,y%	x%=gX :y%=gY	gUPDATE OFF	gAT PEEKW(UADD(button%,4)),PEEKW(UADD(button%,6))	btwdth%=PEEKW(UADD(button%,8))	key%=PEEKW(UADD(button%,12))	IF key%=13		gBUTTON "Enter",1,btwdth%,winfo%(3)+8,state%	ELSEIF key%=27		gBUTTON "Esc",1,btwdth%,winfo%(3)+8,state%	ELSEIF key%=9		gBUTTON "Tab",1,btwdth%,winfo%(3)+8,state%	ELSEIF key%=290		gBUTTON "Menu",1,btwdth%,winfo%(3)+8,state%	ELSEIF key%=291		gBUTTON "Help",1,btwdth%,winfo%(3)+8,state%	ELSE		gBUTTON CHR$(key%),1,btwdth%,winfo%(3)+8,state%	ENDIF	gAT x%,y%	gUPDATE ONENDPPROC newfld%:(oldfld%,dir%)	LOCAL field%,dg%,x%,y%,line%	LOCAL textpos%,textlen%,linelen%,oldx%,oldy%	LOCAL left%,xpos%,maxline%,topline%, dgline%,flags%	IF dir%>0		field%=PEEKW(UADD(oldfld%,8))	ELSEIF dir%=0		field%=oldfld%	ELSE		field%=PEEKW(UADD(oldfld%,10))	ENDIF	flags%=PEEKW(UADD(field%,2))	IF dir%<0 AND (flags% AND 2)=2		y%=MAX(PEEKW(UADD(field%,20))-1,0)	ENDIF	x%=PEEKW(UADD(oldfld%,26))	dg%=PEEKW(UADD(oldfld%,12))	dgline%=PEEKW(UADD(field%,14))+y%	topline%=PEEKW(UADD(dg%,18)) 	line%=dgline%-topline%	maxline%=PEEKW(UADD(dg%,16))	IF line%<=-maxline%		dispall:(dg%,dgline%,0)	ELSEIF line%>=maxline%*2-1		dispall:(dg%,dgline%-maxline%+1,0)	ELSE		IF dir%<>0			selctfld:(oldfld%,0,-1,0)		ENDIF		IF line%<0			scrolldn:(dg%,-line%)		ELSEIF line%>=maxline%			scrollup:(dg%,line%-maxline%+1)		ENDIF	ENDIF	IF (flags% AND 2)=0		selctfld:(field%,-1,-1,-1)	ELSE		selctfld:(field%,-1,-1,0)		moveto:(field%,x%,y%,0,-1)	ENDIF	POKEW UADD(dg%,8),field%	RETURN field%ENDPPROC dspdglns:(dg%,from%,to%)	LOCAL start%,end%,dgline%,field%,ypos%,labpos%	LOCAL uline%,ulines%,nlines%,linelen%,maxline%	LOCAL selfld%,topypos%,ptext%,xpos%,flags%	LOCAL minhix%,minhiy%,maxhix%,maxhiy%	LOCAL xsel%,lsel%,n%	start%=MAX(from%,0)	maxline%=MIN(PEEKW(UADD(dg%,14)),PEEKW(UADD(dg%,16)))	end%=MIN(to%,maxline%-1)	IF start%>end%		RETURN	ENDIF	dgline%=-PEEKW(UADD(dg%,18))	xpos%=PEEKW(UADD(dg%,20))	topypos%=PEEKW(UADD(dg%,24))	field%=PEEKW(UADD(dg%,6))	selfld%=PEEKW(UADD(dg%,8))	ulines%=PEEKW(UADD(field%,20))	WHILE dgline%+ulines%<=start%		dgline%=dgline%+ulines%		field%= PEEKW(UADD(field%,4))		ulines%=PEEKW(UADD(field%,20))	ENDWH	ptext%=PEEKW(UADD(field%,36))	flags%=PEEKW(UADD(field%,2))	minhix%=PEEKW(UADD(field%,30))	IF field%=selfld% AND minhix%>=0		minhiy%=PEEKW(UADD(field%,32))		maxhix%=PEEKW(UADD(field%,26))		maxhiy%=PEEKW(UADD(field%,28))		IF minhiy%>maxhiy% OR (minhiy%=maxhiy% AND minhix%>maxhix%)			minhix%=maxhix%			minhiy%=maxhiy%			maxhix%=PEEKW(UADD(field%,30))			maxhiy%=PEEKW(UADD(field%,32))		ENDIF	ELSE		maxhiy%=-1	ENDIF	WHILE dgline%<=end%		IF dgline%>=start%			ypos%=topypos%+dgline%*(winfo%(3)+1)			gAT 9,ypos%-winfo%(5)-1			gFILL gWIDTH-19,winfo%(3)+1,1			gAT xpos%,ypos%			IF (flags% AND 6)=4				gGREY 1			ENDIF			IF RIGHT$(PEEK$(ptext%),1)=CHR$(21)				gPRINT LEFT$(PEEK$(ptext%),PEEKB(ptext%)-1)			ELSE				gPRINT PEEK$(ptext%)			ENDIF			gGREY 2			IF uline%>=minhiy% AND uline%<=maxhiy%				IF uline%>minhiy% OR minhix%=0					xsel%=-1				ELSE					xsel%=gTWIDTH(LEFT$(PEEK$(ptext%),minhix%))-1				ENDIF				IF RIGHT$(PEEK$(ptext%),1)=CHR$(21)					linelen%=PEEKB(ptext%)-1				ELSE					linelen%=PEEKB(ptext%)				ENDIF				IF uline%<maxhiy% 					n%=linelen%				ELSE					n%=maxhix%				ENDIF				IF n%=0					lsel%=0				ELSE					lsel%=gTWIDTH(LEFT$(PEEK$(ptext%),n%))-xsel%				ENDIF				gAT xpos%+xsel%,ypos%-winfo%(5)-1				gFILL lsel%,winfo%(3)+1,2			ENDIF			IF uline%=0				labpos%=UADD(field%,38)				IF PEEKB(labpos%)>0					gSTYLE 1					gAT 10,ypos%					gPRINT PEEK$(labpos%)					IF field%=selfld% AND (flags% AND 6)<>0						gAT 9,ypos%-winfo%(5)-1						gFILL gtWIDTH(PEEK$(labpos%))+1,winfo%(3) + 1, 2					ENDIF					gSTYLE 0				ENDIF			ENDIF		ENDIF		dgline%=dgline%+1		IF dgline%>end%			BREAK		ENDIF		uline%=uline%+1		IF uline%>=ulines%			field%=PEEKW(UADD(field%,4))			uline%=0			ulines%=PEEKW(UADD(field%,20))			flags%=PEEKW(UADD(field%,2))			ptext%=PEEKW(UADD(field%,36))			minhix%=PEEKW(UADD(field%,30))			IF field%=selfld% AND minhix%>=0				minhiy%=PEEKW(UADD(field%,32))				maxhix%=PEEKW(UADD(field%,26))				maxhiy%=PEEKW(UADD(field%,28))				IF minhiy%>maxhiy% OR (minhiy%=maxhiy% AND minhix%>maxhix%)					minhix%=maxhix%					minhiy%=maxhiy%					maxhix%=PEEKW(UADD(field%,30))					maxhiy%=PEEKW(UADD(field%,32))				ENDIF			ELSE				maxhiy%=-1			ENDIF		ELSE			ptext%=UADD(ptext%,PEEKB(ptext%)+1)		ENDIF	ENDWHENDPPROC scrollup:(dg%,lines%)	LOCAL maxline%,topline%,width%,y%	LOCAL scroll%,dglines%	maxline%=PEEKW(UADD(dg%,16))	topline%=PEEKW(UADD(dg%,18))	dglines%=PEEKW(UADD(dg%,14))	scroll%=MIN(lines%,dglines%-topline%-maxline%)	IF scroll%>=maxline%		dispall:(dg%,topline%+scroll%)	ELSEIF scroll%>0		width%=PEEKW(UADD(dg%,20))+PEEKW(UADD(dg%,22))-9		y%=PEEKW(UADD(dg%,24))+scroll%*(winfo%(3)+1)-winfo%(5)-1		gSCROLL 0,-scroll%*(winfo%(3)+1),9,y%,width%,(maxline%-scroll%)*(winfo%(3)+1)		y%=PEEKW(UADD(dg%,24))+(maxline%-scroll%)*(winfo%(3)+1)-winfo%(5)-1		gAT 9,y%		gFILL width%,scroll%*(winfo%(3)+1),1		POKEW UADD(dg%,18),topline%+scroll%		dspdglns:(dg%,maxline%-scroll%,maxline%-1)	ENDIFENDPPROC scrolldn:(dg%,lines%)	LOCAL maxline%,topline%,width%,y%	LOCAL scroll%	maxline%=PEEKW(UADD(dg%,16))	topline%=PEEKW(UADD(dg%,18))	scroll%=MIN(lines%,topline%)	IF scroll%>=maxline%		dispall:(dg%,topline%-scroll%)	ELSEIF scroll%>0		width%=PEEKW(UADD(dg%,20))+PEEKW(UADD(dg%,22))-9		y%=PEEKW(UADD(dg%,24))-winfo%(5)-1		gSCROLL 0,scroll%*(winfo%(3)+1),9,y%,width%,(maxline%-scroll%)*(winfo%(3)+1)		y%=PEEKW(UADD(dg%,24))-winfo%(5)-1		gAT 9,y%		gFILL width%,scroll%*(winfo%(3)+1),1		POKEW UADD(dg%,18),topline%-scroll%		dspdglns:(dg%,0,scroll%-1)	ENDIFENDPPROC txtwdth%:(text$)	IF RIGHT$(text$,1)=CHR$(21)		RETURN gTWIDTH(LEFT$(text$,LEN(text$)-1))	ELSE		RETURN gTWIDTH(text$)	ENDIFENDPPROC splitsp%:(text$,txtwdth%)	LOCAL l%,ll%	l%=LOC(text$,CHR$(21))	IF l%>0		ll%=l%-1	ELSE		l%=LEN(text$)		ll%=l%	ENDIF	WHILE -1		IF gtWIDTH(LEFT$(text$,ll%))<=txtwdth%			RETURN l%		ENDIF		l%=ll%-1		WHILE l%>0			IF MID$(text$,l%,1)=" "				BREAK			ENDIF			l%=l%-1		ENDWH		IF l%=0			RETURN 0		ENDIF		ll%=l%	ENDWHENDPPROC splittx%:(text$,txtwdth%)	LOCAL l%	l%=1	WHILE gTWIDTH(LEFT$(text$,l%))<=txtwdth%		l%=l%+1	ENDWH	RETURN l%-1ENDPPROC wraptxt%:(field%,offset1%,offset2%,line2%,modlns%,txtwdth%,setflgs%)	LOCAL ptext%,rem%,split1%,split2%,nlines%	LOCAL str1%,str2%,l2%,p1%,p2%,i%,lastmod%	LOCAL flags%	nlines%=PEEKB(UADD(field%,20))	ptext%=PEEKW(UADD(field%,36))	str1%=offset1%	str2%=offset2%	l2%=line2%	lastmod%=line2%+modlns%-1	flags%=PEEKW(UADD(field%,2)) OR setflgs%	WHILE l2%<nlines%		p2%=UADD(ptext%,str2%)		IF PEEKB(p2%)=0			IF str2%>1				IF l2%=nlines%-1 AND PEEKB(USUB(p2%,1))=21					BREAK				ENDIF			ENDIF			IF str1%>=0				ptext%=ADJUSTALLOC(ptext%,str2%,-1)				str2%=str1%				str1%=-1				l2%=l2%-1				nlines%=nlines%-1				lastmod%=MAX(l2%,lastmod%-1)			ELSEIF nlines%=1				IF PEEKW(UADD(field%,34))=0					BREAK				ENDIF				FREEALLOC ptext%				ptext%=PEEKW(UADD(field%,34))				nlines%=PEEKW(UADD(field%,18))				lastmod%=nlines%-1				p2%=ptext%				flags%=flags% AND $D			ELSE				ADJUSTALLOC(ptext%,str2%,-1)				nlines%=nlines%-1				lastmod%=MAX(lastmod%,l2%)-1			ENDIF		ELSEIF str1%<0			split2%=splitsp%:(PEEK$(p2%),txtwdth%)			IF split2%=0				split2%=splittx%:(PEEK$(p2%),txtwdth%)			ENDIF			rem%=PEEKB(p2%)-split2%			IF rem%>0				ptext%=ADJUSTALLOC(ptext%,str2%+split2%+1,1)				IF ptext%=0					RETURN -1				ENDIF				POKEB UADD(ptext%,str2%),split2%				str2%=str2%+split2%+1				POKEB UADD(ptext%,str2%),rem%				nlines%=nlines%+1				lastmod%=lastmod%+1			ELSEIF RIGHT$(PEEK$(p2%),1)=CHR$(21)				str2%=str2%+split2%+1				IF l2%>=lastmod%					BREAK				ENDIF			ELSE				str1%=str2%				str2%=str2%+split2%+1			ENDIF			l2%=l2%+1		ELSE			p1%=UADD(ptext%,str1%)			split1%=0			IF PEEK$(p2%)="" 				ptext%=ADJUSTALLOC(ptext%,str2%,-1)				nlines%=nlines%-1				lastmod%=MAX(l2%,lastmod%)-1			ELSEIF PEEK$(p2%)=CHR$(21)				ptext%=ADJUSTALLOC(ptext%,str2%,-1)				POKEB p1%,PEEKB(p1%)+1				str2%=str2%+1				nlines%=nlines%-1				lastmod%=MAX(l2%,lastmod%)-1				IF l2%>lastmod%					BREAK				ENDIF				str1%=-1			ELSE				split2%=splitsp%:(PEEK$(p2%),txtwdth%-gTWIDTH(PEEK$(p1%)))				IF split2%=0 AND RIGHT$(PEEK$(p1%),1)<>" "					split1%=PEEKB(p1%)-1					WHILE split1%>0						IF MID$(PEEK$(p1%),split1%,1)=" "							BREAK						ENDIF						split1%=split1%-1					ENDWH					IF split1%<=0						split2%=splittx%:(PEEK$(p2%),txtwdth%-gTWIDTH(PEEK$(p1%)))					ENDIF				ENDIF				IF split1%>0					rem%=PEEKB(p1%)-split1%					ptext%=ADJUSTALLOC(ptext%,str1%+split1%+1,1)					IF ptext%=0						RETURN -1					ENDIF					POKEB UADD(ptext%,str1%),split1%					str1%=str1%+split1%+1					POKEB UADD(ptext%,str1%),rem%					nlines%=nlines%+1					lastmod%=lastmod%+1					l2%=l2%+1					str2%=str2%+1				ELSEIF split2%=0					IF l2%>lastmod%						BREAK					ENDIF					str1%=-1				ELSE					rem%=PEEKB(p2%)-split2%					ptext%=ADJUSTALLOC(ptext%,str2%,-1)					POKEB p1%,PEEKB(p1%)+split2%					IF rem%>0						ptext%=ADJUSTALLOC(ptext%,str2%+split2%,1)						str1%=-1						str2%=str2%+split2%						POKEB UADD(ptext%,str2%),rem%						lastmod%=MAX(l2%,lastmod%)					ELSE						str2%=str2%+split2%						nlines%=nlines%-1						lastmod%=MAX(l2%,lastmod%)-1						IF RIGHT$(PEEK$(p1%),1)=CHR$(21)							IF l2%>lastmod%								BREAK							ENDIF							str1%=-1						ENDIF					ENDIF				ENDIF			ENDIF		ENDIF	ENDWH	POKEW UADD(field%,20),nlines%	POKEW UADD(field%,36),ptext%	IF (flags% AND 2)=0		POKEW UADD(field%,18),nlines%		POKEW UADD(field%,34),ptext%	ENDIF	POKEW UADD(field%,2),flags%	RETURN lastmod%ENDP