PROC dialogex:	LOCAL dg%,field1%,field2%,key%	LOCAL lines%,ptext%	rem Initialise Dialog	dg%=DGinit%:("My Dialog")	rem Define fields	field1%=DGtext%:(dg%,"A field",7)	field2%=DGtext%:(dg%,"Another field",7)	rem Set initial contents	DGaddtx%:(field1%,"Some text",0)	DGaddtx%:(field2%,"Some more text",0)	DGshow%:(dg%,7)	WHILE -1		key%=KEY		rem Movement Key		IF key%>=256 AND key%<=263			DGmove%:(dg%,key%,KMOD)		rem Delete		ELSEIF key%=8 OR key%=127			DGdelet%:(dg%,KMOD,0)		ELSEIF key%=27			BREAK		ELSEIF key%=13			IF KMOD AND 2				rem Line Break				DGinsrt%:(dg%,CHR$(21))			ELSE				rem Display contents				PRINT "FIELD 1:"				lines%=DGflns%:(field1%)				ptext%=DGfstln%:(field1%)				WHILE lines%					PRINT PEEK$(ptext%)					ptext%=DGnxtln%:(field1%)					lines%=lines%-1				ENDWH				PRINT "FIELD 12:"				lines%=DGflns%:(field2%)				ptext%=DGfstln%:(field2%)				WHILE lines%					PRINT PEEK$(ptext%)					ptext%=DGnxtln%:(field2%)					lines%=lines%-1				ENDWH				BREAK			ENDIF		rem Insert Characters		ELSEIF key%>=32 AND key%<127			DGinsrt%:(dg%,CHR$(key%))		ENDIF	ENDWH	DGclear%:(dg%)	GETENDP