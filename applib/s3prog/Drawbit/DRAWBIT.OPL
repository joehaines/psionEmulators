PROC test:
  local i%(32),j%(6),fn$(130),c%,h%
  local x%,y%    rem keep together
  local tlx%,tly%,w%,h2%    rem keep together
  local gc%(3)
  defaultwin 1
  ginfo i%(1)
  print i%(31)
  fn$=parse$("\opo\test\test.pic",cmd$(1),j%(1))
  h%=call($e78d,addr(fn$)+1,0,0,addr(c%))
  call($ea8d,h%,0,0,addr(w%))
  print h%,c%
  print w%,h2%
  tlx%=0
  tly%=0
  call($228d,i%(31),0)
  x%=20 :y%=30
  call($e98d,addr(x%),h%,addr(tlx%),0,0)
  gc%(2)=$100
  call($248d,0,$20,addr(gc%(1)))
  call($e98d,addr(x%),h%,addr(tlx%),1,0)
  call($038d)
  get
ENDP
