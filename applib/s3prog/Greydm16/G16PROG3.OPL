REM This program bounces a box around
REM the screen as it goes through 16
REM levels of grey (with dithering)

PROC g16prog3:
	GLOBAL id%(8)
	local x%,y%,w%,h%,g%,dx%,dy%,d%


	init:
	id%(6)=gCREATE(0,0,480,4,0,1)
	gupdate off

	id%(3)=gCREATE(0,0,480,160,1,1)

	x%=0
	d%=1
	y%=0
	dx%=5
	dy%=5
	w%=(1+4*rnd)*16
	h%=(5+rnd*64)

	do
		gUSE id%(6)
		ggrey 2
		gCOPY id%(1),0,g%*4,480,4,3
		gUSE id%(3)
		ggrey 2
		gAT x%,y%
		gPATT id%(6),w%,h%,3
		gBOX w%,h%
		gUPDATE

		g%=g%+d%
		dy%=dy%+1

		y%=y%+dy%
		IF y%>160-h%
			y%=160-h%
			dy%=-0.99*dy%
			IF ABS(dy%)<2
				dy%=dy%*20
			ENDIF
		ELSEIF y%<0
			dy%=-dy%
			y%=0
		ENDIF

		x%=x%+dx%
		IF x%>480-w%
			dx%=-0.9*dx%
			x%=480-w%
			IF ABS(dx%)<2
				dx%=dx%*20
			ENDIF
		ELSEIF x%<0
			dx%=-0.9*dx%
			x%=0
			IF ABS(dx%)<2
				dx%=dx%*20
			ENDIF
		ENDIF

		IF KEY
			STOP
		ENDIF

		IF g%=16
			d%=-1
		ELSEIF g%=0
			d%=1
		ENDIF



	UNTIL 0

ENDP

PROC init:
	LOCAL yf%,cnt%

	id%(6)=gLOADBIT("\pic\grey.pic")
	id%(1)=gCREATE(0,0,480,68,0,1)

	gGREY 1
	gAT 0,0
	gFILL 480,36,0
	gGREY 0

	gPATT id%(6),480,32,3
	gGREY 1
	gAT 0,32
	gPATT id%(6),480,32,3

ENDP

