@echo offif (%1)==() goto xhelpif not exist %1\APP\NAGMAKER md %1\APP\NAGMAKERif not exist %1\NAGTEMP md %1\NAGTEMPecho copying the NagMaker application to %1\appcopy APP\NAGMAKER.OPA %1\app\NAGMAKER.OPAcopy NAGTEMP\psinag.opo %1\NAGTEMP\psinag.opoecho NAGMAKER installation completeecho Choose Install from the System Screengoto end:xhelpecho.echo Change directory to the NAGMAKER install directory. i.e.echo CD C:\NAGMAKERecho .echo Then typeecho NAGINST drive:echo.echo         drive: should be the drive letter on theecho                remote computer. e.g. NAGINST I:echo.:end