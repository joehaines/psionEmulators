As an adjunct to my earlier follow-up regarding DIR$, EXIST and directories,
below is a (short) program which displays the entire contents of a disk,
file by file, directory by directory. I'd wondered how to do this (given that
the output of DIR$ strips the final "\" from directory names) until I saw the
aforementioned discussion. Feel free to use/abuse this progette - it's only
a rudimentary thing anyway.

Note:
The parameter lev% was originally included to produce an indented output -
it's not really worth using for a screen as small as the Psion, but would be
handy if directed to a printer :)

Note 2:
Press ENTER after each line is displayed.

Mark

PROC dtree:
  tree:("B:\",0)
ENDP

PROC tree:(filspec$,lev%)
  LOCAL fspec$(50,128),i%,d$(128),j%

  PRINT filspec$
  GET

  d$=DIR$(filspec$)
  IF d$=""
    PRINT "Empty directory"
    GET
    GOTO finish
  ENDIF

  i%=0
  WHILE d$<>""
    IF NOT EXIST(d$)
      i%=i%+1
      fspec$(i%)=d$+"\"
    ELSE
      PRINT d$
      GET
    ENDIF
    d$=DIR$("")
  ENDWH

  IF i%>0
    j%=1
    DO
      tree:(fspec$(j%),lev%+1)
      j%=j%+1
    UNTIL j%>i%
  ENDIF

  finish::
ENDP



