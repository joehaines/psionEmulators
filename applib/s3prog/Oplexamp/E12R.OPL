
PROC RE12calc:
LOCAL counter,mult,E(12)
E(1)=1.2 :E(2)=1.5 :E(3)=1.8 :E(4)=2.2
E(5)=2.7 :E(6)=3.3 :E(7)=3.9 :E(8)=4.7
E(9)=5.6 :E(10)=6.8 :E(11)=8.2 :E(12)=10

counter=1
mult=10**(INT(LOG(Res)/LOG(10)))
low=mult
Loop::
hi=mult*E(counter)
       IF hi>Res
         GOTO Done
       ENDIF
counter=counter+1
low=hi
GOTO Loop
Done::
ENDP  
