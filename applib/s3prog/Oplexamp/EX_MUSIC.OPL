PROC scale:
LOCAL freq,n%
print "scale from middle C"
print "press a key" :get :cls
REM n% relative to middle A
n%=3 REM start at middle C
WHILE n%<16
	freq=440*2**(n%/12.0)
	REM middle A = freq 440Hz
	BEEP 8,512000/freq-1.0
	n%=n%+1
	IF n%=4 OR n%=6 OR n%=9 OR n%=11 OR n%=13
		n%=n%+1
	ENDIF
ENDWH
ENDP
