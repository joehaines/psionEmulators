X-News-Software: Ameol

The following OPL program will run Word for you. Pass the *full*
filename to be loaded (ie: loc::m:\wrd\test.asc):

PROC runword:(file$)
  local a%,c$(128),f$(128)
  local ax%,bx%,cx%,dx%,si%,di% : rem keep together

  f$="rom::word.app"+chr$(0)    : rem application to start
  
  c$="O"                        : rem O=open file, C=create file
  c$=c$+"TextView"+chr$(0)      : rem app name shown in status win
  c$=c$+".asc "                 : rem default extension
  c$=c$+"$"+chr$(0)             : rem WORD type ($=text, O=OPL, S=Script)
  c$=c$+file$+chr$(0)
  
  ax%=$0100
  bx%=uadd(addr(f$),1)
  cx%=addr(c$)
  dx%=0
  di=addr(a%)
  
  os($87,addr(ax%))
  call($0688,a%)                : rem start word process
ENDP

Cheers

