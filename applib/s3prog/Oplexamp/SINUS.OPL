Rem This Software is Public !

PROC MAIN:
LOCAL a%(63),b%(30),c%(30)

Rem Build the Look-Up Table

b%(1)=0 : b%(2)=1
b%(3)=2 : b%(4)=3
b%(5)=4 : b%(6)=5
b%(7)=6 : b%(8)=7
b%(9)=6 : b%(10)=5
b%(11)=4 : b%(12)=3
b%(13)=2 : b%(14)=1
b%(15)=0 : b%(16)=0
b%(17)=-1 : b%(18)=-2
b%(19)=-3 : b%(20)=-4
b%(21)=-5 : b%(22)=-6
b%(23)=-7 : b%(24)=-6
b%(25)=-5 : b%(26)=-4
b%(27)=-3 : b%(28)=-2
b%(29)=-1 : b%(30)=0
rem
DO
a%(1)=0 : a%(2)=40
a%(3)=30

a%(4)=8*2 : a%(5)=b%(1)
a%(6)=8*2 : a%(7)=b%(2)
a%(8)=8*2 : a%(9)=b%(3)
a%(10)=8*2 : a%(11)=b%(4)
a%(12)=8*2 : a%(13)=b%(5)
a%(14)=8*2 : a%(15)=b%(6)
a%(16)=8*2 : a%(17)=b%(7)
rem *
a%(18)=8*2 : a%(19)=b%(8)
a%(20)=8*2 : a%(21)=b%(9)
a%(22)=8*2 : a%(23)=b%(10)
a%(24)=8*2 : a%(25)=b%(11)
a%(26)=8*2 : a%(27)=b%(12)
a%(28)=8*2 : a%(29)=b%(13)
a%(30)=8*2 : a%(31)=b%(14)
a%(32)=8*2 : a%(33)=b%(15)
rem *
a%(34)=8*2 : a%(35)=b%(16)
a%(36)=8*2 : a%(37)=b%(17)
a%(38)=8*2 : a%(39)=b%(18)
a%(40)=8*2 : a%(41)=b%(19)
a%(42)=8*2 : a%(43)=b%(20)
a%(44)=8*2 : a%(45)=b%(21)
a%(46)=8*2 : a%(47)=b%(22)
a%(48)=8*2 : a%(49)=b%(23)
rem *
a%(50)=8*2 : a%(51)=b%(24)
a%(52)=8*2 : a%(53)=b%(25)
a%(54)=8*2 : a%(55)=b%(26)
a%(56)=8*2 : a%(57)=b%(27)
a%(58)=8*2 : a%(59)=b%(28)
a%(60)=8*2 : a%(61)=b%(29)
a%(62)=8*2 : a%(63)=b%(30)

Rem Rotate b%() to Right

	call ($a1,0,58,0,addr(b%(1)),addr(c%(2)))
	call ($a1,0,02,0,addr(b%(30)),addr(c%(1)))
	call ($a1,0,60,0,addr(c%(1)),addr(b%(1)))
 	
Rem Rotate b%() to Left

rem call ($a1,0,58,0,addr(b%(2)),addr(c%(1)))
rem call ($a1,0,02,0,addr(b%(1)),addr(c%(30)))
rem call ($a1,0,60,0,addr(c%(1)),addr(b%(1)))
gUpdate off
	gcls
	gPoly a%()
	gUpdate on
until key
ENDP
