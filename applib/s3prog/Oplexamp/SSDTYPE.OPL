----------

proc main:
    local s$(128)

    print "Device:";
    input s$
    print "Device is:";DevType$:(s$)
    get
endp

PROC DevType$:(s$)
    LOCAL ax%,bx%,cx%,dx%,si%,di%
    LOCAL flags%,err%,ret$(30)
    LOCAL slot$(8),pslot%
    LOCAL buff%(32),pbuff%

    slot$  = s$ + CHR$(0)
    pslot% = ADDR(slot$) + 1
    pbuff% = ADDR(buff%())
    ax% = $0a00
    bx% = pslot%
    cx% = pbuff%

    flags% = OS($0087,ADDR(ax%))

    IF flags% AND 1
        err% = ax% OR $ff00
        ret$ = ERR$(err%)
    ELSE
        IF (buff%(2) AND $07) = 3
            ret$ = "Flash"
        ELSEIF (buff%(2) AND $07) = 4
            ret$ = "RAM"
        ELSEIF (buff%(2) AND $07) = 5
            ret$ = "ROM"
        ELSE
            ret$ = "Unknown"
        ENDIF
    ENDIF

    RETURN ret$
ENDP


Jeremy W (Jezar)  

