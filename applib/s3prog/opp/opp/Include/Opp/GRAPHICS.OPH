#ifndef GRAPHICS_OPH
#define GRAPHICS_OPH

/* giprint flags */

#define G_TOP_LEFT	0
#define G_BOT_LEFT	1
#define G_TOP_RIGHT	2
#define G_BOT_RIGHT	3

/* cursor types used with cursor command */

#define W_CURSOR_OBLOID		1
#define W_CURSOR_NO_FLASH	2
#define W_CURSOR_GREY		4

/* gborder flags */

#define GB_ONE_PIX_SHADOW	1
#define GB_ONE_PIX_SGAP		2
#define GB_TWO_PIX_SHADOW	3
#define GB_TWO_PIX_SGAP		4
#define GB_ONE_PIX_GAP		$100
#define GB_ROUNDED		$200

/* gbutton flags */

#define GBUT_S3		0
#define GBUT_S3A	1

#define GBUT_RAISED	0
#define GBUT_FLAT	1
#define GBUT_SUNKEN	2

/* gclock flags */

#define GCLOCK_SYSTEM	6
#define GCLOCK_ANALOG	7
#define GCLOCK_DIGITAL	8
#define GCLOCK_LARGE	9
#define GCLOCK_FDIGITAL	10

#define GCLOCK_DATE	$10
#define GCLOCK_SECONDS	$20
#define GCLOCK_AMPM	$40
#define GCLOCK_GREY	$80

/* Graphics mode flag */

#define G_SET		0
#define G_CLEAR		1
#define G_INVERT	2
#define G_REPLACE	3

/* Bit-plane flags */

#define G_BLACK_PLANE	0
#define G_GREY_PLANE	1
#define G_BOTH_PLANES	2

/* Gdrawobject flags */

#define GDRAW_LOZENGE		0
#define GDRAW_LMOREROUNDED	1
#define GDRAW_LROUNDED		2

/* gstyle flags */

#define G_STY_NORMAL		0
#define G_STY_BOLD		$01
#define G_STY_UNDERLINE		$02
#define G_STY_INVERSE		$04
#define G_STY_DOUBLE		$08
#define G_STY_MONO		$10
#define G_STY_ITALIC		$20
#define G_STY_SUBSCRIPT2	$40
#define G_STY_SUPERSCRIPT2	$80
#define G_STY_SUBSCRIPT		$100
#define G_STY_SUPERSCRIPT	$200

/* gxprint flags */

#define GX_NORMAL		0
#define GX_INV			1
#define GX_INV_NCORNERS		2
#define GX_THIN_INV		3
#define GX_THIN_INV_NCORNERS	4
#define GX_UNDERLINE		5
#define GX_THIN_UNDERLINE	6

/* Screeninfo defines */

#define SI_LEFT_MARGIN	1
#define SI_TOP_MARGIN	2
#define SI_TEXT_WIDTH	3
#define SI_TEXT_HEIGHT	4
#define SI_WSERVID	5
#define SI_FONTID	6
#define SI_CHAR_WIDTH	7
#define SI_CHAR_HEIGHT	8

/* Statuswin & statuswininfo command flags */

#define W_STATUS_WINDOW_SMALL	1
#define W_STATUS_WINDOW_BIG	2
#define W_STATUS_WINDOW_CTBY	3

#endif
