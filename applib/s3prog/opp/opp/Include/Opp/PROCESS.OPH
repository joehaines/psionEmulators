#ifndef PROCESS_OPH
#define PROCESS_OPH

/*
 * The following structure is for access to a
 * processes low-memory addresses
 */

STRUCT low_mem
	DatDead%
	DatKern1#(4)
	DatFoldTable%
	DatOOPS#(8)
	DatKern2%
	DatP18%
	DatAppMan%
	DatWServ#(4)
	DatOPL#(4)
	DatDBG1%
	DatAddrTrap#
	DatHeapMod#
	DatProcessNamePtr%
	DatCommandPtr%
	DatDBG2%
	DatUser#(14)
	DatDialogPtr%
	DatDatGate%
	DatLocked%
	DatStatusNamePtr%
	DatUsedPathNamePtr%
	DatStackLimit%
ENDS

/*
 * The following are equivalent #defines for
 * backwards compatibility with OPP 1.0 and 1.1
 */

#define DatDead			0
#define DatKern1		2
#define DatFoldTable		6
#define DatOOPS			8
#define DatKern2		16
#define DatP18			18
#define DatAppMan		20
#define DatWServ		22
#define DatOPL			26
#define DatDBG1			30
#define DatAddrTrap		32
#define DatHeapMod		33
#define DatProcessNamePtr	34
#define DatCommandPtr		36
#define DatDBG2			38
#define DatUser			40
#define DatDialogPtr		54
#define DatDatGate		56
#define DatLocked		58
#define DatStatusNamePtr	60
#define DatUsedPathNamePtr	62
#define DatStackLimit		64

#endif
