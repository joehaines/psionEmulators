#ifndef OS_GEN_OPH
#define OS_GEN_OPH

#define GenDataSegment		$8F
#define GenIntByNumber		$D5

#define GenManager		$8B

#define GenCrc			$2900
#define GenDeferredMode		$0800
#define GenEnvBufferDelete	$2300
#define GenEnvBufferFind	$2400
#define GenEnvBufferGet		$2100
#define GenEnvBufferSet		$2200
#define GenEnvStringDelete	$2700
#define GenEnvStringFind	$2800
#define GenEnvStringGet		$2500
#define GenEnvStringSet		$2600
#define GenGetAmPmText		$1D00
#define GenGetAutoSwitchOffValue	$1700
#define GenGetBatteryType	$1F00
#define GenGetCommandLine	$0E00
#define GenGetCountryData	$0500
#define GenGetErrorText		$0600
#define GenGetLanguageCode	$1B00
#define GenGetNotifyState	$1500
#define GenGetOsData		$0700
#define GenGetRamSizeInParas	$0D00
#define GenGetSoundFlags	$0F00
#define GenGetSuffixes		$1C00
#define GenGetText		$1400
#define GenLcdType		$0100
#define GenMarkActive		$1200
#define GenMarkNonActive	$1300
#define GenMaskDecrypt		$3600
#define GenMaskEncrypt		$3500
#define GenMaskInit		$3400
#define GenNotify		$0900
#define GenNotifyError		$0A00
#define GenNotifyHook		$0B00
#define GenNotifyUnHook		$0C00
#define GenParse		$0300
#define GenResetRevector	$1A00
#define GenRomVersion		$2A00
#define GenSetAutoSwitchOffValue	$1800
#define GenSetBatteryType	$2000
#define GenSetCountryData	$1E00
#define GenSetNotifyState	$1600
#define GenSetOnEvents		$3700
#define GenSetRevector		$1900
#define GenSetSoundFlags	$1000
#define GenSound		$1100
#define GenStartReason		$0200
#define GenVersion		$0000

/* structure filled in by GenGetCountryData */

STRUCT country_data
	country_code%
	gmt_offset%
	date_format#
	time_format#
	cur_pos#
	cur_space#
	cur_dec_places#
	cur_neg_fmt#
	cur_sep_th#
	cur_th_sep#
	cur_dec_sep#
	date_sep#
	time_sep#
	cur_symbol#(9)
	week_start#
	summer_times#
	clock_type#
	day_abbrev_len#
	mon_abbrev_len#
	workdays#
	units#
	spare#(9)
ENDS

