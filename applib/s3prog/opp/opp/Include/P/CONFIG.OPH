STRUCT E_CONFIG
	countryCode%
	gmtOffset%
	dateType#
	timeType#
	currencySymbolPosition#
	currencySpaceRequired#
	currencyDecimalPlaces#
	currencyNegativeInBrackets#
	currencyTriadsAllowed#
	thousandsSeparator#
	decimalSeparator#
	dateSeparator#
