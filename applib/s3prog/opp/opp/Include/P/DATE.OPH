#define P_DATE_OPH

#define P_NSECDAY 86400l /* number of seconds in a day */

/* Convert day since 1900 to day in week, Monday=0 */

#define P_WEEK(d) ((d)-(d)/7*7) /* JAN 1 1900 was a Monday */

STRUCT P_DAYSEC
	day&
	sec&
ENDS

STRUCT P_DATE
	year#
	month#
	day#
	hour#
	minute#
	second#
	yrday%
ENDS


