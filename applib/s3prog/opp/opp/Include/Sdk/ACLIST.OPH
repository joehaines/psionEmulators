#define ACLIST_OPH

#ifndef LODGER_OPH
#include <sdk\lodger>
#endif

#ifndef VARES_OPH
#include <sdk\vares>
#endif

/* Constants for smaclist */

#define SMACLIST_MAX_STRING 80

/* Types for smaclist */

STRUCT BUT_POS
	width%
	x%
ENDS

STRUCT IN_ACLIST
	rid%
ENDS

/* Property of smaclist */

STRUCT PRS_SMACLIST
	data%
	pos%
	totalwidth%
	num%
	lwidth%
ENDS

STRUCT PR_SMACLIST
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	smaclist#(SIZEOF(PRS_SMACLIST))
ENDS

/* Types for aclist */

STRUCT PUSH_BUT
	keycode%
	str#(1)
ENDS

/* Property of aclist */

STRUCT PRS_ACLIST
	text%
	width%
	y1%
	y2%
ENDS

STRUCT PR_ACLIST
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	smaclist#(SIZEOF(PRS_SMACLIST))
	aclist#(SIZEOF(PRS_ACLIST))
ENDS
