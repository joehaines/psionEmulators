#define ATSSV_OPH

#ifndef IPC_OPH
#include <sdk\ipc>
#endif

#ifndef TIMER_OPH
#include <sdk\timer>
#endif

#ifndef ATS_OPH
#include <sdk\ats>
#endif

/* Property of atssv */

STRUCT PRS_ATSSV
	timer%
	pm%
	freed%
	pm_key%
ENDS

STRUCT PR_ATSSV
	root#(SIZEOF(PRS_ROOT))
	server#(SIZEOF(PRS_SERVER))
	atssv#(SIZEOF(PRS_ATSSV))
ENDS

/* Property of atstim */

STRUCT PRS_ATSTIM
	owner%
ENDS

STRUCT PR_ATSTIM
	root#(SIZEOF(PRS_ROOT))
	active#(SIZEOF(PRS_ACTIVE))
	atstim#(SIZEOF(PRS_ATSTIM))
ENDS
