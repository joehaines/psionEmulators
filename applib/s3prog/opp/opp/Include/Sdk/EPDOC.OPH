#define EPDOC_OPH

#ifndef EDIT_OPH
#include <sdk\edit>
#endif

/* Property of epfdoc */

STRUCT PR_EPFDOC
	root#(SIZEOF(PRS_ROOT))
	eproot#(SIZEOF(PRS_EPROOT))
	epflat#(SIZEOF(PRS_EPFLAT))
ENDS

/* Property of epdoc */

STRUCT PRS_EPDOC
	b%
	pages%
	filter%
ENDS

STRUCT PR_EPDOC
	root#(SIZEOF(PRS_ROOT))
	eproot#(SIZEOF(PRS_EPROOT))
	epdoc#(SIZEOF(PRS_EPDOC))
ENDS
