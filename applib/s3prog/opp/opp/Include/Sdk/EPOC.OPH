	codeParagraphs%
	initialIp%
	stackParagraphs%
	dataParagraphs%
	heapParagraphs%
	commandLine%
	checkSum%
	minHeap%
	priority#
	ramOrRom#
	name#(E_MAX_NAME)
ENDS

#define E_PROC_FREE 0xff
