	y%
ENDS

STRUCT P_RECT
	tl#(SIZEOF(P_POINT))
	br#(SIZEOF(P_POINT))
ENDS

STRUCT P_RECTP
	r#(SIZEOF(P_RECT))
	p#(SIZEOF(P_POINT))
ENDS

STRUCT P_EXTENT
	tl#(SIZEOF(P_POINT))
	width%
	height%
ENDS

