#define P_FAEXEC 0x200
#define P_FASTREAM 0x400
#define P_FATEXT 0x800

STRUCT P_INFO
	version%
	status%
	size&
	modst&
	spare#(4)
ENDS

#define P_VOLUMENAME    32
#define P_FMEDIA_UNKNOWN 0
#define P_FMEDIA_FLOPPY 1
#define P_FMEDIA_HARDDISK 2
#define P_FMEDIA_FLASH 3
