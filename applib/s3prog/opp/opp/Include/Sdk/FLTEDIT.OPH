#define FLTEDIT_OPH

#ifndef EDWIN_OPH
#include <sdk\edwin>
#endif

/* Constants for fltedit */

#define FLTEDIT_MAX_CHAR 20
#define SE_FLTEDIT_CURRENT 0x01
#define SE_FLTEDIT_HIGH 0x02
#define SE_FLTEDIT_LOW 0x04

/* Types for fltedit */

STRUCT IN_FLTEDIT
	current 
	low 
	high 
	vulen#
	format#
ENDS

STRUCT SE_FLTEDIT
	current 
	low 
	high 
	set_flags%
ENDS

/* Property of fltedit */

STRUCT PRS_FLTEDIT
	current 
	low 
	high 
	point#
	format#
ENDS

STRUCT PR_FLTEDIT
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	edwin#(SIZEOF(PRS_EDWIN))
	fltedit#(SIZEOF(PRS_FLTEDIT))
ENDS
