#define GAUGE_OPH

#ifndef LODGER_OPH
#include <sdk\lodger>
#endif

/* Constants for gauge */

#define GAUGE_WHITE 1
#define GAUGE_GREY 2
#define GAUGE_BLACK 3

/* Types for gauge */

STRUCT SE_GAUGE
	size%(4)
	colour#(4)
ENDS

/* Property of gauge */

STRUCT PRS_GAUGE
	size%(4)
	colour#(4)
ENDS

STRUCT PR_GAUGE
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	gauge#(SIZEOF(PRS_GAUGE))
ENDS
