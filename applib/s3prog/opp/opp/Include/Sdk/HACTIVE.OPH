#define HACTIVE_OPH

#ifndef APPMAN_OPH
#include <sdk\appman>
#endif

/* Constants for shutter */

#define SHUTTER_BUFFER_LEN 128
#define SHUTTER_COUNT_MAX 32

/* Property of shutter */

STRUCT PRS_SHUTTER
	count%
	buf#(128)
ENDS

STRUCT PR_SHUTTER
	root#(SIZEOF(PRS_ROOT))
	active#(SIZEOF(PRS_ACTIVE))
	shutter#(SIZEOF(PRS_SHUTTER))
ENDS

/* Property of waotstat */

STRUCT PRS_WAOTSTAT
	count%
ENDS

STRUCT PR_WAOTSTAT
	root#(SIZEOF(PRS_ROOT))
	active#(SIZEOF(PRS_ACTIVE))
	waotstat#(SIZEOF(PRS_WAOTSTAT))
ENDS

/* Property of haidle */

STRUCT PRS_HAIDLE
	rbuf%
ENDS

STRUCT PR_HAIDLE
	root#(SIZEOF(PRS_ROOT))
	active#(SIZEOF(PRS_ACTIVE))
	haidle#(SIZEOF(PRS_HAIDLE))
ENDS

/* Property of dialao */

STRUCT PR_DIALAO
	root#(SIZEOF(PRS_ROOT))
	active#(SIZEOF(PRS_ACTIVE))
	haidle#(SIZEOF(PRS_HAIDLE))
ENDS
