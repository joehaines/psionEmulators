#define LODGER_OPH

#ifndef WIN_OPH
#include <sdk\win>
#endif

/* Constants for lodger */

#define LG_CHECK_OK	1
#define LG_CHECK_FAILED	0
#define LG_CHECK_FAILED_CHANGED	(-1)
#define LG_CHECK_OK_CHANGED	(-2)

/* Property of lodger */

STRUCT PRS_LODGER
	offset#(SIZEOF(P_POINT))
	width%
	landlord%
ENDS

STRUCT PR_LODGER
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
ENDS
