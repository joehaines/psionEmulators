#define LPRINTER_OPH

#ifndef SCRLAY_OPH
#include <sdk\scrlay>
#endif

#ifndef PRDRV_OPH
#include <sdk\prdrv>
#endif

/* Property of lprinter */

STRUCT PRS_LPRINTER
	pages%
	wdr%
	f#(SIZEOF(SCRLAY_FONT))
	defer#(SIZEOF(WDR_PRINT))
	wtab%
	lheight%
	width%
	subsqind%
ENDS

STRUCT PR_LPRINTER
	root#(SIZEOF(PRS_ROOT))
	lprinter#(SIZEOF(PRS_LPRINTER))
ENDS
