#define MATCHER_OPH

#ifndef VARRAY_OPH
#include <sdk\varray>
#endif

/* Constants for matcher */

#define IM_NEW_LEN 1
#define IM_NEW_DISPLAY 2
#define IM_NO_CHANGE 3

/* Property of matcher */

STRUCT PRS_MATCHER
	ptyped%
	plen%
ENDS

STRUCT PR_MATCHER
	root#(SIZEOF(PRS_ROOT))
	matcher#(SIZEOF(PRS_MATCHER))
ENDS

/* Property of vmatcher */

STRUCT PRS_VMATCHER
	va%
	index%
	first%
	last%
	txtoff%
ENDS

STRUCT PR_VMATCHER
	root#(SIZEOF(PRS_ROOT))
	matcher#(SIZEOF(PRS_MATCHER))
	vmatcher#(SIZEOF(PRS_VMATCHER))
ENDS
