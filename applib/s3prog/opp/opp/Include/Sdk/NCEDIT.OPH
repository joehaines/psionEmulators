#define NCEDIT_OPH

#ifndef LODGER_OPH
#include <sdk\lodger>
#endif

#ifndef MFNE_OPH
#include <sdk\mfne>
#endif

/* Constants for lncedit */

#define SE_LNCEDIT_VALUE	0x01
#define SE_LNCEDIT_LOW	0x02
#define SE_LNCEDIT_HIGH	0x04

/* Types for lncedit */

STRUCT IN_LNCEDIT
	value&
	low&
	high&
ENDS

STRUCT SE_LNCEDIT
	value&
	low&
	high&
	flags%
ENDS

/* Property of lncedit */

STRUCT PR_LNCEDIT
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	mfne#(SIZEOF(PRS_MFNE))
ENDS

