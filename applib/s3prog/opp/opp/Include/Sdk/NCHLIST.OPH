#define NCHLIST_OPH

#ifndef CHLIST_OPH
#include <sdk\chlist>
#endif

/* Property of vanumber */

STRUCT PRS_VANUMBER
	data#(8)
ENDS

STRUCT PR_VANUMBER
	root#(SIZEOF(PRS_ROOT))
	varoot#(SIZEOF(PRS_VAROOT))
	vanumber#(SIZEOF(PRS_VANUMBER))
ENDS

/* Property of nchlist */

STRUCT PR_NCHLIST
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	chlist#(SIZEOF(PRS_CHLIST))
ENDS
