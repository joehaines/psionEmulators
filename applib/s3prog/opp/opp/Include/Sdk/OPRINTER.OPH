/* Types for oprinter */

STRUCT OPRINT_REC
	style%
	blen%
	buf%
ENDS

/* Property of oprinter */

STRUCT PRS_OPRINTER
	nrecs%
	first%
	index%
	current%
	comman_changed%
	old_comman%
ENDS

STRUCT PR_OPRINTER
	root#(SIZEOF(PRS_ROOT))
	lprinter#(SIZEOF(PRS_LPRINTER))
	xprinter#(SIZEOF(PRS_XPRINTER))
	oprinter#(SIZEOF(PRS_OPRINTER))
ENDS

