/* Property of setportdlg */

STRUCT PR_SETPORTDLG
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	dlgchain#(SIZEOF(PRS_DLGCHAIN))
	dlgbox#(SIZEOF(PRS_DLGBOX))
ENDS

/* Property of sethshkdlg */

STRUCT PR_SETHSHKDLG
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	dlgchain#(SIZEOF(PRS_DLGCHAIN))
	dlgbox#(SIZEOF(PRS_DLGBOX))
