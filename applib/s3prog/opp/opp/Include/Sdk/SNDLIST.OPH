#define SNDLIST_OPH

#ifndef FACTIVE_OPH
#include <sdk\factive>
#endif

#ifndef CHLIST_OPH
#include <sdk\chlist>
#endif

#ifndef HACTIVE_OPH
#include <sdk\hactive>
#endif

/* Constants for sndlist */

#define SNDLIST_TWOTONE_SOUNDS 2

/* Property of sndlist */

STRUCT PRS_SNDLIST
	rom_count%
	rom_name_fmt#(12)
ENDS

STRUCT PR_SNDLIST
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	chlist#(SIZEOF(PRS_CHLIST))
	sndlist#(SIZEOF(PRS_SNDLIST))
ENDS

/* Property of sndlocs */

STRUCT PRS_SNDLOCS
	data%
ENDS

STRUCT PR_SNDLOCS
	root#(SIZEOF(PRS_ROOT))
	locs#(SIZEOF(PRS_LOCS))
	sndlocs#(SIZEOF(PRS_SNDLOCS))
ENDS

/* Property of fsoundao */

STRUCT PRS_FSOUNDAO
	snd%
ENDS

STRUCT PR_FSOUNDAO
	root#(SIZEOF(PRS_ROOT))
	active#(SIZEOF(PRS_ACTIVE))
	haidle#(SIZEOF(PRS_HAIDLE))
	fsoundao#(SIZEOF(PRS_FSOUNDAO))
ENDS
