#define XDLGBOX_OPH

#ifndef DLGBOX_OPH
#include <sdk\dlgbox>
#endif

/* Property of atsdial */

STRUCT PRS_ATSDIAL
	owner%
	main%
	buts%
	filter%
	filmethod%
	chlist%
	pid%
	ret%
	locked%
ENDS

STRUCT PR_ATSDIAL
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	dlgchain#(SIZEOF(PRS_DLGCHAIN))
	dlgbox#(SIZEOF(PRS_DLGBOX))
	atsdial#(SIZEOF(PRS_ATSDIAL))
ENDS
