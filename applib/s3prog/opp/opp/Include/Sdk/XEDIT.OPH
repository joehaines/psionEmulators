#define XEDIT_OPH

#ifndef LODGER_OPH
#include <sdk\lodger>
#endif

/* Constants for xedit */

#define XEDIT_MAX_LEN 8

/* Types for xedit */

STRUCT SE_XEDIT
	pstr%
ENDS

/* Property of xedit */

STRUCT PRS_XEDIT
	current#
	width#
	data#(XEDIT_MAX_LEN+2)
ENDS

STRUCT PR_XEDIT
	root#(SIZEOF(PRS_ROOT))
	win#(SIZEOF(PRS_WIN))
	lodger#(SIZEOF(PRS_LODGER))
	xedit#(SIZEOF(PRS_XEDIT))
ENDS
