ans$(20)="alb"
ans$(21)="happiest"
ans$(22)="fearing"
ans$(23)="limbo"
ans$(24)="spell"
ans$(25)="gear"

 loc$(1)="0102A0612"
 loc$(2)="0104A0807"
 loc$(3)="0904A0905"
 loc$(4)="0106A1004"
 loc$(5)="0806A1206"
 loc$(6)="0507A1405"
 loc$(7)="0108A1506"
 loc$(8)="1008A1604"
 loc$(9)="0110A1905"
loc$(10)="0710A2107"
loc$(11)="0212A2212"
loc$(12)="0301D010404"
loc$(13)="0501D0205"
