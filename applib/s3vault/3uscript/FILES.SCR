! $Header: e:\proj\3uscript/rcs\files.scc 2.0 1996/02/16 19:36:08 Mark_Hadfield Exp $

! $Log: files.scc $
! Revision 2.0  1996/02/16  19:36:08  Mark_Hadfield
! 3USCRIPT release 2.0
!
! Revision 1.2  1996/02/04  19:25:56  Mark_Hadfield
! Support for brief prompting ("!" instead of "choice !")
!
! Revision 1.1  1995/10/03  21:04:48  Mark_Hadfield
! Initial revision
!



NEXISTS "m:\cis\switch\Guide.On" GOTO intro
ALERT ":-) FILES $Revision: 2.0 $"
GOTO files
intro:
INFO "FILES $Revision: 2.0 $"
GOTO files

files:
NEXISTS "m:\cis\switch\files.off" GOTO files1
NEXISTS "m:\cis\switch\Guide.on" GOTO goodbye
ALERT ":-O Files.OFF switch set. Skipping."
GOTO goodbye

files1:
EXISTS "m:\cis\switch\files.on" GOTO files1on
NEXISTS "m:\cis\switch\files1.on" GOTO files1noton

files1on:
EXISTS "m:\cis\switch\files.off" GOTO files1off
EXISTS "\cis\forums\files1.cis" GOTO files1exist
SENDWAIT 120 "go <forum1>", "!" GOTO noprompt
SENDWAIT 120 "", "!" GOTO noprompt
SENDWAIT 120 "lib 1", "!" GOTO noprompt
SENDWAIT 120 "set page no", "!" GOTO noprompt
SEND "dir desc long age:7 lib:<sections1>"
RECEIVE "\cis\forums\files1.cis", "ASCII"
GOTO files2

files1noton:
NEXISTS "m:\cis\switch\Guide.on" GOTO files2
ALERT ":-O No Files1.on or Files.on switch. Skipping."
GOTO files2

files1off:
NEXISTS "m:\cis\switch\Guide.on" GOTO files2
ALERT ":-O Files1.OFF switch set. Skipping."
GOTO files2

files1exist:
NEXISTS "m:\cis\switch\Guide.on" GOTO files2
ALERT ":-O Files1.cis exists. Skipping."
GOTO files2


files2:
EXISTS "m:\cis\switch\files.on" GOTO files2on
NEXISTS "m:\cis\switch\files2.on" GOTO files2noton

files2on:
EXISTS "m:\cis\switch\files2.off" GOTO files2off
EXISTS "\cis\forums\files2.cis" GOTO files2exist
SENDWAIT 120 "go <forum2>", "!" GOTO noprompt
SENDWAIT 120 "", "!" GOTO noprompt
SENDWAIT 120 "lib 1", "!" GOTO noprompt
SENDWAIT 120 "set page no", "!" GOTO noprompt
SEND "dir desc long age:7 lib:<sections2>"
RECEIVE "\cis\forums\files2.cis", "ASCII"
GOTO files3

files2noton:
NEXISTS "m:\cis\switch\Guide.on" GOTO files3
ALERT ":-O No Files2.on or Files.on switch. Skipping."
GOTO files3

files2off:
NEXISTS "m:\cis\switch\Guide.on" GOTO files3
ALERT ":-O Files2.OFF switch set. Skipping."
GOTO files3

files2exist:
NEXISTS "m:\cis\switch\Guide.on" GOTO files3
ALERT ":-O Files2.cis exists. Skipping."
GOTO files3


files3:
EXISTS "m:\cis\switch\files.on" GOTO files3on
NEXISTS "m:\cis\switch\files3.on" GOTO files3noton

files3on:
EXISTS "m:\cis\switch\files3.off" GOTO files3off
EXISTS "\cis\forums\files3.cis" GOTO files3exist
SENDWAIT 120 "go <forum3>", "!" GOTO noprompt
SENDWAIT 120 "", "!" GOTO noprompt
SENDWAIT 120 "lib 1", "!" GOTO noprompt
SENDWAIT 120 "set page no", "!" GOTO noprompt
SEND "dir desc long age:7 lib:<sections3>"
RECEIVE "\cis\forums\files3.cis", "ASCII"
GOTO goodbye

files3noton:
NEXISTS "m:\cis\switch\Guide.on" GOTO goodbye
ALERT ":-O No Files3.on or Files.on switch. Skipping."
GOTO goodbye

files3off:
NEXISTS "m:\cis\switch\Guide.on" GOTO goodbye
ALERT ":-O Files3.OFF switch set. Skipping."
GOTO goodbye

files3exist:
NEXISTS "m:\cis\switch\Guide.on" GOTO goodbye
ALERT ":-O Files3.cis exists. Skipping."
GOTO goodbye

 

 







noprompt:
NEXISTS "m:\cis\switch\Guide.on" goto infnoprompt
ALERT "Compuserve has not responded with a prompt"
GOTO logoff
infnoprompt:
BEEP 5,300
INFO "Compuserve has not responded with a prompt"
WAIT 20
GOTO logoff

unknownpage:
NEXISTS "m:\cis\switch\Guide.on" goto infnopage
ALERT "Unknown page. Ask Mark to edit the script again!"
GOTO logoff
infnopage:
BEEP 5,300
INFO "Unknown page. Time to edit the script again!"
WAIT 20
GOTO logoff



goodbye:
 

 












EXISTS "a:\sco\Uk_Tv.sco" GOTO auktv
EXISTS "b:\sco\Uk_Tv.sco" GOTO buktv
EXISTS "m:\sco\Uk_Tv.sco" GOTO muktv



EXISTS "a:\sco\Charges.sco" GOTO acharges
EXISTS "b:\sco\Charges.sco" GOTO bcharges
EXISTS "m:\sco\Charges.sco" GOTO mcharges


NEXISTS "m:\cis\switch\user2.on" GOTO user2off
EXISTS "a:\sco\3user2.sco" GOTO atwo
EXISTS "b:\sco\3user2.sco" GOTO btwo
EXISTS "m:\sco\3user2.sco" GOTO mtwo

GOTO farewell

user2off:
NEXISTS "m:\cis\switch\Guide.on" GOTO farewell
ALERT ":-O User2.on switch not set. Skipping."
GOTO farewell

farewell:
NEXISTS "m:\cis\switch\Guide.on" goto logoff
ALERT ":-O No other scripts installed. Logging off."
GOTO logoff







auktv:
NEXISTS "m:\cis\switch\Guide.on" goto callauktv
ALERT ":-) Uk_Tv installed on A:"
callauktv:
CALL "a:\sco\uk_tv.sco"

buktv:
NEXISTS "m:\cis\switch\Guide.on" goto callbuktv
ALERT ":-) Uk_Tv installed on B:"
callbuktv:
CALL "b:\sco\uk_tv.sco"

muktv:
NEXISTS "m:\cis\switch\Guide.on" goto callmuktv
ALERT ":-) Uk_Tv installed on M:"
callmuktv:
CALL "m:\sco\uk_tv.sco"



acharges:
NEXISTS "m:\cis\switch\Guide.on" goto callacharges
ALERT ":-) Charges installed on A:"
callacharges:
CALL "a:\sco\Charges.sco"

bcharges:
NEXISTS "m:\cis\switch\Guide.on" goto callbcharges
ALERT ":-) Charges installed on B:"
callbcharges:
CALL "b:\sco\Charges.sco"

mcharges:
NEXISTS "m:\cis\switch\Guide.on" goto callmcharges
ALERT ":-) Charges installed on M:"
callmcharges:
CALL "m:\sco\Charges.sco"


atwo:
NEXISTS "m:\cis\switch\Guide.on" goto callatwo
ALERT ":-) 3user2 installed on A:"
callatwo:
CALL "a:\sco\3user2.sco"

btwo:
NEXISTS "m:\cis\switch\Guide.on" goto callbtwo
ALERT ":-) 3user2 installed on B:"
callbtwo:
CALL "b:\sco\3user2.sco"

mtwo:
NEXISTS "m:\cis\switch\Guide.on" goto callmtwo
ALERT ":-) 3user2 installed on M:"
callmtwo:
CALL "m:\sco\3user2.sco"


logoff:
SENDWAIT 360 "go top", "!" GOTO bombout
bombout:
EXISTS "a:\app\readcis\Logoff.sco" GOTO alogoff
EXISTS "b:\app\readcis\Logoff.sco" GOTO blogoff
EXISTS "m:\app\readcis\Logoff.sco" GOTO mlogoff
GOTO mylogoff

alogoff:
CALL "a:\app\readcis\Logoff.sco"
blogoff:
CALL "b:\app\readcis\Logoff.sco"
mlogoff:
CALL "m:\app\readcis\Logoff.sco"

mylogoff:
SENDWAIT 60 "off", "Connect" GOTO modemhangup

modemhangup:
SENDWAIT 20 "+++", "OK" GOTO disconnect
SENDWAIT 60 "ATH", "NO CARRIER" GOTO terminate 
WAIT 20

disconnect:
HANGUP

terminate:
EXIT


