NEXISTS "m:\cis\switch\Guide.On" GOTO intro
ALERT ":-) UK_TV $Revision: 2.0 $"
GOTO uktv
intro:
INFO "UK_TV $Revision: 2.0 $"
GOTO uktv

uktv:
EXISTS "m:\cis\switch\uk_tv.Off" GOTO switchoff

! PA News                                                                
SENDWAIT 360 "go pao", "!" GOTO noprompt

! 4 TV & Radio Listings
SENDWAIT 240 "7", "!" GOTO noprompt
SENDWAIT 240 "set page no", "!" GOTO noprompt


! ------------------- 1 BBC1 ----------------------
bbc1:
EXISTS "m:\cis\switch\uk_tv.On" GOTO bbc1on
NEXISTS "m:\cis\switch\Bbc1.On" GOTO bbc1noton

bbc1on:
EXISTS "m:\cis\switch\Bbc1.Off" GOTO bbc1off
EXISTS "\cis\service\Bbc1.cis" GOTO bbc1exists
SENDWAIT 120 "1", " 1 " GOTO noprompt
bbc1pages1:
WAIT 120 (ON REPLY " 2 " GOTO bbc1pages2
         ON REPLY "!" GOTO bbc1pages1ok)
GOTO noprompt
         
bbc1pages1ok:
SEND "s 1"
RECEIVE "\cis\service\Bbc1.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavebbc1

bbc1pages2:
WAIT 120 (ON REPLY " 3 TV BBC1 " GOTO bbc1pages3
         ON REPLY "!" GOTO bbc1pages2ok)
