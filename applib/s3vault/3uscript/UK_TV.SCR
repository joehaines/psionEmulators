         ON REPLY "!" GOTO bbc1pages6ok)
GOTO noprompt

bbc1pages6ok:
SEND "s 6,5,4"
RECEIVE "\cis\service\Bbc1.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavebbc1

bbc1pages7:
