         ON REPLY "!" GOTO bbc1pages8ok)
GOTO noprompt

bbc1pages8ok:
SEND "s 8,7,6"
RECEIVE "\cis\service\Bbc1.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavebbc1

bbc1exists:
NEXISTS "m:\cis\switch\Guide.On" GOTO bbc2
ALERT ":-O Bbc1.cis exists. Skipping."
GOTO bbc2

bbc1noton:
NEXISTS "m:\cis\switch\Guide.On" GOTO bbc2
ALERT ":-O No Bbc1.On or Uk_Tv.On switch. Skipping."
GOTO bbc2

bbc1off:
NEXISTS "m:\cis\switch\Guide.On" GOTO bbc2
ALERT ":-O Bbc1.Off switch set. Skipping."
GOTO bbc2

leavebbc1:
! -- return to TV and Radio menu
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO bbc2


