skyon:
EXISTS "m:\cis\switch\Sky.Off" GOTO skyoff
EXISTS "\cis\service\sky.cis" GOTO skyexists
SENDWAIT 120 "5", " 1 " GOTO noprompt

skypages1:
WAIT 120 (ON REPLY " 2 TV SATELLITE " GOTO skypages2
         ON REPLY "!" GOTO skypages1ok)
GOTO noprompt
         
skypages1ok:
SEND "s 1"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages2:
WAIT 120 (ON REPLY " 3 TV SATELLITE " GOTO skypages3
         ON REPLY "!" GOTO skypages2ok)
GOTO noprompt

skypages2ok:
SEND "s 2,1"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages3:
WAIT 120 (ON REPLY " 4 TV SATELLITE " GOTO skypages4
         ON REPLY "!" GOTO skypages3ok)
GOTO noprompt

skypages3ok:
SEND "s 3,2,1"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages4:
WAIT 120 (ON REPLY " 5 TV SATELLITE " GOTO skypages5
         ON REPLY "!" GOTO skypages4ok)
GOTO noprompt

skypages4ok:
SEND "s 4,3,2"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages5:
WAIT 120 (ON REPLY " 6 TV SATELLITE " GOTO skypages6
         ON REPLY "!" GOTO skypages5ok)
GOTO noprompt

skypages5ok:
SEND "s 5,4,3"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages6:
WAIT 120 (ON REPLY " 7 TV SATELLITE " GOTO skypages7
         ON REPLY "!" GOTO skypages6ok)
GOTO noprompt

skypages6ok:
SEND "s 6,5,4"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages7:
WAIT 120 (ON REPLY " 8 TV SATELLITE " GOTO skypages8
         ON REPLY "!" GOTO skypages7ok)
GOTO noprompt

skypages7ok:
SEND "s 7,6,5"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages8:
WAIT 120 (ON REPLY " 9 TV SATELLITE " GOTO skypages9
         ON REPLY "!" GOTO skypages8ok)
GOTO noprompt

skypages8ok:
SEND "s 8,7,6"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages9:
WAIT 120 (ON REPLY " 10 TV SATELLITE " GOTO skypages10
         ON REPLY "!" GOTO skypages9ok)
GOTO noprompt

skypages9ok:
SEND "s 9,8,7"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky

skypages10:
WAIT 120 (ON REPLY " 11 " GOTO unknownpage
         ON REPLY "!" GOTO skypages10ok)
GOTO noprompt

skypages10ok:
SEND "s 10,9,8"
RECEIVE "\cis\service\sky.cis", "ASCII"
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO leavesky


skyexists:
NEXISTS "m:\cis\switch\Guide.On" GOTO radio
ALERT ":-O Sky.cis exists. Skipping."
GOTO radio

skynoton:
NEXISTS "m:\cis\switch\Guide.On" GOTO radio
ALERT ":-O No Sky.On or Uk_Tv.On switch. Skipping."
GOTO radio

skyoff:
NEXISTS "m:\cis\switch\Guide.On" GOTO radio
ALERT ":-O Sky.Off switch set. Skipping."
GOTO radio

leavesky:
! -- return to TV and Radio menu
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO radio


! ----------------- 6 RADIO -----------------------
radio:
EXISTS "m:\cis\switch\Uk_Tv.On" GOTO radioon
NEXISTS "m:\cis\switch\Radio.On" GOTO radionoton

radioon:
EXISTS "m:\cis\switch\Radio.Off" GOTO radiooff
EXISTS "\cis\service\radio.cis" GOTO radioexists
SENDWAIT 120 "6", " 1 " GOTO noprompt

radiopages1:
WAIT 120 (ON REPLY " 2 RADIO SUMMYS " GOTO radiopages2
         ON REPLY "!" GOTO radiopages1ok)
GOTO noprompt
         
radiopages1ok:
SEND "s 1"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages2:
WAIT 120 (ON REPLY " 3 RADIO SUMMYS " GOTO radiopages3
         ON REPLY "!" GOTO radiopages2ok)
GOTO noprompt

radiopages2ok:
SEND "s 2,1"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages3:
WAIT 120 (ON REPLY " 4 RADIO SUMMYS " GOTO radiopages4
         ON REPLY "!" GOTO radiopages3ok)
GOTO noprompt

radiopages3ok:
SEND "s 3,2,1"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages4:
WAIT 120 (ON REPLY " 5 RADIO SUMMYS " GOTO radiopages5
         ON REPLY "!" GOTO radiopages4ok)
GOTO noprompt

radiopages4ok:
SEND "s 4,3,2"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages5:
WAIT 120 (ON REPLY " 6 RADIO SUMMYS " GOTO radiopages6
         ON REPLY "!" GOTO radiopages5ok)
GOTO noprompt

radiopages5ok:
SEND "s 5,4,3"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages6:
WAIT 120 (ON REPLY " 7 RADIO SUMMYS " GOTO radiopages7
         ON REPLY "!" GOTO radiopages6ok)
GOTO noprompt

radiopages6ok:
SEND "s 6,5,4"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages7:
WAIT 120 (ON REPLY " 8 RADIO SUMMYS " GOTO radiopages8
         ON REPLY "!" GOTO radiopages7ok)
GOTO noprompt

radiopages7ok:
SEND "s 7,6,5"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages8:
WAIT 120 (ON REPLY " 9 " GOTO radiopages9
         ON REPLY "!" GOTO radiopages8ok)
GOTO noprompt

radiopages8ok:
SEND "s 8,7,6"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages9:
WAIT 120 (ON REPLY " 10 " GOTO radiopages10
         ON REPLY "!" GOTO radiopages9ok)
GOTO noprompt

radiopages9ok:
SEND "s 9,8,7"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio

radiopages10:
WAIT 120 (ON REPLY " 11 " GOTO unknownpage
         ON REPLY "!" GOTO radiopages10ok)
GOTO noprompt

radiopages10ok:
SEND "s 10,9,8"
RECEIVE "\cis\service\radio.cis", "ASCII"
GOTO leaveradio


radionoton:
NEXISTS "m:\cis\switch\Guide.On" GOTO goodbye
ALERT ":-O No Radio.On or Uk_Tv.On switch. Skipping."
GOTO goodbye

radiooff:
NEXISTS "m:\cis\switch\Guide.On" GOTO goodbye
ALERT ":-O Radio.Off switch set. Skipping."
GOTO goodbye

radioexists:
NEXISTS "m:\cis\switch\Guide.On" GOTO goodbye
ALERT ":-O Radio.cis exists. Skipping."
GOTO goodbye

leaveradio:
! -- return to TV and Radio menu
SENDWAIT 120 "m", "!" GOTO noprompt
GOTO goodbye


switchoff:
NEXISTS "m:\cis\switch\Guide.On" GOTO goodbye
ALERT ":-O Uk_Tv.Off switch set. Skipping."
GOTO goodbye


 

 







noprompt:
NEXISTS "m:\cis\switch\Guide.on" goto infnoprompt
ALERT "Compuserve has not responded with a prompt"
GOTO logoff
infnoprompt:
BEEP 5,300
INFO "Compuserve has not responded with a prompt"
WAIT 20
GOTO logoff

unknownpage:
NEXISTS "m:\cis\switch\Guide.on" goto infnopage
ALERT "Unknown page. Ask Mark to edit the script again!"
GOTO logoff
infnopage:
BEEP 5,300
INFO "Unknown page. Time to edit the script again!"
WAIT 20
GOTO logoff



goodbye:
 

 














EXISTS "a:\sco\Charges.sco" GOTO acharges
EXISTS "b:\sco\Charges.sco" GOTO bcharges
EXISTS "m:\sco\Charges.sco" GOTO mcharges


NEXISTS "m:\cis\switch\user2.on" GOTO user2off
EXISTS "a:\sco\3user2.sco" GOTO atwo
EXISTS "b:\sco\3user2.sco" GOTO btwo
EXISTS "m:\sco\3user2.sco" GOTO mtwo

GOTO farewell

user2off:
NEXISTS "m:\cis\switch\Guide.on" GOTO farewell
ALERT ":-O User2.on switch not set. Skipping."
GOTO farewell

farewell:
NEXISTS "m:\cis\switch\Guide.on" goto logoff
ALERT ":-O No other scripts installed. Logging off."
GOTO logoff









acharges:
NEXISTS "m:\cis\switch\Guide.on" goto callacharges
ALERT ":-) Charges installed on A:"
callacharges:
CALL "a:\sco\Charges.sco"

bcharges:
NEXISTS "m:\cis\switch\Guide.on" goto callbcharges
ALERT ":-) Charges installed on B:"
callbcharges:
CALL "b:\sco\Charges.sco"

mcharges:
NEXISTS "m:\cis\switch\Guide.on" goto callmcharges
ALERT ":-) Charges installed on M:"
callmcharges:
CALL "m:\sco\Charges.sco"


atwo:
NEXISTS "m:\cis\switch\Guide.on" goto callatwo
ALERT ":-) 3user2 installed on A:"
callatwo:
CALL "a:\sco\3user2.sco"

btwo:
NEXISTS "m:\cis\switch\Guide.on" goto callbtwo
ALERT ":-) 3user2 installed on B:"
callbtwo:
CALL "b:\sco\3user2.sco"

mtwo:
NEXISTS "m:\cis\switch\Guide.on" goto callmtwo
ALERT ":-) 3user2 installed on M:"
callmtwo:
CALL "m:\sco\3user2.sco"


logoff:
SENDWAIT 360 "go top", "!" GOTO bombout
bombout:
EXISTS "a:\app\readcis\Logoff.sco" GOTO alogoff
EXISTS "b:\app\readcis\Logoff.sco" GOTO blogoff
EXISTS "m:\app\readcis\Logoff.sco" GOTO mlogoff
GOTO mylogoff

alogoff:
CALL "a:\app\readcis\Logoff.sco"
blogoff:
CALL "b:\app\readcis\Logoff.sco"
mlogoff:
CALL "m:\app\readcis\Logoff.sco"

mylogoff:
SENDWAIT 60 "off", "Connect" GOTO modemhangup

modemhangup:
SENDWAIT 20 "+++", "OK" GOTO disconnect
SENDWAIT 60 "ATH", "NO CARRIER" GOTO terminate 
WAIT 20

disconnect:
HANGUP

terminate:
EXIT


