PROC chin:
local a,b,c,key%
escape on
cls
print "  This programme caculates your chinese character"
top::
a=0
print"    Year of birth?"
input b
a=b-1900
run::
if a>42
goto Conv1::
endif
if a<30
goto Conv2::
endif
pri::
if a=30
print "Horse"
goto mo::
elseif a=31
goto mo::
print "Goat"
goto mo::
elseif a=32
print "Monkey"
goto mo::
elseif a=33
print "Rooster"
goto mo::
elseif a=34
print "Dog"
goto mo::
elseif a=35
print "Pig"
goto mo::
elseif a=36
print "Rat"
goto mo::
elseif a=37
print "Buffalo"
goto mo::
elseif a=38
print "Tiger"
goto mo::
elseif a=39
print "Cat"
goto mo::
elseif a=40
print "Dragon"
goto mo::
elseif a=41
print "Snake"
endif	
Conv1::
a=a-12
if a>42
goto Conv1::
else goto pri::
endif

conv2::
a=a+36
goto run::

mo::
print "Again? (Y/N)"
key%=get
if key%=%n
return
else cls
goto top::
endif
ENDP
