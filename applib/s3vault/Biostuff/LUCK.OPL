proc LUCK:
LOCAL A1,A2,A3,B1,B2,B3,C1,C2,C3,D1,D2,D3,E1,E3,F1,F3,G1,G3,H3,I3,J3,K3,L3,N3,Z1,Z2,Z3,Z4,Z5,Z6,Z7,Z8,Z9,KEY%
ESCAPE ON

TOP::
CLS
PRINT "Day";CHR$(63)
INPUT A1
IF A1>9
 B1=A1/10 
 C1=INT(B1)
 D1=10*(B1-C1)
ELSE C1=0
     D1=A1
ENDIF

PRINT "Month";CHR$(63)
INPUT A2
IF A2>9
 B2=A2/10
 C2=INT(B2)
 D2=10*(B2-C2)
ELSE C2=0
     D2=A2
ENDIF

PRINT "Year";CHR$(63)
INPUT A3
B3=A3/10
C3=INT(B3)
D3=10*(B3-C3)

E3=A3/100
F3=INT(E3)
G3=INT(10*(E3-F3))

H3=A3/1000
I3=INT(H3)
J3=INT(10*(H3-I3))

K3=A3/10000
L3=INT(K3)
N3=INT(10*(K3-L3))

CLS
PRINT C1;D1;"/";C2;D2;"/";N3;J3;G3;fix$(D3,0,4)
Z1=C1+D1+C2+D2+N3+J3+G3+D3
PRINT fix$(Z1,0,4)
IF Z1>9
 Z2=Z1/10
 Z3=INT(Z2)
 Z4=10*(Z2-Z3)
 Z5=Z3+Z4
ENDIF
IF Z3=Z5
 AT 4,2 :PRINT fix$(Z3,0,4);" ";fix$(Z4,0,4)
ELSE AT 4,2 :PRINT fix$(Z3,0,4);" ";fix$(Z4,0,4);" ";fix$(Z5,0,4)
ENDIF
IF Z5>9
 Z6=Z5/10
 Z7=INT(Z6)
 Z8=10*(Z6-Z7)
 Z9=Z7+Z8
 PRINT fix$(Z9,0,4)
ENDIF
MORE::
PRINT"Again(Y/N)";CHR$(63)
KEY%=GET
IF KEY%=%y
 GOTO TOP::
ELSEIF KEY%=%n
 RETURN
ELSE GOTO MORE::
ENDIF
endp
