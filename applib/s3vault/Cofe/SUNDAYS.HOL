! Church of England Holy Days
! SUNDAYS & PRINCIPAL HOLY DAYS
! AND OTHER MOVEABLE FEASTS
! As listed in the ASB 1980
! including references to the BCP 1662

! Compiled by The Revd. Mark Norris 1997
! e-mail: mnorris@cix.co.uk
! for use with HOL v2.0 (c) 1996 Odd Gripenstam

! NOTE: where two entries appear on one day,
! the one in BOLD type takes precedence.

year_symbol = "F";
style = bold;
{"EASTER DAY" = easter; alias = p; }
"ASH WEDNESDAY" = p - 46;
"Palm Sunday (Sunday next before Easter)" = p - 7;
"Fifth Sunday in Lent (Passion Sunday)" = p - 14;
"Fourth Sunday in Lent - Mothering Sunday (3 before Easter)" = p - 21;
"Third Sunday in Lent (4 before Easter)" = p - 28;
"Second Sunday in Lent (5 before Easter)" = p - 35;
"First Sunday in Lent (6 before Easter)" = p - 42;
"7th Sunday before Easter (Quinquagesima: Sunday next before Lent)" = p - 49;
"8th Sunday before Easter (Sexagesima: 2 before Lent)" = p - 56;
"9th Sunday before Easter (Septuagesima : 3 before Lent)" = p - 63;
"Monday in Holy Week" = p - 6;
"Tuesday in Holy Week" = p - 5;
"Wednesday in Holy Week" = p - 4;
"MAUNDY THURSDAY" = p - 3;
"GOOD FRIDAY" = p - 2 ;
"Easter Eve" = p - 1;
"Monday in Easter Week" = p + 1;
"Tuesday in Easter Week" = p + 2;
"Wednesday in Easter Week" = p + 3;
"Thursday in Easter Week" = p + 4;
"Friday in Easter Week" = p + 5;
"Saturday in Easter Week" = p + 6;
"1st Sunday after Easter" = p+7;
"2nd Sunday after Easter" = p + 14;
"3rd Sunday after Easter" = p + 21;
"4th Sunday after Easter" = p + 28;
"5th Sunday after Easter (Rogation Sunday)" = p + 35;
"Ascension Day"= p + 39;
"Sunday after Ascension Day (6th Sunday after Easter)" = p + 42;
"PENTECOST (Whit Sunday)" = p+49;
"Monday after Pentecost [Bank Holiday]" = p+50;
"Trinity Sunday: (Pentecost 1)" = p + 56;
STYLE = normal;
"Pentecost 2 (Trinity 1)" = p + 63;
"Pentecost 3 (Trinity 2)" = p + 70;
"Pentecost 4 (Trinity 3)" = p + 77;
"Pentecost 5 (Trinity 4)" = p + 84;
"Pentecost 6 (Trinity 5)" = p + 91;
"Pentecost 7 (Trinity 6)" = p + 98;
"Pentecost 8 (Trinity 7)" = p + 105;
"Pentecost 9 (Trinity 8)" = p + 112;
"Pentecost 10 (Trinity 9)" = p + 119;
"Pentecost 11 (Trinity 10)" = p + 126;
"Pentecost 12 (Trinity 11)" = p + 133;
"Pentecost 13 (Trinity 12)" = p + 140;
"Pentecost 14 (Trinity 13)" = p + 147;
"Pentecost 15 (Trinity 14)" = p + 154;
"Pentecost 16 (Trinity 15)" = p + 161;
"Pentecost 17 (Trinity 16)" = p + 168;
"Pentecost 18 (Trinity 17)" = p + 175;
"Pentecost 19 (Trinity 18)" = p + 182;
"Pentecost 20 (Trinity 19)" = p + 189;
"Pentecost 21 (Trinity 20)" = p + 196;
"Pentecost 22 (Trinity 21)" = p + 203;
"(Trinity 22)" = p + 210;
"(Trinity 23)" = p + 217;
"(Trinity 24)" = p + 224;
"(Trinity 25)" = p + 231;

STYLE = bold;
"REMEMBRANCE SUNDAY" = float(11, 0, 2);

{"ADVENT SUNDAY (4 before Christmas)" = float(12, 0, -1, 3);
	alias = a;}
"LAST Sunday after Pentecost" = a - 42;
"9th Sunday before Christmas (5 before Advent)" = a - 35;
"8th Sunday before Christmas (4 before Advent)" = a - 28;
"7th Sunday before Christmas (3 before Advent)" = a - 21;
"6th Sunday before Christmas (2 before Advent)" = a - 14;
"Sunday next before Advent (5 before Christmas)" = a - 7;
"2nd Sunday in Advent (3 before Christmas)" = a + 7;
"3rd Sunday in Advent (2 before Christmas)"= a + 14;
"4th Sunday in Advent (Sunday next before Christmas)" = a+21;
"CHRISTMAS EVE" = fix(12, 24); 
"CHRISTMAS DAY" = fix(12, 25);
"1st Sunday after Christmas" = a + 28;
{"2nd Sunday after Christmas" = a + 35; style = normal;}  
"NEW YEAR'S EVE" = fix(12,31);
"NEW YEAR'S DAY" = fix(1,1);
"The Epiphany of Our Lord" = fix(1, 6);
{"Epiphany 1" = float(1,0,1,7); alias = e;}
"Epiphany 2" = e + 7;

STYLE = normal;
"Epiphany 3" = e + 14;
"Epiphany 4" = e + 21;
"Epiphany 5" = e + 28;
"Epiphany 6" = e + 35;

