proc update:
REM This allows you access to the main program
REM "con5a6.opa". It sends to this procedure
REM just before declaring the mcard of the
REM main menu
endp

proc card:
REM This is where you can change the main menu
	mcard w$(443),w$(444),%M,w$(445),%W,w$(446),%B,w$(447),%X,w$(448),%I,w$(449),%O,w$(450),%J,w$(451),%Z
endp

proc procum:
REM If the hot key is a capital, the procedure
REM name is "procu" plus the letter. i.e this
REM is "Shoes",%M therefore "procum". Lower
REM case is "proc1" plus the letter.
	gclock off :gcls :font 10,16
	print wl$(33)
	print
	print " UK   6"+chr$(171)+"  7   7"+chr$(171)+"  8   8"+chr$(171)+"  9   9"+chr$(171)+"  10  10"+chr$(171)+" 11"
	print " USA  7   7"+chr$(171)+"  8   8"+chr$(171)+"  9   9"+chr$(171)+"  10  10"+chr$(171)+" 11  11"+chr$(171)
	print " EC   39  40  41  42  43  43  44  44  45  46"
	print
	print wl$(34)
	print
	print " UK   3   3"+chr$(171)+"  4"+chr$(171)+"  5"+chr$(171)+"  6"+chr$(171)+"  6"+chr$(171)
	print " USA  4   5   6   7   8   9"
	print " EC   35  36  37  38  39  40"
	print
	print wl$(32)
	gborder 2,478,159
	get :gcls :box:
endp

proc procuw:
	gclock off :gcls :font 10,16
	print "                       "+upper$(w$(445))
	print " "+w$(452)+" 18 3/4  19  19 3/8  19 3/4  20 1/4  20 3/4"
	print " "+w$(453)+" 19 3/4  20  20 1/4  20 3/4  21 1/4  21 5/8"
	print " "+w$(454)+"  5 7/8   6   6 1/8   6 1/4   6 3/8   6 1/2"
	print
	print " "+w$(452)+" 21   21 1/2  21 5/8  22 1/4 22 1/2  23"
	print " "+w$(453)+" 22   22 1/2  22 7/8  23 1/4 23 1/2  24"
	print " "+w$(454)+" 6 5/8 6 3/4   6 7/8   7      7 1/8   7 1/4"
	print
	print " "+w$(452)+" 23 3/8  23 3/4 24    24 1/2  25     25 1/4"
	print " "+w$(453)+" 24 3/8  24 3/4 25    25 3/8  26     26 1/2"
	print " "+w$(454)+"  7 3/8   7 1/2 7 5/8  7 3/4   7 7/8  8"
 	print wl$(32)
	gborder 2,478,159
	get :gcls :box:
endp

