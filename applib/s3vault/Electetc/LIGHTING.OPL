PROC LIGHT:
LOCAL L,W,H,K,R,V,M,E,F,N
PRINT "ROOM DIMS(m) L=";
INPUT L
AT 21,1:PRINT "W=";
INPUT W
AT 28,1:PRINT "H=";
INPUT H
K=L*W/(H*(L+W))
PRINT "K-FACTOR =";FIX$(K,2,6)
PRINT "FROM THE TABLES,ROOM INDEX   (%)=";
INPUT R
R=R/100
PRINT "LIGHTING LEVEL REQD        (LUX)=";
INPUT V
PRINT "FROM THE CATLG, LAMP OUTPUT (LM)=";
INPUT M
PRINT "FROM THE CATLG, LAMP EFFY    (%)=";
INPUT E
E=E/100
PRINT "FROM THE CATLG, LAMP AGE FACTOR =";
INPUT F
N=(V*L*W)/(M*E*F*R)
PRINT
PRINT "Number of Light Fittings =";
PRINT FIX$(N,1,7)
GET
ENDP

