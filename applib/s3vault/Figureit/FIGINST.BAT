@echo offif (%1)==() goto xhelpif not exist %1\APP\FIGUREIT\BACKGRND md %1\APP\FIGUREIT\BACKGRNDif not exist %1\APP\FIGUREIT\GRAPHIC md %1\APP\FIGUREIT\GRAPHICecho copying the FigureIT application to %1\appcopy APP\FIGUREIT.opa %1\app\FIGUREIT.opacopy APP\FIGUREIT\psinag.opo %1\APP\FIGUREIT\psinag.opocopy APP\FIGUREIT\nag.ini %1\APP\FIGUREIT\nag.inicopy APP\FIGUREIT\FIGURE.RSC %1\APP\FIGUREIT\FIGURE.RSCcopy APP\FIGUREIT\BACKGRND\FGBUTTON.PIC %1\APP\FIGUREIT\BACKGRND\FGBUTTON.PICecho FIGUREIT installation completeecho Choose Install from the System Screengoto end:xhelpecho.echo Change directory to the FigureIT install directory. i.e.echo CD C:\FIGUREITecho .echo Then typeecho FIGINST drive:echo.echo         drive: should be the drive letter on theecho                remote computer. e.g. FIGINST I:echo.:end