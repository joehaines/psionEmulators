!Loads GNAV3 to your SSD in A
copy c:\psion3\gnav3.opa rem::a:\app\
copy c:\psion3\gnav3*.opo rem::a:\app\GNAV3\
copy c:\psion3\*.G3D rem::a:\app\GNAV3\data\
copy c:\psion3\RIGMIN.G3C rem::a:\app\GNAV3\data\
copy c:\psion3\approach.G3C rem::m:\app\GNAV3\data\
copy c:\psion3\haggis.fon rem::a:\app\GNAV3\data\
copy c:\psion3\gnav3.fon rem::a:\app\GNAV3\data\
