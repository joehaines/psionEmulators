PROC GENHANG:
LOCAL A,B,F$(12),R%
IF NOT EXIST ("HANGMAN")
 CREATE "HANGMAN",A,F$
ELSE
 OPEN "HANGMAN",A,F$
ENDIF
DO :CLS :POSITION COUNT :PRINT "LAST NAME= ";A.F$
AT 20,2 :PRINT "RECORD COUNT = ",COUNT
AT 9,3 :PRINT "(A)DD A RECORD "
AT 9,4 :PRINT "(L)OOK "
AT 9,5 :PRINT "(X)INPUT"
AT 9,6 :PRINT "(Q)UIT "
R%=GET
AT 1,8 :PRINT "                  " :AT 1,8
IF R%=%q OR R%=%Q :BREAK
  ELSEIF R%=%X OR R%=%x :PRINT "DOWN LOADING   "; :
 ELSEIF R%=%A OR R%=%a :PRINT "NAME   "; :INPUT A.F$ :APPEND
 ELSEIF R%=%L OR R%=%l :PRINT "RECORD No. "; :INPUT R% :POSITION R% :PRINT "      ";A.F$,"         PRESS ANY KEY"
GET
 ELSE BEEP 16,250
 ENDIF
UNTIL 0
ENDP
