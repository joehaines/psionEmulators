PROC main:
	local k%
	busy "Psion+Esc to end"
	do
		k%=get
		if k%=291 rem Help key
			help%:
		endif
	until 0
ENDP

PROC help%:
	LOCAL gate%,buf%(65),fname$(130)
	LOCAL page&,base&
	page&=1
	base&=1
	if exist("loc::m:\hlp\eg.rsc")
		fname$="loc::m:\hlp\eg.rsc"
	else
		alert("'loc::m:\hlp\eg.rsc' cannot be found.")
		stop
	endif	
	POKE$ ADDR(buf%(1)),"#"+fname$
	gate%=PEEKW($38)
	SEND(gate%,27,buf%(2))
	SEND(gate%,26,#page&,#base&)
ENDP
