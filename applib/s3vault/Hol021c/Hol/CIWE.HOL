! Church in Wales Holy Days - English - by the Revd Ian Day

! The files Ciw?.hol are the data files for adding Christian festivals and
! seasons to a Psion Agenda file.   They are based on the lectionary of
! The Church In Wales with the exception of the feast of the Confession of
! Peter which has been added because this feast together with the
! Conversion of Paul provide the start and finish dates for the Week of
! Prayer for Christian Unity in the UK.

! Whilest I have tried to check thoroughly the accuracy of both spelling
! and dating I would value receiving information concerning any
! inaccuracies or misspellings.

! Ian Day
! Parish of Mold, Church in Wales, UK
! friday@mcmail.com

year_symbol = "F";
style = bold,italic;
{"Easter Day" = easter; alias = p; }
"Ash Wednesday" = p - 46;
"Palm Sunday: Sixth Sunday in Lent" = p - 7;
"Passion Sunday: Fifth Sunday in Lent" = p - 14;
"Fourth Sunday in Lent: Mothering Sunday" = p - 21;
"Third Sunday in Lent" = p - 28;
"Second Sunday in Lent" = p - 35;
"First Sunday in Lent" = p - 42;
"Quinquagesima" = p - 49;
"Sexagesima" = p - 56;
"Septuagesima" = p - 63;
"Monday in Holy Week" = p - 6;
"Tuesday in Holy Week" = p - 5;
"Wednesday in Holy Week" = p - 4;
"Maundy Thursday" = p - 3;
"Good Friday" = p - 2 ;
"Easter Eve" = p - 1;
"Monday in Easter Week" = p + 1;
"Tuesday in Easter Week" = p + 2;
"Ascension Day"= p + 39;
"First Sunday after Easter" = p+7;
"Second Sunday after Easter" = p + 14;
"Third Sunday after Easter" = p + 21;
"Fourth Sunday after Easter" = p + 28;
"Fifth Sunday after Easter, Rogation Sunday" = p + 35;
"Sunday after Ascension Day: Sixth Sunday after Easter" = p + 42;
"Pentecost: Whitsunday" = p+49;
"Monday after Pentecost" = p+50;
"Tuesday after Pentecost" = p+51;
"Trinity Sunday: Sunday after Pentecost" = p + 56;
"Remembrance Sunday" = float(11, 0, 2);

{"First Sunday of Advent" = float(12, 0, -1, 3);
	alias = a;}
"Second Sunday of Advent" = a + 7;
"Third Sunday of Advent"= a + 14;
"Fourth Sunday of Advent" = a+21;
"Christmas Eve" = fix(12, 24); 
"Nativity of Our Lord: Christmas Day" = fix(12, 25); 
"New Year's Eve" = fix(12,31);
"New Year's Day" = fix(1,1);
"The Naming of Jesus" = fix(1, 1);
"The Epiphany of Our Lord" = fix(1, 6);
"The Confession of Peter" = fix(1,18);
"Week of Prayer for Christian Unity Begins" = fix(1,18);
"Week of Prayer for Christian Unity" = fix(1,19);
"Week of Prayer for Christian Unity" = fix(1,20);
"Week of Prayer for Christian Unity" = fix(1,21);
"Week of Prayer for Christian Unity" = fix(1,22);
"Week of Prayer for Christian Unity" = fix(1,23);
"Week of Prayer for Christian Unity" = fix(1,24);
"Week of Prayer for Christian Unity" = fix(1,25);
"The Conversion of Paul, Apostle" = fix(1,25);
"The Presentation of Christ in the Temple, Candlemass" = fix(2,2);
"Matthias, Apostle" = fix(2,24);
"David, Bishop, Patron Saint of Wales" = fix(3, 1);
"The Annunciation to the Blessed Virgin Mary: Lady Day" = fix(3,25);
"Mark, Evangelist" = fix(4,25);
"Philip and James, Apostles" = fix(5,1);
"Barnabas, Apostle" = fix(6,11);
"The Nativity of John the Baptist" = fix(6,24);
"Peter, Apostle" = fix(6,29);
"Mary Magdalene" = fix(7,22);
"James, Apostle" = fix(7,25);
"The Transfiguration of Our Lord" = fix(8,6);
"The Blessed Virgin Mary, Mother of Our Lord Jesus Christ" = fix(8,15);
"Bartholomew, Apostle" = fix(8,24);
"Matthew, Apostle and Evangelist" = fix(9,21);
"Michael and All Angels: Michaelmas" = fix(9,29);
"Luke, Evangelist" = fix(10,18);
"Simon and Jude, Apostles" = fix(10,28);
"All Saints" = fix(11,1);
"The Commemoration of All Souls" = fix(11,2);
