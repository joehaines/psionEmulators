style = italic;
year_symbol = "L";

"Uudenvuodenpaiva"      = fix(1, 1);
"Loppiainen"            = fix(1, 6);
"Paasiainen"            = easter;
"Toinen Paasiaispaiva"  = easter+1;
"Vappu"                 = fix(5, 1);
"Itsenaisyyspaiva"      = fix(12, 6);
"Ystavanpaiva"          = fix(2, 2);
"aitienpaiva"           = float(5, 0 , 2);
"Aprillipaiva"          = fix(4, 1);
"Palmusunnuntai"        = easter - 7;
"Pitkaperjantai"        = easter - 2;
"Helluntai"             = easter + 49;
"Pyhainpaiva"           = fix(10, 31);
"Joulu"                 = fix(12, 25);
"Jouluaatto"            = fix(12, 24);
{"Juhannus"             = float(6, 6, 1, 20); alias = m;}
{"Juhannusaatto"        = m - 1; year_symbol = "";}
{"1. Adventtisunnuntai" = float(12, 0, -1, 3); alias = a;}
"2. Adventtisunnuntai"  = a + 7;
"3. Adventtisunnuntai"  = a + 14;
"4. Adventtisunnuntai"  = a + 21;

