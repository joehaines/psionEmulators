! Examples of islamic holidays.
! Please improve on this!

style = italic;

"Islamic New Year %iy" = ifix(1, 1);
"Ashura"               = ifix(1, 10);
"Mulad-al-Nabi"        = ifix(3, 12);
"Shab-e-Mi'raj"        = ifix(7, 26);
"Shab-e-Bara't"        = ifix(8, 15);
"Ramadan %iy begins"   = ifix(9, 1);
"Shab-e Qadr"          = ifix(9, 27);
"Id-al-Fitr"           = ifix(10, 1);
"Id-al-Adha"           = ifix(12, 10);
 
