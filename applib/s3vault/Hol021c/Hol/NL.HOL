year_symbol = "H";
style = italic;

"Nieuwjaarsdag"      = fix(1, 1);
{"Eerste Paasdag"    = easter;      alias = p; }
"Goede Vrijdag"      = p - 2 ;
"Tweede Paasdag"     = p + 1;
"Hemelvaartsdag"     = p + 39;
"Eerste Pinksterdag" = p + 49;
"Tweede Pinksterdag" = p + 50;
"Koninginnedag"      = fix(4,30);
"Bevrijdingsdag"     = fix(5,5);
"Eerste Kerstdag"    = fix(12,25);
"Tweede Kerstdag"    = fix(12,26);
"Oudjaarsdag"        = fix(12,31);

year_symbol = "";


"Valentijnsdag"      = fix(2,14);
"Palm Zondag"        = p - 7 ;
"Witte donderdag"    = p - 3 ;
"Herdenkingsdag"     = fix(5,4);
"Moederdag"          = float(5,0,2);
"Vaderdag"           = float(6,0,3);
"Dierendag"          = fix(10,4);
"Sint Nicolaas"      = fix(12,6);
{"Eerste advent"     = float(12, 0, -1, 3); alias = a; }
"Tweede advent"      = a + 7;
"Derde advent"       = a + 14;
"Vierde advent"      = a + 21;
"Kerstavond"         = fix(12,24); 



