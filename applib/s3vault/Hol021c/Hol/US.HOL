  year_symbol = "";
  "Ground Hog Day" = fix(2,2); ! February 2
}
{
  year_symbol = "A";
  "St. Valentine's Day" = fix(2, 14); ! February 14
}
"Presidents Day" = float(2, 1, 3); ! Third Monday in February
year_symbol = "";
"St. Patrick's Day" = fix(3, 17); !  March 17
"Fool's Day" = fix(4, 1); ! April 1
year_symbol = "H";
{
  "Easter" = easter; 
  alias = e;
}
{
  "Palm Sunday" = e - 7;
  year_symbol = "";
}
{
  year_symbol = "";
  "Ash Wednesday" = e -46;
}
"Good Friday" = e - 2;
"Passover" = hfix(1,15);
{
  year_symbol = "A";
  "Mother's Day" = float(5, 0, 2); ! Second Sunday in May
}
"Memorial Day" = float(5, 1, -1); ! Last Monday in May
{
  year_symbol = "";
  "Pentecost" = e + 49;
}
{
  year_symbol = "";
  "Flag Day" = fix(6, 14); ! June 14
}
{
  year_symbol = "A";
  "Father's Day" = float(6, 0, 3); ! Third Sunday in June
}
"Independence Day" = fix(7, 4); ! July 4
"Labor Day" = float(9, 1, 1); ! First Monday in September
