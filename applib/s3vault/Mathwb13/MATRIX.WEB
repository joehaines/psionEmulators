<cname>sum</cname>
<val>-0.672</val></cell>
<cell>
<cname>temp</cname>
<val>2.000</val></cell>
<cell>
<cname>tiny</cname>
<val>0.0000000001</val>
<script>0.0000000001</script></cell>
<cell>
