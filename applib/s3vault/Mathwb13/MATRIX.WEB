
<opts>
<isrc>cell</isrc>
<iname>INPUT</iname>
<iecho>yes</iecho>
<odest>screen</odest>
<oname>OUTPUT</oname>
<onewl>lf</onewl>
<scrfont>swiss13</scrfont>
<statwin>on</statwin>
<cfmt>~\n</cfmt>
<citer>1</citer>
