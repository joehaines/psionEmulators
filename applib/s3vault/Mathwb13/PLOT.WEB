 </text>
<val>3.10000E+01</val>
<script>set r to 2
set theta to 0
    for(home=1 to 31) {
        set theta to theta+2
        set y to y0+r*0.5*sin(theta)
        set x to x0+r*0.5*cos(theta)
        set r to r+.15
    }
}</script></cell>
