<cell>
<cname>distribution</cname>
<text>This cell prints descriptive statistics and plots a frequency distribution of the samples currently in the text field of cell "data". 

There are ten bins in the frequency distribution.  The plot shows the percentage of numbers falling within each bin versus the bin number.

</text>
<script>set outtype to screen
clearbins()
initstats()
set inname to "data"
set binwidth to srange()/10
set smean to smean/count
set inname to "data"
while(not eof) {
    in(temp)
    set var to var+pow(temp-smean,2)
    set indx to 0
    while(indx&lt;10) {
        if(temp&lt;=(smin+(indx+1)*binwidth)) {
              set b01[indx] to 1+b01[indx]
              set indx to 10
        } else {
             set indx to indx+1
        } #endif
    } #endwhile
} #endwhile
for(bin=0.5 to 9.5) {
     set  prcnt to 100*b01[bin]/count
}#endfor
statsout()</script></cell>
<cell>
