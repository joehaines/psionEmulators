<cell>
<cname>stats</cname>
<text>This cell prints to the output screen descriptive statistics of the numbers in the text field of cell "data"</text>
<script>set inname to data
set outtype to screen
initstats()
srange()
set smean to smean/count
set inname to "data"
while(not eof) {
    in(temp)
    set var to var+pow(temp-smean,2)
} #endwhile
statsout()</script></cell>
<cell>
<cname>statsout</cname>
<script>out("\nNumber of Samples=",count)
out("\nMin=",smin," max=",smax," range=",srange," mean=",smean)
if(count>1) {
    set var to var/(count-1)
    set stdev to sqrt(var)
    out("\nVariance=",var," Std dev=",stdev)
    out(" Coefficient of variation=",100*stdev/smean,"%")
}</script></cell>
