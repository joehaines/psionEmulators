
APP  moc
 TYPE 3                      REM 1
 PATH "\MOC"                 REM 2
 EXT  "MOC"                  REM 3
 ICON "\OPL\MOC1.PIC"        REM 4
ENDA

PROC moc:
 LOADM "\OPO\FRAMELIB.OPO"   REM 5
 LOADM "\OPO\MOCLIB.OPO"     REM 6
 fAutoOff:                   REM 7
 runMoc:("LOC::\MOC\","MOC") REM 8
ENDP
