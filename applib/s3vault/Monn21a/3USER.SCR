info "Starting 3user...."

nexists "m:\sco\monnaie.sco" goto loga
call "m:\sco\monnaie.sco"
loga:
nexists "a:\sco\monnaie.sco" goto logb
call "a:\sco\monnaie.sco"
logb:
nexists "b:\sco\monnaie.sco" goto nomo
call "b:\sco\monnaie.sco"

nomo:
alert "Cannot find Mon_script - Script terminated"

exit

