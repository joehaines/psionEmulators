PROC Dragon1:
	LOCAL P,S%,D%,xpos%,ypos%,stx%,sty%
	LOCAL H,X1,X2,XA,XB,Y1,Y2,YA,YB
	LOCAL M&,N&,F
	gCLS
	P=7 :REM CHOICE OF ORDER 4-12
	stx%=80 :sty%=50 :REM start pos
	H=2**(-P/2) :S%=0
	X1=H*COS(P*PI/4)
	Y1=-H*SIN(P*PI/4)
	xpos%=INT(0.4+(.75*X1+1)*80)
	ypos%=INT(0.4+(.75*Y1+1)*80)-30
	gAT stx%,sty% :gLINETO xpos%,ypos%
	N&=1 :REM initialise lng int var
	DO
		M&=N&
		WHILE (M&-INT(M&/2)*2)=0
			M&=INT(M&/2)
		ENDWH
		IF (M&-INT(M&/4)*4)=1
			D%=1
		ELSE
			D%=-1
		ENDIF
		S%=((S%+D%)-INT((S%+D%)/4)*4)
		F=(S%-P/2)*PI/2
		X2=X1+H*COS(F) :Y2=Y1+H*SIN(F)
		XA=(3*X1+X2)/4 :YA=(3*Y1+Y2)/4
		XB=(X1+3*X2)/4 :YB=(Y1+3*Y2)/4
		xpos%=INT(0.4+(XA+1)*80)
		ypos%=INT(0.4+(YA+1)*80)-30
		gLINETO xpos%,ypos%
		xpos%=INT(0.4+(XB+1)*80)
		ypos%=INT(0.4+(YB+1)*80)-30
		gLINETO xpos%,ypos%
		X1=X2 :Y1=Y2
		N&=N&+1
	UNTIL N&>=2**P-1
	GET
ENDP

PROC mod: (a,b)
	RETURN a-INT(a/b)*b
ENDP
