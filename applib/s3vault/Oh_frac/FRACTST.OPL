PROC main:
	LOCAL xres%,yres%,i%,j%,k%
	xres%=90 :yres%=90
	i%=-xres%
	gCLS
	gUPDATE OFF
	BUSY "Fractating",2
	Mandel: (xres%,yres%,i%)
	BUSY OFF
	gUPDATE ON
	GET
ENDP


PROC Mandel: (xres%,yres%,ti%)
	LOCAL A,B,U,V,X,Y,W,rt,k%,j%,i%
	REM screen size (2*xres+1)(2*yres+1)
	i%=ti%
	DO
		A=(-0.55)+1.65*i%/(xres%)
		j%=0
		DO
			B=1.4*j%/(yres%)
			U=4*(A*A+B*B)
			V=U-2*A+1/4
			rt=SQR(ABS(V))
			IF (U+8*A+20/4)<0
				k%=1
			ELSEIF (V-rt+2*A-1/2)<0
				k%=1
			ELSE
				X=A :Y=B
				k%=1 :REM Init k% for iteration steps
				DO
					U=X*X :V=Y*Y :W=2*X*Y
					X=U-V+A :Y=W+B
					IF (U+V)>16
						GOTO LBL::
					ENDIF
					k%=k%+1 :REM incr k%
				UNTIL k%>20 :REM 15 is max no. of iterations.
				LBL::
			ENDIF
			k%=k%-INT(k%/2)*2 :REM =k%MOD2
			gGMODE k%
			gAT 120+i%,40+j%
			gLINEBY 0,0
			gAT 120+i%,40-j%
			gLINEBY 0,0
			REM PRINT A,B
			gGMODE 0
			
			k%=0
			j%=j%+1 :REM incr j
		UNTIL j%>yres%
		i%=i%+1 :REM incr i
	UNTIL i%>xres%
ENDP
