PROC MIRA:
	LOCAL A,B,C,U,W,X,Y,Z,N%,P%,xp%,yp%
	REM **Orbits of Mia's system**
	A=.7 :B=.9998 :P%=12000 :C=2-2*A
	X=0 :Y=12.1 :REM starting point
	W=A*X+C*X*X/(1+X*X) :N%=0
	DO
		IF N%>100
			xp%=INT(3*(20+X)+20) :yp%=INT(3*(15+Y)-4)
			gAT xp%,yp% :gLINEBY 0,0
		ENDIF
		Z=X :X=B*Y+W :U=X*X
		W=A*X+C*U/(1+U) :Y=W-Z
		N%=N%+1
	UNTIL N%>=P%
	BEEP 5,300
	GET
ENDP
