REM Source file - DIR1.OPL

REM An example of how to use the
REM supplied directory scanner for
REM a simple directory listing.

REM Written by Jezar at Psion, for
REM The 1994 Psion Developers Conference



PROC dirlist:
	LOADM "DIRSCAN"
	DSscan:("\","dprint")
	UNLOADM "DIRSCAN"
	GET
ENDP


PROC dprint%:(fname$)
	PRINT fname$
ENDP


REM End of file

