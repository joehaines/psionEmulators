REM Source file - DODGY.OPL

REM An OPL "hack", demonstrating how
REM to dynamically replace the 
REM procedures in your main program.
REM This may not work on future
REM machines.

REM Written by Jezar at Psion, for
REM The 1994 Psion Developers Conference


PROC main:
	MLoad:("DODGYMOD")
	message:
	GET
ENDP

PROC message:
	PRINT "This will not be displayed."
ENDP

PROC MLoad:(name$)
	LOADM name$
	UNLOADM "DODGY"
	LOADM "DODGY"
ENDP


REM End of file

