REM Source file - EVENTS1.OPL

REM A simple timer, to show how the
REM supplied Event Manager works.

REM Written by Jezar at Psion, for
REM The 1994 Psion Developers Conference



PROC Start:
	Prelude:
	EMmake:("EMinit")
ENDP


PROC Prelude:
	TRAP CACHE $0800,$FFFF
	CACHE OFF
	LOADM "EVENTMAN"
	PRINT "Single timer demo of the Event Manager"
ENDP


PROC EMinit:
	TIinit%:("TIbeep",20,1000)
ENDP


PROC Check:(err%,accept%)
	IF err%<0 AND err%<>accept%
		RAISE err%
	ENDIF
ENDP


PROC TIinit%:(func$,delay%,data%)
	LOCAL me%,err%
	
	me%=EMadd%:(func$,0)
	Check:(IOOPEN(EMhand%(me%),"TIM:",-1),0)
	EMuser1&(me%)=delay%
	EMuser2&(me%)=data%
	TIque:(me%)
	RETURN me%
ENDP


PROC TIque:(me%)
	IOC(EMhand%(me%),1,EMstat%(me%),EMuser1&(me%))
ENDP


PROC TIbeep%:(me%)
	Check:(EMstat%(me%),0)
	BEEP -2,512000/EMuser2&(me%)
	TIque:(me%)
ENDP


REM End of file.

