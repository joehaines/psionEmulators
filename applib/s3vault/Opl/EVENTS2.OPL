REM Source file - EVENTS2.OPL

REM Like Events1.OPL, but we add another
REM timer, plus a timed gIPRINT

REM Written by Jezar at Psion, for
REM The 1994 Psion Developers Conference



PROC Start:
	Prelude:
	EMmake:("EMinit")
ENDP


PROC Prelude:
	TRAP CACHE $0800,$FFFF
	CACHE OFF
	LOADM "EVENTMAN"
	PRINT "Three timer demo with gIPRINT"
ENDP


PROC EMinit:
	TIinit%:("TIbeep",20,1000)
	TIinit%:("TIbeep",8,2000)
	TIinit%:("TIinfo",50,0)
ENDP


PROC Check:(err%,accept%)
	IF err%<0 AND err%<>accept%
		RAISE err%
	ENDIF
ENDP


PROC TIinit%:(func$,delay%,data%)
	LOCAL me%,err%
	
	me%=EMadd%:(func$,0)
	Check:(IOOPEN(EMhand%(me%),"TIM:",-1),0)
	EMuser1&(me%)=delay%
	EMuser2&(me%)=data%
	TIque:(me%)
	RETURN me%
ENDP


PROC TIque:(me%)
	IOC(EMhand%(me%),1,EMstat%(me%),EMuser1&(me%))
ENDP


PROC TIbeep%:(me%)
	Check:(EMstat%(me%),0)
	BEEP -2,512000/EMuser2&(me%)
	TIque:(me%)
ENDP


PROC TIinfo%:(me%)
	Check:(EMstat%(me%),0)
	gIPRINT "A timed gIPRINT"
	TIque:(me%)
ENDP


REM End of file.

