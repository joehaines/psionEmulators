PROC pathcurv:
local x1,x2,x3,x4,y1%,y2%,l,m,n,w,k%,s$(1),limit
dinit "Path Curves v1.1"
dtext "","This little toy is freeware and carries no copyright",2
dTEXT "","but you use it entirely at your own risk.",2
dTEXT "","I accept no responsibility for your machine,",2
dTEXT "","software, data or sanity!",2

dbuttons "Cancel",%c,"Continue",13
k%=dialog
IF k%=%c
GOTO end2
ENDIF
begin::gCLS
dinit "Path Curve"
dfloat l,"Top ratio=",1.2,10
dfloat m,"Bottom ratio",1.1,10
dfloat w,"Width",25,240
dfloat limit,"Number of Lines",1000,30000
dbuttons "Press when ready",13
k%=dialog
n=log(m)/log(l)
print "lamda=",FIX$(n,3,5)
DO
	x1=w
	x2=w
	x3=w
	x4=w
	y1%=1
	y2%=159

	while x1<limit and x3<limit

		gat x1+240,y1%
		glineto x2+240,y2%
		gat -x1+240,y1%
		glineto -x2+240,y2%

		gat x3+240,y1%
		glineto x4+240,y2%
		gat -x3+240,y1%
		glineto -x4+240,y2%

		x1=x1*l
		x2=x2/m
		x3=x3/l
		x4=x4*m
	endwh
	w=w/1.5
UNTIL w<25
pause 0
dinit "Repeat?"
dbuttons "No",%N,"Yes",%Y
k%=dialog
IF k%=%y
GOTO begin
ELSEIF k%=%y
GOTO end
ENDIF
end::
dINIT "Projective Geometry"
dTEXT "","If you wish to know more about these beautiful curves see"
dTEXT "","'Projective Geometry' by Olive Whicher; Floris Books.",$100
dTEXT ""," "
dTEXT "","Nigel Lumsden, lumsden@cix.compulink.co.uk"
k%=DIALOG
end2::
ENDP
