PROC oprat:
	LOCAL p%
	DO
		dINIT
		dTEXT "","SOME   HINTS   FOR   USING",$102
		dTEXT "","JOURNEY    PROGRAMME",$302
		dTEXT "","Prepare  for  Journey",$402
		dTEXT "","Start  the  Journey",$402
		dTEXT "","While  Running",$402
		dTEXT "","End  the  Journey",$402
		dTEXT "","Analyse  the  Journey",$402
		p%=DIALOG
			IF p%=3
		dINIT
		dTEXT "","SET   UP   INSTRUCTIONS",$302
		dTEXT "Check  if  Route  already  exists","Psion G",$101
		dTEXT "Add  departure  times  for  Stopping  stations","Psion T",$101
		dTEXT "","(missing  arrival  times  and",2
		dTEXT "","times  at  non-stopping  stations",2
		dTEXT "","will  be  calculated  for  you)",2
		dTEXT "","MUST  enter  Departure  time  for  last  station",0
		dTEXT "","MUST  give  different  numbers  to  alternative  tables",0
		dTEXT "","MUST  NOT  have  more  than  20  stations",0
		DIALOG
			ELSEIF p%=4
		dINIT
		dTEXT "","STARTING   THE   JOURNEY",$302
		dTEXT "MUST  'Select'  timetable  before  you   can  'Run'  it","Psion S",$101
		dTEXT "'Run'  checks  timetable  before  you  press  'Start'","Psion R",$101
		dTEXT "","(abandon  wrong  table  with  ESC  key",2
		dTEXT "","and  use  'Run'  and/or  'Select'  again)",2
		DIALOG
			ELSEIF p%=5
		dINIT
		dTEXT "","WHILE   RUNNING",$302
		dTEXT "","To  switch  between  alternative  screens",$102
		dTEXT "If  in  'Speed'  or  'Timing'  screen","ESC",$101
		dTEXT "If  in  'Info'  screen --- highlight  choice  and","ENTER",$101
		dTEXT "Milepost  recording  and  'Speedo'  are  on","SPEED",$101
		dTEXT "","You  CAN  record  ¬ mileposts",2
		DIALOG
			ELSEIF p%=6
		dINIT
		dTEXT "","ENDING   THE   JOURNEY",$102
		dTEXT "","Arrival  at  terminus  disables  all  running  screens",$302
		dTEXT "To  End  programme","ESC",$101
		dTEXT "","     ONCE --- can  return  if  pressed  in  error",0
		dTEXT "","     TWICE --- shows  time  late  on  arrival",0
		dTEXT "     then  ENTER  returns  to","Title",$101
		dTEXT "Can  exit  programme  from  Title  screen  by","Q",$101
		dTEXT "Can  exit  programme  from  Menu  screen  by","Psion Q",$101
		DIALOG
			ELSEIF p%=7
		dINIT
		dTEXT "","EXAMINIG   JOURNEY   RECORDS",$102
		dTEXT "","'Maximum  mins  late'  alters  scaling  of  chart",$302
		dTEXT "","Use  WHOLE  mintes  for  scaling",2
		dTEXT "To  interrogate  for  other  speeds","ENTER",$101
		dTEXT "To  return  to  Title  screen","ESC",$101
		DIALOG
			ELSEIF p%=0
				RETURN
			ENDIF
	UNTIL p%=0
ENDP
