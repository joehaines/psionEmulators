proc gentabs:

REM *** Generate A-law tables in assembler/OPL ***

local asm&(70)
local n%,t%,d%


	do
		n% = (t% and (not $55)) or ((not t%) and $55)
		d%=t% and $f
		if (t% and $70)=0
			d%=d%*2+1
		else
			d%=(d% or $10)*(2**((t% and $70)/16))
		endif
		if t% and $80
			d%=-d%
		endif
		t%=t%+1
		et%(n%+1)=d%
	until t%>255

	Asm&(1)=&FB8B0117
	Asm&(2)=&C681F38B
	Asm&(3)=&00BB2000
	Asm&(4)=&0055BD00
	Asm&(5)=&E081C38B
