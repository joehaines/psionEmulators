TYPEFACE pica
    NAME        "Pica"
    TYPE        COURIER
    TRANSLATE   translate_mono
    FONT
        HEIGHT          160
        WIDTH           7
        COMMAND         "<27>p<0><27>P<27><15><27>W<0>"  ! pica_cond
    FONT
        HEIGHT          240
        WIDTH           12
        COMMAND         "<27>p<0><27>P<27><18><27>W<0>"  ! pica
    FONT
        HEIGHT          280
        WIDTH           14
        COMMAND         "<27>p<0><27>P<27><15><27>W<1>"  ! pica_cond_enlg
    FONT
        HEIGHT          320
        WIDTH           24
        COMMAND         "<27>p<0><27>P<27><18><27>W<1>"  ! pica_enlg
    END_FONT
END_TYPEFACE

TYPEFACE elite
    NAME        "Elite"
    TYPE        ELITE
    TRANSLATE   translate_mono
    FONT
        HEIGHT          200
        WIDTH           10
           COMMAND      "<27>p<0><27>M<27><18><27>W<0>"  ! elite
    FONT
        HEIGHT          300
        WIDTH           20
        COMMAND         "<27>p<0><27>M<27><18><27>W<1>"  ! elite_enlg
    END_FONT
END_TYPEFACE

TYPEFACE proportional
    NAME        "Proportional"
    PROPORTIONAL
    SERIF
    TYPE        TIMES_ROMAN
    TRANSLATE   translate_proportional
    FONT
        HEIGHT          240
        WIDTH           prop
        COMMAND         "<27>p<1>"  ! proportional
    END_FONT
END_TYPEFACE

MODEL
    NAME        "Epson FX-80";
    MIN_X       12  ! 12 twips = 1/120 in
    MIN_Y       20  ! 20 twips = 1/72 in
    SKIP_X      0
    SKIP_Y      0
    TYPEFACE    pica,elite,prop
END_MODEL
