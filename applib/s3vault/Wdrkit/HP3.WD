! HP3.WD
! Printer driver file for HP laser printers

COMMANDS commands
    HP_PCL_COMPATIBLE
    RESET               "<27>E"
    FORM_LENGTH         "<27>&l%dP"
!<27>&l
! 0o - Portrait
! 0e - top margin to zero
! 0C - VMI to zero
!<27>9 - clear horizontal margins
!<27>(12U - code page 850 character set
    PREAMBLE            "<27>&l0o0e0C<27>9<27>(12U"
    POSTAMBLE           "<27>E"
    BOLD_ON             "<27>(s3B"
    BOLD_OFF            "<27>(s0B"
    ITALIC_ON           "<27>(s1S"
    ITALIC_OFF          "<27>(s0S"
    UNDERLINE_ON        "<27>&d0D"
    UNDERLINE_OFF       "<27>&d@"
    SUPERSCRIPT_ON      "<27>&a-60V"
    SUPERSCRIPT_OFF     "<27>&a+60V"
    SUBSCRIPT_ON        "<27>&a+60V"
    SUBSCRIPT_OFF       "<27>&a-60V"
    NEW_PAGE            "<12>"
    CARRIAGE_RETURN     "<13>"
    MOVE_DOWN           "<27>&a+%dV"
    MOVE_RIGHT_PREFIX   ""
    MOVE_RIGHT          "<27>*p+%dX"
    MOVE_RIGHT_SUFFIX   ""
    LANDSCAPE           "<27>&l1o0E<27>9"
END_COMMANDS

TRANSLATES telephone
    5:35  ! must ensure width of 5 = width of 35
END_TRANSLATES

