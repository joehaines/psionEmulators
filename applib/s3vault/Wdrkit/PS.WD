TYPEFACE courier
    NAME        "Courier"
    PROPORTIONAL
    SCALED
    SERIF
    TYPE        COURIER
    TRANSLATE   telephone
    FONT
        HEIGHT              80    ! min font height 80 twips = 4 point
        HEIGHT_MAX          1000  ! max font height 1000 twips ( = 50 point)
        HEIGHT_DELTA        20    ! delta font height 20 twips = 1 point
        WIDTH               courier_std	! necessary since scaled mono fonts not supported
        COMMAND             "0 %d F "
    END_FONT
END_TYPEFACE

TYPEFACE helvetica
    NAME        "Helvetica"
    PROPORTIONAL
    SCALED
    TYPE        HELVETICA
    TRANSLATE   telephone
    FONT
        HEIGHT              80    ! min font height 80 twips = 4 point
        HEIGHT_MAX          1000  ! max font height 1000 twips ( = 50 point)
        HEIGHT_DELTA        20    ! delta font height 20 twips = 1 point
        WIDTH               helvetica_std
        WIDTH_BOLD          helvetica_bold
        WIDTH_ITALIC        helvetica_std
        WIDTH_BOLD_ITALIC   helvetica_bold
        COMMAND             "8 %d F "
    END_FONT
END_TYPEFACE

TYPEFACE times_roman
    NAME        "Times Roman"
    PROPORTIONAL
    SCALED
    SERIF
    TYPE        TIMES_ROMAN
    TRANSLATE   telephone
    FONT
        HEIGHT              80    ! min font height 80 twips = 4 point
        HEIGHT_MAX          1000  ! max font height 1000 twips ( = 50 point)
        HEIGHT_DELTA        20    ! delta font height 20 twips = 1 point
        WIDTH               times_roman_std
        WIDTH_BOLD          times_roman_bold
        WIDTH_ITALIC        times_roman_italic
        WIDTH_BOLD_ITALIC   times_roman_bold_italic
        COMMAND             "24 %d F "
    END_FONT
END_TYPEFACE

TYPEFACE symbol
    NAME        "Symbol"
    PROPORTIONAL
    SCALED
    TYPE        SYMBOL
    TRANSLATE   telephone
    FONT
        HEIGHT              80    ! min font height 80 twips = 4 point
        HEIGHT_MAX          1000  ! max font height 1000 twips ( = 50 point)
        HEIGHT_DELTA        20    ! delta font height 20 twips = 1 point
        WIDTH               symbol_std
        COMMAND             "56 %d F "
    END_FONT
END_TYPEFACE

MODEL
    NAME        "Postscript"
    LANDSCAPE_AVAILABLE
    MIN_X       4   ! twips
    MIN_Y       4   ! twips
    SKIP_X      0
    SKIP_Y      0
    TYPEFACE    courier,times_roman,helvetica,symbol
END_MODEL
