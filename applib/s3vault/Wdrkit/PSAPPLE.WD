MODEL
    NAME        "Apple Laserwriter"
    LANDSCAPE_AVAILABLE
    MIN_X       4   ! twips
    MIN_Y       4   ! twips
    SKIP_X      0
    SKIP_Y      0
    TYPEFACE    courier,helvetica,avant_garde,helv_narrow,bookman,times_roman,new_century_schlbk,palatino,zapf_chancery,symbol,zapf_dingbats
END_MODEL
