TYPEFACE courier
    NAME        "Courier"
    PROPORTIONAL
    SCALED
    SERIF
    TYPE        COURIER
    TRANSLATE   telephone
    FONT
        HEIGHT              80    ! min font height 80 twips = 4 point
        HEIGHT_MAX          1000  ! max font height 1000 twips ( = 50 point)
        HEIGHT_DELTA        20    ! delta font height 20 twips = 1 point
        WIDTH               courier_std	! necessary since scaled mono fonts not supported
        COMMAND             "0 %d F "
    END_FONT
END_TYPEFACE

TYPEFACE helvetica
    NAME        "Helvetica"
    PROPORTIONAL
    SCALED
    TYPE        HELVETICA
    TRANSLATE   telephone
    FONT
        HEIGHT              80    ! min font height 80 twips = 4 point
        HEIGHT_MAX          1000  ! max font height 1000 twips ( = 50 point)
        HEIGHT_DELTA        20    ! delta font height 20 twips = 1 point
		WIDTH_SCALE         1
        WIDTH               helvetica_std
        WIDTH_BOLD          helvetica_bold
        WIDTH_ITALIC        helvetica_std
        WIDTH_BOLD_ITALIC   helvetica_bold
        COMMAND             "8 %d F "
    END_FONT
END_TYPEFACE

