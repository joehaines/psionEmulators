! PSAPPLE.WD
! Printer driver file for Apple Laserwriter Postscript printers

COMMANDS
	USE_DYL
    RESET               ""
    FORM_LENGTH         ""
    PREAMBLE            "%d PR"
    POSTAMBLE           "<13>PS<13>"
	BOLD_ON             "%d S " ! bold and italic style control
    BOLD_OFF            ""
    ITALIC_ON           "("    ! show text prefix
    ITALIC_OFF          ") P " ! show text suffix
    UNDERLINE_ON        "U "
    UNDERLINE_OFF       "V "
    SUBSCRIPT_ON        "BD "
    SUBSCRIPT_OFF       "BU "
    SUPERSCRIPT_ON      "BU "
    SUPERSCRIPT_OFF     "BD "
    MOVE_DOWN           "%d D "
    MOVE_RIGHT_PREFIX   ""
    MOVE_RIGHT          "%d R "
    MOVE_RIGHT_SUFFIX   ""
    NEW_PAGE            "<13>NP "
    CARRIAGE_RETURN     "<13>%d %d M " ! move
    LANDSCAPE           ""
END_COMMANDS

TRANSLATES telephone
    5:35
END_TRANSLATES

