        DispRecs%(24)
        LastRec%
        CurrentRec%
        WindowID%
        XPos%
        YPos%
        Width%
        Height%
        ScrollX%
        ScrollY%
        ScrollWidth%
        ScrollHeight%
        Font%
        MaxItems%
        Stat%
ENDS
#endif
