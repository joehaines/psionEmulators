{
  "name": "psion-emulator-desktop",
  "productName": "Psion Emulator",
  "version": "1.0.0",
  "private": true,
  "description": "Native desktop shell for the Psion emulator",
  "author": "Joe Haines <joehaines@gmail.com>",
  "license": "LicenseRef-PsionWebEmulator",
  "main": "build/main/main/main.js",
  "desktopName": "psion-emulator-desktop.desktop",
  "scripts": {
    "build:tsc": "tsc -p tsconfig.json",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=build/main/preload/preload.js",
    "build:main": "npm run build:tsc && npm run build:preload",
    "dev": "electron . --dev --framed",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis zip",
    "test:capabilities": "node test/capabilities.mjs",
    "test:window": "node test/window.spec.mjs",
    "test:saves": "node test/saves.spec.mjs",
    "test:packaged": "electron-builder --dir && node test/packaged.spec.mjs",
    "test:aspect": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON test/aspect.test.mts",
    "test:hostfs": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON test/hostfs.test.mts",
    "test:offline": "node --experimental-strip-types --no-warnings=MODULE_TYPELESS_PACKAGE_JSON test/offline.test.mts",
    "test": "npm run test:aspect && npm run test:hostfs && npm run test:offline && npm run test:capabilities && npm run test:window && npm run test:saves"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.3"
  },
  "repository": "https://github.com/joehaines/psion"
}
