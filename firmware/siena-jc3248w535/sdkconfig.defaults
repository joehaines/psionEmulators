# Guition JC3248W535: ESP32-S3 N16R8 (16 MB QIO flash, 8 MB octal PSRAM).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Everything for speed: the V30 interpreter is the whole workload.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# The Siena's 512 KiB RAM and 1 MiB ROM live in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The emulator task keeps core 1 busy when the Siena is.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Logs and terminal typing over the board's USB-C (native USB Serial/JTAG).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth LE keyboard host.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
# Bluedroid's buffers go to PSRAM, leaving internal RAM for the interpreter.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# Wi-Fi (Google sync), squeezed into what internal RAM Bluetooth and the
# interpreter leave: buffers in PSRAM, the stack's code in flash, TLS
# allocations in PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
# Bluetooth sized for one keyboard: a GATT client, one connection.
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_SMP_MAX_BONDS=8
# Tasks that never write flash may keep their stacks in PSRAM.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# Code out of IRAM, for the internal RAM Wi-Fi and Bluetooth need: the BLE
# controller, the heap and FreeRTOS run from flash.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_FREERTOS_IN_IRAM=n
