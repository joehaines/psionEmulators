	@$(NORMAL_UNINSTALL)
	@list='$(glade_DATA)'; for p in $$list; do \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f '$(DESTDIR)$(gladedir)/$$f'"; \
	  rm -f "$(DESTDIR)$(gladedir)/$$f"; \
	done
