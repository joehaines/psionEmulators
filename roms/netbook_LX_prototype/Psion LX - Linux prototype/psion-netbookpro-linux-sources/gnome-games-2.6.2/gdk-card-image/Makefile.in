	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f '$(DESTDIR)$(cardrankdir)/$$f'"; \
	  rm -f "$(DESTDIR)$(cardrankdir)/$$f"; \
	done
