	uninstall-cardsuitlargeDATA uninstall-cardsuitmediumDATA \
	uninstall-cardsuitsmallDATA uninstall-info-am \
	uninstall-libLTLIBRARIES \
	uninstall-libgdkcardimageincludeHEADERS

