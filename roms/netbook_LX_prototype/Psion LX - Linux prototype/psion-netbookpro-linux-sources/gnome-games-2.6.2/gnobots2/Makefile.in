	@$(NORMAL_UNINSTALL)
	@list='$(Games_DATA)'; for p in $$list; do \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f '$(DESTDIR)$(Gamesdir)/$$f'"; \
	  rm -f "$(DESTDIR)$(Gamesdir)/$$f"; \
	done
