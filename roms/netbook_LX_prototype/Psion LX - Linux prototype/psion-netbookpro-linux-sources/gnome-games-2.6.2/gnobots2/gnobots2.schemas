      </locale>

      <locale name="uk">
        <short>Колір тла</short>
        <long>Колір тла. Шістнадцяткове визначення кольру тла.</long>
      </locale>

      <locale name="wa">
        <short>Coleur do fond</short>
        
      </locale>

      <locale name="zh_CN">
        <short>背景颜色</short>
        
      </locale>

      <locale name="zh_TW">
        <short>背景顏色</short>
        
      </locale>
      </schema>

      <schema>
