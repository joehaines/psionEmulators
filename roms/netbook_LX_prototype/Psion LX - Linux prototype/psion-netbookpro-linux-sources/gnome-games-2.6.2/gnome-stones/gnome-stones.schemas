<gconfschemafile>

  <schemalist>
      <schema>
      <key>/schemas/apps/gnome-stones/preferences/scroll_method</key>
      <applyto>/apps/gnome-stones/preferences/scroll_method</applyto>
      <owner>gnome-stones</owner>
      <type>string</type>
      <default>atari_scroll</default>
      <locale name="C">
        <short>Scroll method</short>
        <long>The scroll method, valid values are "atari_scroll", "smooth_scroll" and "center_scroll".</long>
      </locale>

      <locale name="ar">
        <short>أسلوب اللف</short>
        <long>طريقة اللف، القيم الممكنة هي &quot;لف_أتاري&quot; و &quot;لف_ناعم&quot; و &quot;لف_موسط&quot;.</long>
      </locale>

      <locale name="az">
        <short>Sürüşmə yöntəmi</short>
        <long>Sürüşmə növü, mövcud qiymətlər &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; və&quot;center_scroll&quot;dur.</long>
      </locale>

      <locale name="be">
        <short>Спосаб пракруткі</short>
        
      </locale>

      <locale name="bg">
        <short>Метод за местене на екрана</short>
        <long>Метод за местене на екрана, валидни стойност са &quot;Стил Атари&quot;, &quot;Плавно&quot; и &quot;Централно&quot;.</long>
      </locale>

      <locale name="bn">
        <short>গুটিয়ে নেয়ার পদ্ধতি</short>
        <long>স্ক্রল পদ্ধতি, বৈধ মানগুলো হল &quot;আটারি_স্ক্রল&quot;, &quot;মসৃণ_স্ক্রল&quot; এবং &quot;কেন্দ্রীয়_স্ক্রল&quot;।</long>
      </locale>

      <locale name="ca">
        <short>Mètode de desplaçament</short>
        
      </locale>

      <locale name="cs">
        <short>Metoda posunování</short>
        <long>Metoda posunování, platné hodnoty jsou &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; a &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="cy">
        <short>Dull sgrolio</short>
        <long>Y dull sgrolio. Gwerthoedd dilys: &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; a &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="da">
        <short>Rullemetode</short>
        <long>Rullemetoden, mulige værdier er &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; og &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="de">
        <short>Rollmethode</short>
        <long>Die Rollmethode. Zulässige Werte: »atari_scoll«, »smooth_scroll« sowie »center_scroll«.</long>
      </locale>

      <locale name="el">
        <short>Μέθοδος κύλισης</short>
        <long>Η μέθοδος κύλισης, οι έγκυρες τιμές είναι  &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; και &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="en_CA">
        <short>Scroll method</short>
        <long>The scroll method, valid values are &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; and &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="en_GB">
        <short>Scroll method</short>
        <long>The scroll method, valid values are &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; and &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="es">
        <short>Método de desplazamiento</short>
        <long>El método de desplazamiento. Los valores válidos son: «atari_scroll», «smooth_scroll» y «center_scroll».</long>
      </locale>

      <locale name="fi">
        <short>Vierittämistapa</short>
        <long>Vieritystapa, sallittuja arvoja ovat &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; ja &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="fr">
        <short>Méthode de défilement</short>
        <long>La méthode de défilement, les valeurs valides sont « atari_scroll », « smooth_scroll » et « center_scroll ».</long>
      </locale>

      <locale name="gu">
        <short>ખસેડવાની રીત</short>
        <long>ખસેડવાની પધ્ધત્, યોગ્ય કિંમતો &quot;અટારી_ખસેડવું&quot;,&quot;સરળ_ખસેડવું&quot;,&quot;કેન્દ્રિત_ખસેડવું&quot; છે.</long>
      </locale>

      <locale name="he">
        <short>שיטת גלילה</short>
        <long>שיטת הגלילה, ערכים תקינים הם &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; וגם &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="hi">
        <short>स्क्रोल विधि</short>
        <long>स्क्रॉल का ढंग, मान्य मूल्य हैं &quot;अटारी_स्क्रॉल&quot;, &quot;निर्विध्न_स्क्रॉल&quot; और &quot;केंद्र_स्क्रॉल&quot;. (_s)</long>
      </locale>

      <locale name="hr">
        <short>Način klizanja</short>
        <long>Način klizanja, moguće vrijednosti su &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; i &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="hu">
        <short>Görgetési módszer</short>
        <long>A scrollozási mód, érvényes értékek: &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; és &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="it">
        <short>Metodo di scorrimento</short>
        <long>Il metodo di scorrimento, i valori ammessi sono &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; e &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="ja">
        <short>画面スクロール</short>
        <long>画面のスクロール形式で、利用可能な値は &quot;atari_scroll&quot;、&quot;smooth_scroll&quot;、&quot;center_scroll&quot; です。</long>
      </locale>

      <locale name="ko">
        <short>스크롤 방법</short>
        <long>스크롤 방법, 사용할 수 있는 값은 &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; 그리고 &quot;center_scroll&quot;입니다.</long>
      </locale>

      <locale name="lt">
        <short>Persukimo metodas</short>
        <long>Persukimo metodas, galimos reikšmės &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; ir &quot;center_scroll&quot;.</long>
