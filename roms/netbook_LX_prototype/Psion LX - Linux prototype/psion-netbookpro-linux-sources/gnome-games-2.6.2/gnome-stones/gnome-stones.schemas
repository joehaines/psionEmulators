      <schema>
      <key>/schemas/apps/gnome-stones/preferences/joystick_switch_level</key>
      <applyto>/apps/gnome-stones/preferences/joystick_switch_level</applyto>
      <owner>gnome-stones</owner>
      <type>float</type>
      <default>0.5</default>
      <locale name="C">
        <short>Joystick switch level</short>
        <long>The level an analog joystick must reach to be considered "on" when emulating a digital joystick. This takes a value between 0.0 and 1.0.</long>
      </locale>

      <locale name="ar">
        <short>مستوى تحويل الجويْستك</short>
        <long>المستوى الذي يجب أن يصل إليه قضيب التوجيه التناظري لإعتباره &quot;مفعّلا&quot; عند محاكات قضيب توجيه رقمي. يتطلّب هذا قيمة بين 0.0 و 1.0.</long>
      </locale>

      <locale name="az">
        <short>Coystik dəyişmə yöntəmi</short>
        <long>Dijital coystik emulyasiyası zamanında analoq coystikin &quot;fəal&quot; sayılması üçün yetişməsi məcburi olan səviyyə. Bu qiymət 0.0 ilə 1.0 arasında olmalıdır.</long>
      </locale>

      <locale name="bg">
        <short>Ново на превключване на джойстик</short>
        <long>Нивото, което трябва да достигне аналогов джойстик за да се счита за &quot;Вкл.&quot; при емулация на цифров джойстик. Приема стойности от 0.0 до 1.0</long>
      </locale>

      <locale name="bn">
        <short>জয়স্টিক পরিবর্তন স্তর</short>
        <long>একটি অ্যানালগ জয়স্টিক কর্তৃক ডিজিটাল জয়স্টিক অনুকরণের সময় &quot;সক্রিয়&quot; বিবেচিত হওয়ার জন্য যে স্তরে পৌঁছতে হবে। এজন্য ০.০ থেকে ১.০ এর মধ্যবর্তী একটি মান প্রয়োজন।</long>
      </locale>

      <locale name="cs">
        <short>Úroveň přepnutí joysticku</short>
        <long>Úroveň, kterou musí analogový joystick dosáhnout, aby byl považován za &quot;zapnuto&quot; při emulaci digitálního joysticku. Přijímány jsou hodnoty mezi 0.0 a 1.0.</long>
      </locale>

      <locale name="cy">
        <short>Lefel swits ffon rheoli</short>
        <long>Y lefel mae&apos;n rhaid i ffon rheoli analog ei gyrraedd er mwyn cael ei gysudro &quot;ymlaen&quot; wrth efelychu ffon rheoli digidol. Mae&apos;r gwerth rhwng 0.0 a 1.0.</long>
      </locale>

      <locale name="da">
        <short>Joystick-skifteniveau</short>
        <long>Det niveau som et analogt joystick skal nå for at blive opfattet som &quot;tændt&quot; ved emulering af et digitalt joystick. Dette er en værdi mellem 0,0 og 1,0.</long>
      </locale>

      <locale name="de">
        <short>Joystick-Umschaltschwellwert</short>
        <long>Der Ausschlagsschwellwert, den ein analoger Joystick erreichen muss, um bei der Emulation eines digitalen Joysticks als »an« registriert zu werden. Zulässige Werte: 0.0-1.0.</long>
      </locale>

      <locale name="el">
        <short>Επίπεδο αλλαγής χειριστηρίου</short>
        <long>Το επίπεδο του χειριστηρίου θα πρέπει να θεωρείται &quot;on&quot; όταν προσομοιώνει ένα ψηφιακό χειριστήριο. Αυτό πάιρνει μια τιμή ανάμεσα στο  0.0 και 1.0.</long>
      </locale>

      <locale name="en_CA">
        <short>Joystick switch level</short>
        <long>The level an analog joystick must reach to be considered &quot;on&quot; when emulating a digital joystick. This takes a value between 0.0 and 1.0.</long>
      </locale>

      <locale name="en_GB">
        <short>Joystick switch level</short>
        <long>The level an analogue joystick must reach to be considered &quot;on&quot; when emulating a digital joystick. This takes a value between 0.0 and 1.0.</long>
      </locale>

      <locale name="es">
        <short>Nivel de cambio de joystick</short>
        <long>El nivel que debe alcanzar un joystick analógico para que se considere «encendido» cuando se emula un joystick digital. El valor debe estar entre 0.0 y 1.0.</long>
      </locale>

      <locale name="fi">
        <short>Peliohjaimen kytkentätaso</short>
        <long>Analogisen peliohjaimen taso, mikä on saavutettava, jotta se voidaan käsittää &quot;kytketyksi&quot; kun emuloidaan digitaalista peliohjainta. Tähän hyväksytään arvot 0,0-1,0.</long>
      </locale>

      <locale name="fr">
        <short>Niveau de basculement du joystick</short>
        <long>Le niveau qu&apos;un joystick analogique doit atteindre pour être considéré comme « on » lors de l&apos;émulation de joystick numérique. C&apos;est une valeur entre 0.0 et 1.0.</long>
      </locale>

      <locale name="gu">
        <short>જાૅયસ્ટીક સ્વીચનું સ્તર</short>
        <long>અૅનાલાૅગ જાૅયસ્ટીકનું સ્તર &quot;ચાલુ&quot; ત્યારે સમજાય કે જ્યારે તે ડિજિટલ જાૅયસ્ટીકની નકલ કરે.આની કિંમત ૦.૦ અને ૧.૦ ની વચ્ચે લેવાય છે.</long>
      </locale>

      <locale name="he">
        <short>רמת החלפת מוט היגוי</short>
        <long>הרמה שמוט היגוי אנלוגי חייב להגיע אליה כדי להחשב &quot;פועל&quot; כאשר מדמים מוט היגוי דיגיטלי. זה לוקח ערך בין 0.0 ו 1.0.</long>
      </locale>

      <locale name="hi">
        <short>जॉयस्टिक बदलने का स्तर</short>
        <long>एक एनॉलॉग जाय स्टिक का स्तर  &quot;चालू&quot; में तब समझा जाता है जब वह डिजिटल जॉय स्टिक की नकल करता है. यह  0.0 से 1.0 के बीच के मूल्य लेता है.</long>
      </locale>

      <locale name="hr">
        <short>Stupanj pokretljivosti igraće palice</short>
        <long>Razina koji analogni joystick mora dosećida bi se smatrao &quot;uključenim&quot;kada oponaša digitalni joystick. Vrijednosti su između 0.0 i 1.0.</long>
      </locale>

      <locale name="it">
        <short>Livello di commutazione del joystick</short>
        <long>Il livello che un joystick analogico deve raggiungere per essere considerato &quot;on&quot; quando emula un joystick digitale. Il valore è compreso tra 0.0 e 1.0.</long>
      </locale>

      <locale name="ja">
        <short>ジョイスティックの切り替えレベル</short>
        <long>デジタル式のジョイスティックをエミュレートする際に、アナログ式ジョイスティックのレベルを &quot;ON&quot; にして下さい。指定できる値は 0.0 〜 1.0 です。</long>
      </locale>

      <locale name="ko">
        <short>조이스틱 스위치 레벨</short>
        <long>아날로그 조이스틱으로 디지탈 조이스틱을 에뮬레이션할 때 그 레벨은 &quot;on&quot; 상태에 도달할 정도로 올라가야 합니다. 0.0과 1.0 사이의 값입니다.</long>
      </locale>

      <locale name="lt">
        <short>Vairalazdės perjungimo lygis</short>
        <long>Lygis, kuri turi pasiekti analoginė vairalazdė, kad skaitmeninės vairalazdės emuliacija laikytų judesį įjungiančiu. Reikšmė yra tarp 0.0 ir 1.0.</long>
      </locale>

      <locale name="mn">
        <short>Жойстик сонгох төвшин</short>
        
      </locale>

      <locale name="ms">
        <short>Tahap peralihan kayu biduk:</short>
        
      </locale>

      <locale name="nl">
        <short>Joystick wisselniveau</short>
        <long>Het niveau dat een analoge joystick moet bereiken voordat hij als &quot;aan&quot; wordt beschouwd, bij het emuleren van een digitale joystick. Dit neemt een waarde aan tussen 0.0 en 1.0.</long>
      </locale>

      <locale name="nn">
        <short>Kjenslenivå på styrespaken</short>
        <long>Nivået ein analog styrespake må nå for å reknast som «på» når han fungerer som ein digital styrespakevert . Verdien er mellom 0.0 og 1.0.</long>
      </locale>

      <locale name="pa">
        <short>ਜਾੲਿਸਟਿੱਕ ਸਵਿੱਚ ਦਰਜਾ</short>
        <long>ਡਿਜ਼ੀਟਲ ਜਾੲਿਸਟਿੱਕ ਦਾ ਮੁਕਾਬਲਾ ਕਰਨ ਸਮੇਂ ਦਰਜਾ ਜਿਸ ੳੁੱਪਰ ਅੈਨਾਲਾਗ ਜਾੲਿਸਟਿੱਕ ਨੇ ਪਹੁੰਚਣਾ ਹੈ &quot;ਚਾਲੂ&quot; ਹੋਣਾ ਚਾਹੀਦਾ ਹੈ ੤ ੲਿਸ ਦੀ 0.0 ਅਤੇ 1.0 ਵਿਚਕਾਰ ਕੀਮਤ ਹੋਵੇਗੀ ੤</long>
      </locale>

      <locale name="pl">
        <short>Poziom przełączania joysticka</short>
        <long>Poziom wychylenia joysticka analogowego, aby je uznano przy emulacji joysticka cyfrowego. Zawiera wartości z przedziału 0.0 - 1.0.</long>
      </locale>

      <locale name="pt">
        <short>Nível de interruptor do joystick</short>
        <long>O nível que um joystick analógico tem de atingir para ser considerado &quot;ligado&quot; ao emular um joystick digital. Aceita um valor entre 0.0 e 1.0.</long>
      </locale>

      <locale name="pt_BR">
        <short>Nível de interrupção do joystick</short>
        <long>O nível que um joystick analógico precisa alcançar para estar considerado &quot;ligado&quot; quando emulando um josytick digital. Isto pega um valor de 0.0 a 1.0.</long>
      </locale>

      <locale name="ru">
        <short>Уровень переключения джойстика</short>
        <long>Уровень, которого должен достигнуть аналоговый джойстик, чтобы его поняли как &quot;нажато&quot; при эмуляции цифрового джойстика. Принимает значения от 0.0 до 1.0.</long>
      </locale>

      <locale name="sq">
        <short>Niveli i çelësit të joystick-ut</short>
        <long>Niveli që një joystick analog duhet të arrijë për tu konsideruar &quot;on&quot; që të imitojë një joystick dixhital. Ky merr një vlerë midis 0.0 dhe 1.0.</long>
      </locale>

      <locale name="sr">
        <short>Степен покретљивости џојстика</short>
        <long>Ниво који аналогни џојстик мора да достигне да би се сматрао „укљученим“ када опонаша дигитални џојстик. Ово узима вредност између 0.0 и 1.0.</long>
      </locale>

      <locale name="sr@Latn">
        <short>Stepen pokretljivosti džojstika</short>
        <long>Nivo koji analogni džojstik mora da dostigne da bi se smatrao „uključenim“ kada oponaša digitalni džojstik. Ovo uzima vrednost između 0.0 i 1.0.</long>
      </locale>

      <locale name="sv">
        <short>Styrspaksväxlingsnivå</short>
        <long>Nivån för en analog styrspak måste nå för att betraktas som &quot;på&quot; vid emulering av en digital styrspak. Detta tar ett värde mellan 0,0 och 1,0.</long>
      </locale>

      <locale name="tr">
        <short>Oyun çubuğu değişim seviyesi</short>
        <long>Sayısal oyun çubuğu benzetimi yapılırken analog oyun çubuğu zorunlu ulaşım seviyesi &quot;açık&quot; kabul edilecek. Bu 0,0 ve 1,0 arasında değer alır.</long>
      </locale>

      <locale name="uk">
        <short>рівень перемикання джойстика</short>
        <long>Рівень, якого має досягти аналоговий джойстик, щоб його стан було зрозуміло як &quot;натиснуто&quot; під час емуляції цифрового джойстика. Приймає значення від 0.0 до 1.0.</long>
      </locale>

      <locale name="zh_CN">
        <short>游戏杆开关级别</short>
        
      </locale>

      <locale name="zh_TW">
        <short>搖桿敏感度</short>
        <long>當使用類比搖桿模擬數位搖桿時，控制桿的訊號必須達到指定數值 (0.0 至 1.0 之間) 才會被視為有反應。</long>
      </locale>
      </schema>

  </schemalist>

</gconfschemafile>

