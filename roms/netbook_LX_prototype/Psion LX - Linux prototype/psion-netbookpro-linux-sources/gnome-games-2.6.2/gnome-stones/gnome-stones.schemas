      <locale name="lv">
        <short>Ritināšanas metode</short>
        
      </locale>

      <locale name="mk">
        <short>метод на лизгање</short>
        
      </locale>

      <locale name="mn">
        <short>Өнхрүүлэх арга</short>
        
      </locale>

      <locale name="ms">
        <short>Cara Skrol </short>
        
      </locale>

      <locale name="nl">
        <short>Schuifmethode</short>
        <long>De schuif-methode, geldige waarden zijn &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; en &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="nn">
        <short>Rullemetode</short>
        <long>Rullemetoden. Gyldige verdiar er «atari_scroll», «smooth_scroll» og «center_scroll».</long>
      </locale>

      <locale name="no">
        <short>Rullemetode</short>
        
      </locale>

      <locale name="pa">
        <short>ਸਕਰੌਲ ਵਿਧੀ</short>
        <long>ਸਕਰੌਲ ਵਿਧੀ, ਯੋਗ ਕੀਮਤ੾ &quot;ਅਟਾਰੀ ਸਕਰੌਲ&quot;, &quot;ਮੁਲਾੲਿਮ ਸਕਰੌਲ&quot; ਅਤੇ &quot;ਕੇਂਦਰ ਸਕਰੌਲ&quot; ੤</long>
      </locale>

      <locale name="pl">
        <short>Metoda przewijania</short>
        <long>Metoda prewijania ekranu, dopuszczalnymi wartościami są &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; i &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="pt">
        <short>Método de rolamento</short>
        <long>O método de rolamento, valores válidos são &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; e &quot;center_scroll&quot;.</long>
      </locale>

      <locale name="pt_BR">
        <short>Método de rolagem</short>
        <long>O nétodo de rolagem. Os valores válidos são &quot;atari_scroll&quot;, &quot;smooth_scroll&quot; e &quot;center_scroll&quot;.</long>
