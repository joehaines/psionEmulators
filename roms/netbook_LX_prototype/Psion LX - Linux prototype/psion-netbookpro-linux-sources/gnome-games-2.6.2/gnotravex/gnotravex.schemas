<gconfschemafile>
  <schemalist>

    <schema>
      <key>/schemas/apps/gnotravex/grid_size</key>
      <applyto>/apps/gnotravex/grid_size</applyto>
      <owner>gnotravex</owner>
      <type>int</type>
      <default>3</default>
      <locale name="C">
        <short>The size of the playing grid</short>
        <long>The value of this key is used to decide the size of the playing grid. The valid values are 2 to 8, anything else gets set to 3.</long>
      </locale>

      <locale name="ar">
        <short>حجم شبكة اللعبة</short>
        <long>قيمة هذا المفتاح مستخدمة لتحديد حجم شبكة اللعب. القيمة الممكنة هي 2 إلى 8، كل شيئ آخر يضبط آليا إلى 3.</long>
      </locale>

      <locale name="az">
        <short>Oyun qəfəsinin böyüklüyü</short>
        <long>Bu açarın qiyməti oyun taxtasının böyüklüyünü müəyyən edin. Mümkün qiymətlər 2 ilə 8 arasıdır. Bunlar xaricindəki hər şey 3 sayılacaq.</long>
      </locale>

      <locale name="bg">
        <short>Размера на игралното поле</short>
        <long>Стойността на този ключ се използва за задаване на размера на игралното поле. Валидни стойности са от 2 до 8, всички останали се възприемат като 3.</long>
      </locale>

      <locale name="bn">
        <short>খেলার ছকের আকার</short>
        <long>এই কী (Key) এর মান খেলার ছকের আকার নির্ধারণে ব্যবহৃত হয়। বৈধ মানসমূহ হল ২ থেকে ৮, এছাড়া অন্য যেকোন মান শেষ পর্যন্ত ৩ হয়ে যায়।</long>
      </locale>

      <locale name="ca">
        <short>La mida de la quadrícula de joc</short>
        
      </locale>

      <locale name="cs">
        <short>Velikost hracího pole</short>
        <long>Hodnota tohoto klíče se používá pro určení velikosti hracího pole. Platné hodnoty jsou od 2 do 8, cokoli jiného způsobí nastavení na 3.</long>
      </locale>

      <locale name="cy">
        <short>Maint y grid chwarae</short>
        <long>Defnyddir gwerth yr allwedd hwn i benderfynu maint y grid chwarae. Gwerthoedd dilys: 2 i 8, caiff unrhywbeth arall ei osod i 3.</long>
      </locale>

      <locale name="da">
        <short>Størrelsen af spillefeltet</short>
        <long>Mulige værdier er 2 til 8, alt andet bliver sat til 3.</long>
      </locale>

      <locale name="de">
        <short>Die Größe des Spielbretts</short>
        <long>Der Wert dieses Schlüssel wird verwendet, um die Größe des Spielfelds festzulegen. Zulässige Werte: 2-8, Vorgabe: 3.</long>
      </locale>

      <locale name="el">
        <short>Το μέγεθος του πλέγματος παιχνιδιού</short>
        <long>The value of this key is used to decide the size of the playing grid. The valid values are 2 to 8, anything else gets set to 3.</long>
      </locale>

      <locale name="en_CA">
        <short>The size of the playing grid</short>
        <long>The value of this key is used to decide the size of the playing grid. The valid values are 2 to 8, anything else gets set to 3.</long>
      </locale>

      <locale name="en_GB">
        <short>The size of the playing grid</short>
        <long>The value of this key is used to decide the size of the playing grid. The valid values are 2 to 8, anything else gets set to 3.</long>
      </locale>

      <locale name="es">
        <short>El tamaño de la rejilla de juego</short>
        <long>El valor de esta clave se utiliza para decidir el tamaño de la rejilla de juego. Los valores válidos están entre 2 y 8, cualquier otro valor se ajustará a 3.</long>
      </locale>

      <locale name="fi">
        <short>Pelialueen koko</short>
        <long>Tämän avaimen arvoa käytetään pelialueen koon määrittelyyn. Sallittuja arvoja ovat 2-8, muut arvot asetetaan 3:ksi.</long>
      </locale>

      <locale name="fr">
        <short>La taille de la grille de jeu</short>
        <long>La valeur de cette clé est utilisée pour décider de la taille de la grille de jeu. Les valeurs valides sont de 2 à 8, toute autre valeur positionne la valeur à 3.</long>
      </locale>

      <locale name="gu">
        <short>રમત માટેની જાળીનું માપ</short>
        <long>આ કી ની કિંમત રમવાની જાળીની ઊંચાઇ નક્કી કરવામાં વપરાય છે.યોગ્ય કિંમત ૨ થી ૮ છે,એના સિવાયનું કંઇપણ ૩ તરીકે ગોઠવાઇ જશે.</long>
      </locale>

      <locale name="he">
        <short>גודל רשת המשחק</short>
        <long>הערך של מפתח זה משמש להחליט את גודל רשת המשחק. הערכים התקינים הם 2 עד 8, כל דבר אחר נקבע ל 3.</long>
      </locale>

      <locale name="hi">
        <short>खेले जा रहे ग्रिड का आकार</short>
        <long>खेलने वाली जाली का आकार तय करने में इस कुंजी का मान उपयोग में आता है. मान्य मान 2 से 8 हैं, अन्य कोई भी 3 नियत हो जाता है.</long>
      </locale>

      <locale name="hr">
        <short>Broj polja za igru</short>
        <long>Vrijednost ovog parametra se koristi u odlučivanju o veličini mreže za igru. Moguće postavke su od 2 do 8, sve drugo se postavlja na 3 automatski.</long>
      </locale>

      <locale name="hu">
        <short>A játékrács mérete</short>
        
      </locale>

      <locale name="it">
        <short>La dimensione della griglia di gioco</short>
        <long>Il valore di questa chiave è usato per decidere la dimensione della griglia di gioco. I valori validi vanno da 2 a 8, qualsiasi altra cosa sarà considerata come 3.</long>
      </locale>

      <locale name="ja">
        <short>プレイするグリッドのサイズ</short>
        <long>このキーの値はプレイする盤面のサイズを決定するのに使用します。設定可能な値は 2〜8 で、それ以外は強制的に 3 になります。</long>
      </locale>

      <locale name="ko">
        <short>플레이하는 격자의 크기</short>
        <long>이 키는 플레이 격자의 크기를 결정합니다. 사용 가능한 값은 2에서 8입니다.  그 외의 값은 3과 같습니다.</long>
      </locale>

      <locale name="lt">
        <short>Žaidimo tinklelio dydis</short>
        <long>Šio rakto reikšmė lemia žaidimo tinklelio dydį. Galimos reikšmės nuo 2-ų iki 8-ų, bet kokia kita reikšmė prilyginama 3.</long>
      </locale>

      <locale name="ms">
        <short>Saiz bagi grid permainan</short>
        
      </locale>

      <locale name="nl">
        <short>De afmeting van het speelrooster</short>
        <long>De waarde van deze sleutel wordt gebruikt om de afmeting van het raster te bepalen. Geldige waarden liggen tussen 2 en 8. Elke andere waarde wordt 3.</long>
      </locale>

      <locale name="nn">
        <short>Storleiken på spelefeltet</short>
        <long>Verdiane til denne nøkkelen vert brukte til å styra storleiken på spelefeltet. Gyldige verdiar er 2 til 8. Alt anna vert retta til 3.</long>
      </locale>

      <locale name="no">
        <short>Størrelsen på spillets rutenett</short>
        
      </locale>

      <locale name="pa">
        <short>ਖੇਡਣ ਵਾਲੇ ਜੰਗਲੇ ਦਾ ਅਾਕਾਰ</short>
        <long>ੲਿਸ ਕੀ ਦੀ ਕੀਮਤ ਖੇਡ ਜੰਗਲੇ ਦਾ ਅਾਕਾਰ ਨਿਸਚਿਤ ਕਰਨ ਲੲੀ ਵਰਤੀ ਜ੾ਦੀ ਹੈ ੤ ਯੋਗ ਕੀਮਤ੾ ਹਨ 2 ਤੋਂ 8,ਹੋਰ ਸਭ ਕੁਝ 3 ਦਰਸਾ ਕੇ ਪ੍ਾਪਤ ਕੀਤਾ ਜ੾ਦਾ ਹੈ ੤</long>
      </locale>

      <locale name="pl">
        <short>Grubość linii siatki planszy</short>
        <long>Wartość tej opcji określa grubość linii siatki planszy. Poprawne wartości zawierają się w przedziale 2 - 8, wszystko inne powoduje ustawienie grubości linii na 3.</long>
      </locale>

      <locale name="pt">
        <short>O tamanho da grelha de jogo</short>
        <long>O valor desta chave é utilizado para decidir o tamanho da grelha de jogo. Os valores válidos são 2 até 8, qualquer outro valor é reposto em 3.</long>
      </locale>

      <locale name="pt_BR">
        <short>O tamanho da grade de jogo</short>
        <long>O valor desta chave é usado para decidir o tamanho da grade de jogo. Os valores válidos são de 2 a 8, qualquer outro valor é definido como 3.</long>
      </locale>

      <locale name="ru">
        <short>Размер игровой решетки</short>
        <long>Значение этого ключа используется для определения размера игровой решетки. Допустимыми значениями являются от 2 до 8, все остальные значения будут сбрасываться в 3.</long>
      </locale>

      <locale name="sq">
        <short>Madhësia e fushës së lojës</short>
        <long>Vlera e këtij çelësi përdoret për të caktuar madhësinë e fushës së lojës. Vlerat e vlefshme janë nga 2 tek 8, çdo gjë tjetër është 3.</long>
      </locale>

      <locale name="sr">
        <short>Broj поља за игру</short>
        <long>Вредност овог параметра се користи да се одлучи о величини мреже за игру. Могуће поставке су од 2 до 8, све друго се поставља на 3 аутоматски.</long>
      </locale>

      <locale name="sr@Latn">
        <short>Broj polja za igru</short>
        <long>Vrednost ovog parametra se koristi da se odluči o veličini mreže za igru. Moguće postavke su od 2 do 8, sve drugo se postavlja na 3 automatski.</long>
      </locale>

      <locale name="sv">
        <short>Storleken på spelrutnätet</short>
        <long>Värdet på denna nyckel används för att avgöra storleken på spelrutnätet. De giltiga värdena är 2 till och med 8, och allt annat ställs in till 3.</long>
      </locale>

      <locale name="tr">
        <short>Oyun ızgarasının boyutu</short>
        <long>Bu anahtarın değeri oyun ızgarasının boyutunu seçmekte kullanılacaktır. Geçerli değerler 2&apos;den 8&apos;e kadardır, bunun dışındaki değerler 3 kabul edilir.</long>
      </locale>

      <locale name="uk">
        <short>Розмір ігрового поля</short>
        <long>Значення цього ключа використовується для визначення розміру ігрового поля. Дозволеними значеннями є числа від 2 до 8, всі інші значення скидатимуться в 3.</long>
      </locale>

      <locale name="zh_TW">
        <short>遊戲方格陣列大小</short>
        <long>本數值決定方格陣列的尺寸。有效的值介乎 2 至 8 之間，其它的數值都會更改為 3。</long>
      </locale>
    </schema>

    <schema>
      <key>/schemas/apps/gnotravex/width</key>
      <applyto>/apps/gnotravex/width</applyto>
      <owner>gnotravex</owner>
      <type>int</type>
      <default>600</default>
      <locale name="C">
        <short>The width of the window</short>
        <long>The width of the playing window in pixels. At minimum it should be 320.</long>
      </locale>

      <locale name="ar">
        <short>عرض النافذة</short>
        <long>عرض نافذة اللعب بالبكسلات. يجب أن تكون 320 على الأقل.</long>
      </locale>

      <locale name="az">
        <short>Pəncərənin eni</short>
        <long>Oyun pəncərəsinin piksel olaraq eni.  Ən az 320 olmalıdır.</long>
      </locale>

      <locale name="bg">
        <short>Ширината на прозореца</short>
        <long>Ширина на прозореца за игра в пиксели. Минимум - 320.</long>
      </locale>

      <locale name="bn">
        <short>উইন্ডোর প্রস্থ</short>
        <long>যে উইন্ডোটিতে খেলা হবে পিক্সেল হিসাবে তার প্রস্থ। এর সবর্নিম্ন গ্রহণযোগ্য মান হল ৩২০।</long>
      </locale>

      <locale name="ca">
        <short>L&apos;amplada de la finestra</short>
        
      </locale>

      <locale name="cs">
        <short>Šířka okna</short>
        <long>Šířka hracího okna v pixelech. Měla by být nejméně 320.</long>
      </locale>

      <locale name="cy">
        <short>Lled y ffenest</short>
        <long>Lled y ffenest chwarae mewn picseli. Dylai fod o leiad 320.</long>
      </locale>

      <locale name="da">
        <short>Bredden af vinduet</short>
        <long>Bredden af spilvinduet i punkter. Skal mindst være 320.</long>
      </locale>

      <locale name="de">
        <short>Die Breite des Fensters</short>
        <long>Die Breite des Spielfensters in Pixel. Sollte mindestens 320 sein.</long>
      </locale>

      <locale name="el">
        <short>Το πλάτος του παραθύρου</short>
        <long>Το πλάτος του παράθυρο παιχνιδιού σε εικονοστοιχεία. Το ελάχιστο 320.</long>
      </locale>

      <locale name="en_CA">
        <short>The width of the window</short>
        <long>The width of the playing window in pixels. At minimum it should be 320.</long>
      </locale>

      <locale name="en_GB">
        <short>The width of the window</short>
        <long>The width of the playing window in pixels. At minimum it should be 320.</long>
      </locale>

      <locale name="es">
        <short>La anchura de la ventana</short>
        <long>El ancho de la ventana de juego en píxeles. El mínimo debe ser 320.</long>
      </locale>

      <locale name="fi">
        <short>Ikkunan leveys</short>
        <long>Peli-ikkunan leveys pikseleinä. Vähimmäisvaatimus on 240.</long>
      </locale>

      <locale name="fr">
        <short>La largeur de la fenêtre</short>
        <long>La largeur de la fenêtre de jeu en pixels. Au minimum elle doit être de 320.</long>
      </locale>

      <locale name="gu">
        <short>વિન્ડાૅની પહોળાઇ</short>
        <long>રમવા માટેની બારીના પહોળાઇ બિંદુઓમાં.તે ઓછામાં ઓછી ૩૨૦ હોવી જોઇએ. </long>
      </locale>

      <locale name="he">
        <short>רוחב החלון</short>
        <long>רוחב חלון המשחק בפיקסלים. זה צריך להיות לכל הפחות 320.</long>
      </locale>

      <locale name="hi">
        <short> खिड़की की चौड़ाई</short>
        <long>खेल विंडो की चौड़ाई पिक्सेल में. इसे न्यूनतम 320  होना चाहिए.</long>
      </locale>

      <locale name="hr">
        <short>Širina prozora</short>
        <long>Širina prozora za igru u točkama. Minimum je 320.</long>
      </locale>

      <locale name="hu">
        <short>Az ablak szélessége</short>
        <long>A játékablak szélessége képpontban. Minimum 320-nak kell lennie.</long>
      </locale>

      <locale name="it">
        <short>L&apos;ampiezza della finestra</short>
        <long>L&apos;ampiezza, in pixel, della finestra di gioco. Deve essere almeno 320.</long>
      </locale>

      <locale name="ja">
        <short>ウィンドウの幅</short>
        <long>プレイするウィンドウの幅 (ピクセル単位) です。最小値は 320 です。</long>
      </locale>

      <locale name="ko">
        <short>창의 너비</short>
        <long>플레이 창의 너비 (픽셀 단위). 최소값으로 320은 되어야 합니다.</long>
      </locale>

      <locale name="lt">
        <short>Lango plotis</short>
        <long>Lango plotis pikseliais. Mažiausia galima reikšmė yra 320.</long>
      </locale>

      <locale name="nl">
        <short>De breedte van het venster</short>
        <long>De breedte van het speelveld in beeldpunten. Minimaal 320.</long>
      </locale>

      <locale name="nn">
        <short>Breidda på vindauget</short>
        <long>Breidda på spelevindauget, i pikslar. Bør vera minst 320.</long>
      </locale>

      <locale name="no">
        <short>Bredde på vinduet</short>
        <long>Bredde på spillvinduet i piksler. Bør være minst 320.</long>
      </locale>

      <locale name="pa">
        <short>ਝਰੋਖੇ ਦੀ ਚੌੜਾੲੀ</short>
        <long>ਖੇਡਣ ਵਾਲੇ ਝਰੋਖੇ ਦੀ ਪਿਕਸਲ੾ ਵਿੱਚ ਚੌੜਾੲੀ੤ ੲਿਹ ਘੱਟੋ-ਘੱਟ 320 ਚਾਹੀਦੀ ਹੈ ੤</long>
      </locale>

      <locale name="pl">
        <short>Szerokość okna</short>
        <long>Szerokość okna gry w pikselach. Przy minimalnym rozmiarze powinno być 320.</long>
      </locale>

      <locale name="pt">
        <short>A largura da janela</short>
        <long>A largura da janela de jogo, em pixels. No mínimo deverá ser 320.</long>
      </locale>

      <locale name="pt_BR">
        <short>A largura da janela</short>
        <long>A largura da janela de jogo em pixels. O tamanho mínimo é 320.</long>
      </locale>

      <locale name="ru">
        <short>Ширина окна</short>
        <long>Ширина игрового окна в пикселах. Как минимум равно 320.</long>
      </locale>

      <locale name="sq">
        <short>Gjerësia e dritares</short>
        <long>Gjerësia e dritares në piksel. Minimumi duhet të jetë 320.</long>
      </locale>

      <locale name="sr">
        <short>Ширина прозора</short>
        <long>Ширина прозора за игру у тачкама. Мора да буде бар 320.</long>
      </locale>

      <locale name="sr@Latn">
        <short>Širina prozora</short>
        <long>Širina prozora za igru u tačkama. Mora da bude bar 320.</long>
      </locale>

      <locale name="sv">
        <short>Bredden på fönstret</short>
        <long>Bredden på spelfönstret i bildpunkter. Den bör minst vara 320.</long>
      </locale>

      <locale name="tr">
        <short>Pencere genişliği</short>
        <long>Oyun penceresinin piksel olarak genişliği. Asgari olaral 320 olmalıdır.</long>
      </locale>

      <locale name="uk">
        <short>Ширина вікна</short>
        <long>Ширина ігрового вікна в точках. Мінімальне ― 320.</long>
      </locale>

      <locale name="zh_CN">
        <short>窗口的宽度</short>
        
      </locale>
    </schema>

    <schema>
      <key>/schemas/apps/gnotravex/height</key>
      <applyto>/apps/gnotravex/height</applyto>
      <owner>gnotravex</owner>
      <type>int</type>
      <default>380</default>
      <locale name="C">
        <short>The height of the window</short>
        <long>The height of the playing window in pixels. At minimum it should be 240.</long>
      </locale>

      <locale name="ar">
        <short>إرتفاع النافذة</short>
        <long>إرتفاع نافذة اللعبة بالبكسلات. يجب أن تكون 240 على الأقلّ.</long>
      </locale>

      <locale name="az">
        <short>Pəncərənin hündürlüyü</short>
        <long>Oyun pəncərəsinin piksel olaraq hündürlüyü.  Ən az 240 olmalıdır.</long>
      </locale>

      <locale name="bg">
        <short>Височината на прозореца</short>
        <long>Височина на прозореца за игра в пиксели. Минимум - 240.</long>
      </locale>

      <locale name="bn">
        <short>উইন্ডোর উচ্চতা</short>
        <long>যে উইন্ডোটিতে খেলা হবে পিক্সেল হিসাবে তার উচ্চতা। এর সবর্নিম্ন গ্রহণযোগ্য মান হল ২৪০।</long>
      </locale>

      <locale name="ca">
        <short>L&apos;alçada de la finestra</short>
        
      </locale>

      <locale name="cs">
        <short>Výška okna</short>
        <long>Výška hracího okna v pixelech. Měla by být nejméně 240.</long>
      </locale>

      <locale name="cy">
        <short>Uchder y ffenest</short>
