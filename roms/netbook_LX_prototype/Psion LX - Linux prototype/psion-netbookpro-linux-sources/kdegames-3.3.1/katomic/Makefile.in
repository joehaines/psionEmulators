katomic.all_cpp.cpp: $(srcdir)/Makefile.in $(srcdir)/feld.cpp $(srcdir)/molek.cpp $(srcdir)/main.cpp $(srcdir)/toplevel.cpp $(srcdir)/configbox.cpp $(srcdir)/gamewidget.cpp  feld.moc molek.moc configbox.moc toplevel.moc gamewidget.moc
	@echo 'creating katomic.all_cpp.cpp ...'; \
	rm -f katomic.all_cpp.files katomic.all_cpp.final; \
	echo "#define KDE_USE_FINAL 1" >> katomic.all_cpp.final; \
	for file in feld.cpp molek.cpp main.cpp toplevel.cpp configbox.cpp gamewidget.cpp ; do \
	  echo "#include \"$$file\"" >> katomic.all_cpp.files; \
	  test ! -f $(srcdir)/$$file || egrep '^#pragma +implementation' $(srcdir)/$$file >> katomic.all_cpp.final; \
	done; \
	cat katomic.all_cpp.final katomic.all_cpp.files > katomic.all_cpp.cpp; \
	rm -f katomic.all_cpp.final katomic.all_cpp.files

