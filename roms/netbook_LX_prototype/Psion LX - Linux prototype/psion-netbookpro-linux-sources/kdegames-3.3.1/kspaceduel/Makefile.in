	rm -f kspaceduel.all_cpp.files kspaceduel.all_cpp.final; \
	echo "#define KDE_USE_FINAL 1" >> kspaceduel.all_cpp.final; \
	for file in mathroutines.cpp topwidget.cpp playerinfo.cpp sprites.cpp mainview.cpp dialogs.cpp ai.cpp main.cpp general.cpp options.cpp ; do \
	  echo "#include \"$$file\"" >> kspaceduel.all_cpp.files; \
	  test ! -f $(srcdir)/$$file || egrep '^#pragma +implementation' $(srcdir)/$$file >> kspaceduel.all_cpp.final; \
	done; \
	cat kspaceduel.all_cpp.final kspaceduel.all_cpp.files > kspaceduel.all_cpp.cpp; \
	rm -f kspaceduel.all_cpp.final kspaceduel.all_cpp.files

#>+ 3
clean-final:
	-rm -f kspaceduel.all_cpp.cpp

#>+ 3
final:
	$(MAKE) kspaceduel_OBJECTS="$(kspaceduel_final_OBJECTS)" all-am

#>+ 3
final-install:
	$(MAKE) kspaceduel_OBJECTS="$(kspaceduel_final_OBJECTS)" install-am

#>+ 3
no-final:
	$(MAKE) kspaceduel_OBJECTS="$(kspaceduel_nofinal_OBJECTS)" all-am

#>+ 3
no-final-install:
	$(MAKE) kspaceduel_OBJECTS="$(kspaceduel_nofinal_OBJECTS)" install-am

#>+ 3
cvs-clean:
	$(MAKE) admindir=$(top_srcdir)/admin -f $(top_srcdir)/admin/Makefile.common cvs-clean

#>+ 3
kde-rpo-clean:
	-rm -f *.rpo

