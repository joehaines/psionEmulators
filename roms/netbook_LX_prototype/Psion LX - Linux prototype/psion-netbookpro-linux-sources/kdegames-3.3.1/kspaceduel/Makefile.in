options.cpp: options.h
options.h: $(srcdir)/kspaceduel.kcfg $(srcdir)/options.kcfgc $(KCFG_DEPENDENCIES)
	$(KCONFIG_COMPILER) $(srcdir)/kspaceduel.kcfg $(srcdir)/options.kcfgc; ret=$$?; \
	if test "$$ret" != 0; then rm -f options.h ; exit $$ret ;  fi


general.cpp: $(srcdir)/general.ui general.h general.moc
	rm -f general.cpp
	echo '#include <kdialog.h>' > general.cpp
	echo '#include <klocale.h>' >> general.cpp
	$(UIC) -tr ${UIC_TR} -i general.h $(srcdir)/general.ui > general.cpp.temp ; ret=$$?; \
	$(PERL) -pe "s,${UIC_TR}( \"\" ),QString::null,g" general.cpp.temp | $(PERL) -pe "s,${UIC_TR}( \"\"\, \"\" ),QString::null,g" | $(PERL) -pe "s,image([0-9][0-9]*)_data,img\$$1_general,g" >> general.cpp ;\
	rm -f general.cpp.temp ;\
	if test "$$ret" = 0; then echo '#include "general.moc"' >> general.cpp; else rm -f general.cpp ; exit $$ret ; fi

general.h: $(srcdir)/general.ui
	$(UIC) -o general.h $(srcdir)/general.ui

general.moc: general.h
	$(MOC) general.h -o general.moc
