	for file in kcarddialog.cpp kstdgameaction.cpp kgamemisc.cpp kchatbase.cpp kchat.cpp kchatdialog.cpp kgameprogress.cpp kcanvasrootpixmap.cpp kgamelcd.cpp ; do \
