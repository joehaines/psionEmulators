/* imports the lmhost file */

unsigned char load_lmhosts_file (const char *file)
{
  FILE *fp;
  pstring name;
  int name_type;
  struct in_addr ipaddr;
  char *ip;
  
  fp = startlmhosts(file);
  if ( !fp )
    return 0;
  
  while ( getlmhostsent(fp, name, &name_type, &ipaddr) )
  {
    ip = inet_ntoa(ipaddr);
    data_hosts_add(name, "", ip, host_local);
  }
  
  endlmhosts(fp);
  
  return 1;
}

