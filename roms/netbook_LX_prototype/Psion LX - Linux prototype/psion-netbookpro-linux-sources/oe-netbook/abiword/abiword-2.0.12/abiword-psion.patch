+
+	if(pView->isMarkRevisions())
+	{
+		PD_Document * pDoc = pView->getDocument();
+		XAP_Frame * pFrame = static_cast<XAP_Frame *> ( pAV_View->getParentData());
+		s_doMarkRevisions(pFrame, pDoc, pView);
+	}
+
+	return true;
+}
