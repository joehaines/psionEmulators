+static bool s_doFindOrFindReplaceDlg(FV_View * pView, XAP_Dialog_Id id)
+{
+	XAP_Frame * pFrame = static_cast<XAP_Frame *> ( pView->getParentData());
+	UT_ASSERT(pFrame);
