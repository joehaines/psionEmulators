+
+	// run the dialog (it should really be modeless if anyone
+	// gets the urge to make it safe that way)
+	// OK I Will
+	if(pDialog->isRunning() == true)
+	{
+		   pDialog->activate();
+	}
+		else
+	{
+		   pDialog->runModeless(pFrame);
+	}
+	bool bOK = true;
+	return bOK;
