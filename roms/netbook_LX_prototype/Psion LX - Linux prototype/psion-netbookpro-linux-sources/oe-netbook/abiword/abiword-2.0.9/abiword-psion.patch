+Defun_EV_GetMenuItemComputedLabel_Fn(ap_GetLabel_StyleModify)
+{
+	// PSION-ABL UI Customisation Aug 2004.
+	// PSION-ABL Note: AbiWord does not yet update correctly in order to use this code correctly
+	// PSION-ABL       However, this code works correctly.
+	// Compute the menu label for the 'Format > All '<stylename>' paragraphs' item.
+
+	XAP_App * pApp = XAP_App::getApp();
+	UT_return_val_if_fail (pApp && pLabel, NULL);
+	XAP_Frame * frame = pApp->getLastFocussedFrame();
+
+	AV_View * pAV_View = frame->getCurrentView();
+	UT_return_val_if_fail(pAV_View, NULL);
+	ABIWORD_VIEW;
+	UT_return_val_if_fail(pView, NULL);
+	UT_ASSERT(id == AP_MENU_ID_FMT_STYLE_MODIFY);
+
+	const char * szFormat = pLabel->getMenuLabel();
+	static char buf[128];
+
+	const XML_Char *pCurStyle;
+	pView->getStyle(&pCurStyle);
+	sprintf(buf,szFormat,pCurStyle);
+	
+
+	return buf;
+}
+
+
 /****************************************************************/
 /****************************************************************/
 
