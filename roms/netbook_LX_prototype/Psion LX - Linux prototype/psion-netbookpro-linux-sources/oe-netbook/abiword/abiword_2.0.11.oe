DEPENDS  = "cdump-native libfribidi aspell jpeg libpng perl glibc"
RDEPENDS = "aspell abiword-dict glibc-gconv-ibm850 glibc-gconv-cp1252 \
	    glibc-gconv-iso8859-15 glibc-gconv-iso8859-1"

inherit autotools

DESCRIPTION = "PSION version of AbiWord Word Processor"
MAINTAINER  = "Alex Loveday <Alex.Loveday@psion.com>"

PR = "r9"

S = "${WORKDIR}/abiword-${PV}/abi"

SRC_URI = "http://download.sourceforge.net/abiword/abiword-${PV}.tar.bz2 \
           file://cdump-cross.patch;patch=1 \
	   file://mcaret.diff;patch=1 \
	   file://abiword-psion.patch;patch=1;pnum=0 \
	   file://fix-styles-dialog3.patch;patch=1 \
	   file://overrun-correction.patch;patch=1"

#PACKAGES += "${PN}-dict"

FILES_${PN} += " ${datadir}/icons/* \
${datadir}/AbiSuite-2.0/AbiWord/glade \
${datadir}/AbiSuite-2.0/AbiWord/scripts \
${datadir}/AbiSuite-2.0/AbiWord/system.profile-en \
${datadir}/AbiSuite-2.0/AbiWord/system.profile-en_GB \
${datadir}/AbiSuite-2.0/templates/A4.awt \
${datadir}/AbiSuite-2.0/templates/US-Letter.awt \
${datadir}/AbiSuite-2.0/templates/normal.awt \
${datadir}/AbiSuite-2.0/templates/normal.awt-en_GB \	
${datadir}/AbiSuite-2.0/templates/Business-Report.awt \
${datadir}/AbiSuite-2.0/templates/Fax-Coversheet.awt \
${datadir}/AbiSuite-2.0/templates/Resume.awt \
${datadir}/AbiSuite-2.0/templates/Two-Columns.awt \
${datadir}/AbiSuite-2.0/templates/Memo.awt \
${datadir}/AbiSuite-2.0/templates/Press-Release.awt"

#FILES_${PN}-dict = "${datadir}/AbiSuite-2.0/dictionary/british.hash \
#                   ${datadir}/AbiSuite-2.0/dictionary/british.hash-encoding \
#		    ${datadir}/AbiSuite-2.0/dictionary/ispell_dictionary_list.xml"

#abiword needs this native tool
export BUILD_CDUMPTOOL=${STAGING_BINDIR}/cdump

do_configure () {
	cd ${S}
	./autogen.sh
	./configure --prefix=/usr --host=${TARGET_SYS} --with-aspell
	#--enable-debug
}

do_install_append() {
	install -d ${D}${datadir}/pixmaps/
	mv ${D}${datadir}/icons/* ${D}${datadir}/pixmaps/
#	install -d ${D}${datadir}/AbiSuite-2.0/dictionary/
#	mv ${S}/../../usr/share/AbiSuite/dictionary/* ${D}${datadir}/AbiSuite-2.0/dictionary/
}

