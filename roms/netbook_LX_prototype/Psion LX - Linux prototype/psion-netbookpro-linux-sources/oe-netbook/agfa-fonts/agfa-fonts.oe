PR = "r5"

SRC_URI = "file://ALBW.TTF file://ALBWI.TTF file://ALBWB.TTF file://ALBWBI.TTF \
	   file://THOWR___.TTF file://THOWI___.TTF file://THOWB___.TTF file://THOWBI__.TTF \
	   file://ARIALN.TTF file://ARIALNI.TTF file://ARIALNB.TTF file://ARIALNBI.TTF \
	   file://CumberlandAMT-Regular.otf file://CumberlandAMT-Italic.otf  \
	   file://CumberlandAMT-Bold.otf file://CumberlandAMT-BoldItalic.otf"

FILES_${PN} = "${datadir}/fonts"

do_install() {
	install -d ${D}${datadir}/fonts/ttf/
	for i in ALBW.TTF ALBWI.TTF ALBWB.TTF ALBWBI.TTF THOWR___.TTF THOWI___.TTF THOWB___.TTF THOWBI__.TTF ARIALN.TTF ARIALNI.TTF ARIALNB.TTF ARIALNBI.TTF CumberlandAMT-Regular.otf CumberlandAMT-Italic.otf CumberlandAMT-Bold.otf CumberlandAMT-BoldItalic.otf; do install -m 0644 ${WORKDIR}/$i ${D}${datadir}/fonts/ttf/; done
}

