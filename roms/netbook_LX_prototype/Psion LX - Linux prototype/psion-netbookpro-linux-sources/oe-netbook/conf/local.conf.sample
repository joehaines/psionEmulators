# unlike the upstream OE tree, this file contains nothing by default.
# it includes local-netbook.conf, which is equivalent to local.conf
# in OE, but is intended to be homogenous across all netbook build
# trees, with central CVS dates and build options, etc.
include conf/local-netbook.conf

# any per-tree customisations can be made here. use copies of setup.sh
# to handle multiple build trees.

# for example, uncomment this to do debug builds
#DEBUG_BUILD=1
#INHIBIT_PACKAGE_STRIP=1
