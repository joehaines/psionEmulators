PR=r7

DEPENDS = "openssl jpeg libpng zlib"
RRECOMMENDS_${PN} = "esp-gs"
DESCRIPTION = "An Internet printing system for Unix."

SRC_URI = "ftp://ftp.easysw.com/pub/cups/${PV}/cups-${PV}-source.tar.bz2 \
           file://configure.patch;patch=1 \
	   file://default-conf.patch;patch=1;pnum=0 \
	   file://init-mkdir.patch;patch=1"

inherit autotools binconfig

do_configure () {
	oe_runconf
}


do_compile () {
	oe_runmake "SSLLIBS=-lssl -lcrypto -L${STAGING_LIBDIR}" \
		   "LIBPNG=-lpng -lm -L${STAGING_LIBDIR}" \
		   "LIBJPEG=-ljpeg -L${STAGING_LIBDIR}" \
		   "LIBZ=-lz -L${STAGING_LIBDIR}"
}

cups_include = "cups.h http.h ipp.h language.h md5.h ppd.h"


do_stage () {
	oe_libinstall -a -so cups/libcups ${STAGING_LIBDIR}
	oe_libinstall -a -so filter/libcupsimage ${STAGING_LIBDIR}

	mkdir -p ${STAGING_INCDIR}/cups
	for i in ${cups_include}; do
		install -m 0644 cups/$i ${STAGING_INCDIR}/cups/$i
	done
	install -m 0644 filter/raster.h ${STAGING_INCDIR}/cups/raster.h
}


do_install () {
	oe_runmake "DSTROOT=${D}" install
}


