SRC_URI = "${SOURCEFORGE_MIRROR}/espgs/espgs-${PV}-source.tar.bz2 \
           file://fix-types.patch;patch=1;pnum=0 \
           file://bypass-cups-config.patch;patch=1"

PR = "r3"

DEPENDS = "cups"

EXTRA_OECONF = "--without-gimp-print --without-omni"

S = "${WORKDIR}/espgs-${PV}"

FILES_${PN} += "${datadir}/ghostscript/lib ${datadir}/cups ${libdir}/cups"
FILES_${PN}-doc += "${datadir}/ghostscript/doc ${datadir}/ghostscript/examples"

inherit autotools flow-lossage

do_compile() {
	oe_runmake CCAUX="${BUILD_CC}"
}

do_install() {
	oe_runmake install_prefix='${D}' bindir='${D}${bindir}' datadir='${D}${datadir}' libdir='${D}${libdir}' install
}

