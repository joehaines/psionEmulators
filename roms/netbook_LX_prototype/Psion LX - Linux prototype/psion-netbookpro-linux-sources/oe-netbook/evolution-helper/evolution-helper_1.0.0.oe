DESCRIPTION = "Support files for external Evolution Mailer"
SECTION = "base"

do_install () {
    mkdir -p ${D}/usr/lib
    mkdir -p ${D}/usr/share

    ln -s /opt/evolution/usr/lib/evolution/ ${D}/usr/lib/evolution
    ln -s /opt/evolution/usr/share/evolution/ ${D}/usr/share/evolution
}

FILES_${PN} = "/"
