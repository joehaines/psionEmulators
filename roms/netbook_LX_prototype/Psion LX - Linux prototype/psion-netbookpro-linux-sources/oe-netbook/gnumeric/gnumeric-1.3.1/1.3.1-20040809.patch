+int __WINAPI get_multiprice(lprec *lp, MYBOOL getabssize)
+{
+  if(lp->multiused == 0)
+    return( 0 );
+  if(getabssize)
+    return( lp->multisize );
+  else
+    return( lp->multiblockdiv );
+}
