+  if (lpt_yydebug)
+    fprintf(stderr, "Shifting error token, ");
+#endif
+
+  *++lpt_yyvsp = lpt_yylval;
+#ifdef YYLSP_NEEDED
+  *++lpt_yylsp = lpt_yylloc;
+#endif
