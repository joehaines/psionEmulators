+#if YYDEBUG != 0
+  if (lpt_yydebug)
+    {
+      short *ssp1 = lpt_yyss - 1;
+      fprintf (stderr, "Error: state stack now");
+      while (ssp1 != lpt_yyssp)
+	fprintf (stderr, " %d", *++ssp1);
+      fprintf (stderr, "\n");
+    }
+#endif
+
+lpt_yyerrhandle:
+
+  lpt_yyn = lpt_yypact[lpt_yystate];
+  if (lpt_yyn == YYFLAG)
+    goto lpt_yyerrdefault;
