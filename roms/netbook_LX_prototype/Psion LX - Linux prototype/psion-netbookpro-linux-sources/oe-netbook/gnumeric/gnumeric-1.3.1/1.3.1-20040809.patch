+  HadVar = TRUE;
+  isign = 0;
+;
+    break;}
+case 59:
+{
+  storevarandweight(Last_var);
+;
+    break;}
+case 60:
+{
+  SOSNr++;
+  weight = SOSNr;
+  storevarandweight(Last_var);
+  set_sos_weight(weight, 2);
+;
+    break;}
+case 61:
+{
+  storevarandweight(Last_var);
+;
+    break;}
+case 62:
+{
+  weight = (int) (f + .1);
+  set_sos_weight(weight, 2);
+;
+    break;}
+case 67:
+{
+  check_int_sec_sos_decl(Within_gen_decl ? 1 : Within_bin_decl ? 2 : 0, 0, 0);
+;
+    break;}
+case 73:
+{
+  check_int_sec_sos_decl(0, 1, 0);
+;
+    break;}
+case 84:
+{
+  char buf[16];
+
+  check_int_sec_sos_decl(0, 0, 1);
+  SOSweight++;
+  sprintf(buf, "SOS%d", SOSweight);
+  storevarandweight(buf);
+  SOStype = Last_var[1] - '0';
+  set_sos_type(SOStype);
+  check_int_sec_sos_decl(0, 0, 2);
+  weight = 0;
+  SOSNr = 0;
+;
+    break;}
+case 85:
+{
+  set_sos_weight(SOSweight, 1);
+;
+    break;}
+}
+   /* the action file gets copied in in place of this dollarsign */
+
+
+  lpt_yyvsp -= lpt_yylen;
+  lpt_yyssp -= lpt_yylen;
+#ifdef YYLSP_NEEDED
+  lpt_yylsp -= lpt_yylen;
+#endif
+
+#if YYDEBUG != 0
+  if (lpt_yydebug)
+    {
+      short *ssp1 = lpt_yyss - 1;
+      fprintf (stderr, "state stack now");
+      while (ssp1 != lpt_yyssp)
+	fprintf (stderr, " %d", *++ssp1);
+      fprintf (stderr, "\n");
+    }
+#endif
+
+  *++lpt_yyvsp = lpt_yyval;
+
+#ifdef YYLSP_NEEDED
+  lpt_yylsp++;
