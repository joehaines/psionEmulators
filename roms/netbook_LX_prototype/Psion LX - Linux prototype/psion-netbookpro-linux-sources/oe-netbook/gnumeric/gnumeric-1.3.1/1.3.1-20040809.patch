+#endif
+  int       *row_end;           /* rows_alloc+1 : row_end[i] is the index of the
+                                   first element in row_mat after row i */
+  MYBOOL    row_end_valid;      /* TRUE if row_end & row_mat are valid */
+  MYBOOL    is_roworder;        /* FUTURE */
+
+} MATrec;
