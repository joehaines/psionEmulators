-						      "too small (limit %g)\n",
-						      (double)f, 
-						      (double) lp_solve_Trej);
-			}
-			else { /* pivot alright */
-			        quot = 2 * lp->infinite;
-				if (f > 0)
-				        quot = lp->rhs[i] / (gnm_float) f;
-				else if (lp->upbo[lp->bas[i]] < lp->infinite)
-				        quot = (lp->rhs[i]
-						- lp->upbo[lp->bas[i]])
-					  / (gnm_float) f;
