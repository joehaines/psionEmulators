+  lp->invB = NULL;
+  lp->duals = NULL;
+  lp->dualsfrom = NULL;
+  lp->dualstill = NULL;
+  lp->objfrom = NULL;
+  lp->objtill = NULL;
+
+  inc_col_space(lp, columns+1);
