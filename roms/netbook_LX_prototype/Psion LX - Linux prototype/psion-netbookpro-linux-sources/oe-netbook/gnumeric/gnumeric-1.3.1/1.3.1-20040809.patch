-		}
-	}
-	if ((*row_nr) == 0)  
-	        for (i = 1; i <= lp->rows; i++) {
-		        f = pcol[i];
-			if (f != 0) {
-			        quot = 2 * lp->infinite;
-				if (f > 0)
-				        quot = lp->rhs[i] / (gnm_float) f;
-				else
-				        if (lp->upbo[lp->bas[i]] < lp->infinite)
-					        quot = (lp->rhs[i] -
-							lp->upbo[lp->bas[i]]) /
-						  (gnm_float) f;
