+	  count = 0;
+	  /* Start X at -lpt_yyn if nec to avoid negative indexes in lpt_yycheck.  */
+	  for (x = (lpt_yyn < 0 ? -lpt_yyn : 0);
+	       x < (sizeof(lpt_yytname) / sizeof(char *)); x++)
