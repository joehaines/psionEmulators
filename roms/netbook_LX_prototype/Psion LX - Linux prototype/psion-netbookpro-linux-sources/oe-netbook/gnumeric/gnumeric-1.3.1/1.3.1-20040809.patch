-			 "pcol[%d] = %18g, rhs[%d] = %18g , upbo = %g\n",
-			 (*row_nr), (double) f, (*row_nr),
-			 (double) lp->rhs[(*row_nr)],
-			 (double) lp->upbo[lp->bas[(*row_nr)]]);
-	}
-	if ((*row_nr) == 0) {
-	        if (lp->upbo[colnr] == lp->infinite) {
