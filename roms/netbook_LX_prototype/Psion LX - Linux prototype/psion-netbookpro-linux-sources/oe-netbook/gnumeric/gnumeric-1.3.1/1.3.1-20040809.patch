-		for (i = 1; i <= lp->sum; i++)
-		        my_round(drow[i], lp->epsd);
-	}
-	for (i = 1; i <= lp->sum; i++)
-	        if (!lp->basis[i])
-		        if (lp->upbo[i] > 0) {
-			        if (lp->lower[i])
-				        f = drow[i];
-				else
-				        f = -drow[i];
-				if (f < dpiv) {
-				        dpiv = f;
-					(*colnr) = i;
-				}
-			}
-	if (lp->trace) {
-	        if ((*colnr)>0)
-		        fprintf (stderr, "col_prim:%d, reduced cost: %g\n",
-				 (*colnr), (double)dpiv);
-		else
-		        fprintf (stderr,
-				 "col_prim: no negative reduced costs found, "
-				 "optimality!\n");
-	}
-	if (*colnr == 0) {
-	        Doiter   = FALSE;
-		DoInvert = FALSE;
