+  if(endPos - beginPos <= LINEARSEARCH) {
+
+    /* Do traditional indexed access */
+    focusAttrib = CMP_ATTRIBUTES(beginPos);
+    if(beginPos == endPos)
+      compare = findCompare(target, focusAttrib);
