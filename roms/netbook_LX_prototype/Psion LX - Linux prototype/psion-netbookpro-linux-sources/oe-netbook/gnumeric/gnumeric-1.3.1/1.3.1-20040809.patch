+MYBOOL __WINAPI has_XLI(lprec *lp)
+{
+  return( is_nativeXLI(lp)
+#if LoadLanguageLib == TRUE
+       || (MYBOOL) (lp->hXLI != NULL)
+#endif
+        );
+}
