+MYBOOL __WINAPI set_free(lprec *lp, int column)
+{
+#ifdef Paranoia
+  if(column > lp->columns || column < 1) {
+    report(lp, IMPORTANT, "set_free: Column %d out of range\n", column);
+    return( FALSE );
