-static void
-addetacol (lprec *lp)
-{
-        int  i, j, k;
-	gnm_float theta;
-  
-	j = lp->eta_col_end[lp->eta_size];
-	lp->eta_size++;
-	k = lp->eta_col_end[lp->eta_size] - 1;
-	theta = 1 / (gnm_float) lp->eta_value[k];
-	lp->eta_value[k] = theta;
-	for (i = j; i < k; i++)
-	        lp->eta_value[i] *= -theta;
-	JustInverted = FALSE;
