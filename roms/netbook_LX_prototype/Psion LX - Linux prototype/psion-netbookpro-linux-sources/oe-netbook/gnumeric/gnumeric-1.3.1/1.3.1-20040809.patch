+REAL __WINAPI get_working_objective(lprec *lp)
+{
+  REAL value = 0.0;
+
+  if(!lp->basis_valid)
+    report(lp, CRITICAL, "get_working_objective: Not a valid basis");
+  else if((lp->spx_status == RUNNING) && (lp->solutioncount == 0))
+    value = my_chsign(is_maxim(lp), *(lp->rhs));
+  else
+    value = *(lp->solution);
+
+  return(value);
+}
