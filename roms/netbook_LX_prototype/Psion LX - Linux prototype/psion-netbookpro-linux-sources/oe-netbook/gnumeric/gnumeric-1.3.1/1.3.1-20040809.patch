+STATIC MYBOOL feasiblePhase1(lprec *lp, REAL epsvalue)
+{
+  REAL   gap;
+  MYBOOL test;
+
+  gap = fabs(lp->rhs[0] - lp->orig_rh[0]);
+  test = (MYBOOL) (gap < epsvalue);
