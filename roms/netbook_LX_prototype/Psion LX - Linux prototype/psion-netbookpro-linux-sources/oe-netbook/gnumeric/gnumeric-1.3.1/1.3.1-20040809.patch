+MYBOOL __WINAPI get_dual_solution(lprec *lp, REAL *rc)
+{
+  REAL *duals;
+  MYBOOL ret;
+
+  if(!lp->basis_valid) {
+    report(lp, CRITICAL, "get_dual_solution: Not a valid basis");
+    return(FALSE);
+  }
+
+  ret = get_ptr_sensitivity_rhs(lp, &duals, NULL, NULL);
+
+  if(ret)
+    MEMCOPY(rc, duals - 1, lp->sum + 1);
+  return(ret);
+}
