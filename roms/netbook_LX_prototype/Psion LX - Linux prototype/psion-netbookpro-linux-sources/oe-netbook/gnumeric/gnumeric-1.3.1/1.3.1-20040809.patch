+STATIC REAL restoreINT(REAL valREAL, REAL epsilon)
+{
+  STATIC REAL valINT, fracREAL, fracABS;
+
+  fracREAL = modf(valREAL, &valINT);
+  fracABS = fabs(fracREAL);
+  if(fracABS < epsilon)
+    return(valINT);
+  else if(fracABS > 1-epsilon) {
+    if(fracREAL < 0)
+      return(valINT-1);
+    else
+      return(valINT+1);
+  }
+  return(valREAL);
+}
