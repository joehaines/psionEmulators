+MYBOOL __WINAPI get_primal_solution(lprec *lp, REAL *pv)
+{
+  if(!lp->basis_valid) {
+    report(lp, CRITICAL, "get_primal_solution: Not a valid basis");
+    return(FALSE);
+  }
+
+  MEMCOPY(pv, lp->best_solution, lp->sum + 1);
+  return(TRUE);
+}
