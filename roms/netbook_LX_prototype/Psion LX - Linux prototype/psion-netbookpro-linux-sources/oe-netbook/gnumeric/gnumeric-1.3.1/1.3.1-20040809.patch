+
+      /* return failure if at end of input */
+      if (lpt_yychar == YYEOF)
+	YYABORT;
+
+#if YYDEBUG != 0
+      if (lpt_yydebug)
+	fprintf(stderr, "Discarding token %d (%s).\n", lpt_yychar, lpt_yytname[lpt_yychar1]);
+#endif
+
+      lpt_yychar = YYEMPTY;
+    }
