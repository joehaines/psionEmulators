+STATIC MYBOOL solution_is_int(lprec *lp, int i, MYBOOL checkfixed)
+{
+#if 1
+  return( (MYBOOL) (isINT(lp, lp->solution[i]) && (!checkfixed || is_fixedvar(lp, i))) );
+#else
+  if(isINT(lp, lp->solution[i])) {
+    if(checkfixed)
+      return(is_fixedvar(lp, i));
+    else
+      return(TRUE);
+  }
+  return(FALSE);
+#endif
+} /* solution_is_int */
