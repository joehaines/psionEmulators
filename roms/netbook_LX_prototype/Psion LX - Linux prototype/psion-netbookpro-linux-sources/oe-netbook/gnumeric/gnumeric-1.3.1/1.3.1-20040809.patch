+  lp->bb_action = ACTION_NONE;
+  lp->bb_limitlevel = DEF_BB_LIMITLEVEL;
+  lp->var_priority = NULL;
+
+  lp->bigM = 0.0;
+  lp->bb_deltaOF = 0.0;
+
+  lp->sos_ints = 0;
+  lp->sos_vars = 0;
+  lp->sos_priority = NULL;
+
+  sum = rows + columns;
+  lp->rows = rows;
+  lp->columns = columns;
+  lp->sum = sum;
+  varmap_clear(lp);
+
+  lp->matA = mat_create(lp, rows, columns, lp->epsvalue);
