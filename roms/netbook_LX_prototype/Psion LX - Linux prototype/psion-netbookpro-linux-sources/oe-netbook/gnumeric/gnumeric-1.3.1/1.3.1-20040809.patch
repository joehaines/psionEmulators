+{
+	if (event->type != GDK_KEY_PRESS ||
+	    (event->state != 0 &&
+	     event->state != GDK_CONTROL_MASK))
+		return FALSE;
+
+	if (event->keyval == GDK_q ||
+	    event->keyval == GDK_Q ||
+	    event->keyval == GDK_Escape) {
+		gtk_widget_destroy (window);
+		window_count --;
+		if (window_count == 0) {
+			gtk_main_quit();
+		}
+	} else
