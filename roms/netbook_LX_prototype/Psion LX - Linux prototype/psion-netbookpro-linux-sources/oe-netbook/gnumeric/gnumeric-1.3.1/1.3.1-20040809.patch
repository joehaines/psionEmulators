+  lpt_yyn = lpt_yytable[lpt_yyn];
+  if (lpt_yyn < 0)
+    {
+      if (lpt_yyn == YYFLAG)
+	goto lpt_yyerrpop;
+      lpt_yyn = -lpt_yyn;
+      goto lpt_yyreduce;
+    }
