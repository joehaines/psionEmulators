+  lp->orig_lowbo[0] = 0;
+
+  lp->max_pivots = 0;
+
+  lp->crashmode = CRASH_NOTHING;
+  lp->rootbounds = NULL;
+/*  lp->bb_bounds = NULL; */
+  lp->bb_basis = NULL;
+
+  lp->basis_valid = FALSE;
+  lp->Extrap = 0;
+  lp->Extrad = 0.0;
+  lp->current_iter = 0;
