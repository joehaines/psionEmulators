+  return(((lp->simplex_mode & SIMPLEX_PRIMAL_Phase1 != 0) && (lp->Extrap > 0)) ||
+         ((lp->simplex_mode & SIMPLEX_DUAL_Phase1 != 0) && (lp->Extrad != 0)));
