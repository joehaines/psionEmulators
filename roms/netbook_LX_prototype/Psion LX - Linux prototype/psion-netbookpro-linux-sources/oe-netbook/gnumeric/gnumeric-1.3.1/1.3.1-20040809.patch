+        n++;
+        mat_validate(mat);
+#endif
+      }
+    }
+
+#if 0
+   /* Increase A matrix sparsity by discovering common subsets using 2-element EQs */
+    if((lp->equalities > 0) && is_presolve(lp, PRESOLVE_SPARSER) && mat_validate(mat)) {
+      if(userabort(lp, -1))
