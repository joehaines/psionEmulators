-static gboolean
-rowprim (lprec      *lp,
-	 int        colnr,
-	 int        *row_nr,
-	 gnm_float *theta,
-	 gnm_float *pcol)
-{
-        int         i;
-	gnm_float  f = -42, quot; 
-
-	(*row_nr) = 0;
-	(*theta)  = lp->infinite;
-	for (i = 1; i <= lp->rows; i++) {
