+    report(lp, IMPORTANT, "is_negative: Column %d out of range\n", column);
+    return( FALSE );
+  }
+#endif
+
+  column += lp->rows;
+  return( (MYBOOL) ((lp->orig_upbo[column] <= 0) &&
+                    (lp->orig_lowbo[column] < 0)) );
+}
