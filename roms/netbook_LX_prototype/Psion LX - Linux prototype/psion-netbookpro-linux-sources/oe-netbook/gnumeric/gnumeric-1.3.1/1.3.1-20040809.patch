+/*  lp->piv_strategy = PRICER_STEEPESTEDGE + PRICE_METHODDEFAULT + PRICE_ADAPTIVE; */
+/*  lp->piv_strategy = PRICER_FIRSTINDEX + PRICE_METHODDEFAULT; */
+#ifdef EnableRandomizedPricing
+  lp->piv_strategy = lp->piv_strategy + PRICE_RANDOMIZE;
+#endif
