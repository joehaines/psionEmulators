-	if ((*row_nr) > 0)
-	        Doiter = TRUE;
-	if (lp->trace)
-	        fprintf (stderr, "row_prim:%d, pivot element:%18g\n", (*row_nr),
-			 (double) pcol[(*row_nr)]);
-
-	return ((*row_nr) > 0);
