+      fprintf(lp->outstream, "%8g ", get_mat(lp, 0, j));
+  fprintf(lp->outstream, "\n");
+
+  for(i = 1; i <= lp->rows; i++) {
+    fprintf(lp->outstream, "%-9s ", get_row_name(lp, i));
