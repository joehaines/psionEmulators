-				        lp->scale[Row] * lp->scale[Column];
-			else
-			        lp->mat[elmnr].value = Value * lp->scale[Row] *
-				        lp->scale[Column];
-		}
-		else { /* no scaling */
-		        if (lp->ch_sign[Row])
-			        lp->mat[elmnr].value = -Value;
-			else
-			        lp->mat[elmnr].value = Value;
-		}
