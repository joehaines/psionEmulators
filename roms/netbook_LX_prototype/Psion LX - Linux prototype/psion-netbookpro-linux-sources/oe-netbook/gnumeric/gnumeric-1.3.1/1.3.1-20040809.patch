-static void
-setpivcol (lprec *lp,
-	   gboolean lower, 
-	   int   varin,
-	   gnm_float *pcol)
-{
-        int  i, colnr;
-  
-	for (i = 0; i <= lp->rows; i++)
-	        pcol[i] = 0;
-
-	if (lower) {
-	        if (varin > lp->rows) {
-		        colnr = varin - lp->rows;
-			for (i = lp->col_end[colnr - 1];
-			     i < lp->col_end[colnr]; i++)
-			        pcol[lp->mat[i].row_nr] = lp->mat[i].value;
-			pcol[0] -= lp_solve_Extrad;
-		}
-		else
-		        pcol[varin] = 1;
-	}
-	else { /* !lower */
-	        if (varin > lp->rows) {
-		        colnr = varin - lp->rows;
-			for (i = lp->col_end[colnr - 1];
-			     i < lp->col_end[colnr]; i++)
-			        pcol[lp->mat[i].row_nr] = -lp->mat[i].value;
-			pcol[0] += lp_solve_Extrad;
-		} else
-		        pcol[varin] = -1;
-	}
-
-	ftran(lp, pcol);
-} /* setpivcol */
