+Complete:
+   /* See if we can convert some constraints to SOSes (only SOS1 handled) */
+    if(is_presolve(lp, PRESOLVE_SOS) &&
+       (MIP_count(lp) > 0) && mat_validate(mat)) {
+      n = 0;
+      for(i = lastActiveLink(rowmap); i > 0; ) {
+        candelete = FALSE;
+        test = get_rh(lp, i);
+        jx = get_constr_type(lp, i);
