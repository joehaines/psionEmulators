+
+MYBOOL __EXPORT_TYPE __WINAPI write_lpt(lprec *lp, char *filename)
+{
+  int    i, j, b;
+  MYBOOL ok = FALSE, ok2;
+  REAL   a, constant_term;
+  FILE   *output = stdout;
+  char   *ptr;
+
+#ifdef Paranoia
+  if(lp->matA->is_roworder) {
+    report(lp, IMPORTANT, "write_lpt: Cannot write to LP file while in row entry mode.\n");
+    return(FALSE);
