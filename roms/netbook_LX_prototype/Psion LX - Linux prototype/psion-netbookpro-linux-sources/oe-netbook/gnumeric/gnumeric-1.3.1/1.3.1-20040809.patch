+  if(multiblockdiv != lp->multiblockdiv) {
+    if(multiblockdiv < 1)
+      multiblockdiv = 1;
+    lp->multiblockdiv = multiblockdiv;
+    FREE(lp->multivar);
+  }
+  return( TRUE );
+}
