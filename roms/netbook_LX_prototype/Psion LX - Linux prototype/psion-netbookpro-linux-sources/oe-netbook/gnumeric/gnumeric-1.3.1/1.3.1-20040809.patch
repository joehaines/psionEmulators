+MYBOOL __WINAPI get_ptr_dual_solution(lprec *lp, REAL **rc)
+{
+  MYBOOL ret;
+
+  ret = get_ptr_sensitivity_rhs(lp, rc, NULL, NULL);
+  if(ret)
+    (*rc)--;
+  return(ret);
+}
