+	  if (msg != 0)
+	    {
+	      strcpy(msg, "parse error");
+
+	      if (count < 5)
+		{
+		  count = 0;
+		  for (x = (lpt_yyn < 0 ? -lpt_yyn : 0);
+		       x < (sizeof(lpt_yytname) / sizeof(char *)); x++)
+		    if (lpt_yycheck[x + lpt_yyn] == x)
+		      {
+			strcat(msg, count == 0 ? ", expecting `" : " or `");
