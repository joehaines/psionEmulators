+      n = 0;
+      for(i = lastActiveLink(rowmap); (i > 0) && (status == RUNNING); ) {
+        candelete = FALSE;
+        /* Find an equality constraint with 2 elements; the pivot row */
+        if(!is_constr_type(lp, i, EQ) || (mat_rowlength(mat, i) != 2)) {
+          i = prevActiveLink(rowmap, i);
