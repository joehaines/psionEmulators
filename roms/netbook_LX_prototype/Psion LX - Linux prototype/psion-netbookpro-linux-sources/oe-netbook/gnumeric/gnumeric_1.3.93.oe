PR = "r0"
S = "${WORKDIR}/gnumeric-${PV}"
DEPENDS = "libgsf gtk+ libxml2 libglade libart-lgpl intltool-native libgnomecanvas libgnomeprint libgnomeprintui psion-help"
DESCRIPTION = "Gnumeric spreadsheet for GNOME"
RRECOMMENDS = "help-gnumeric"

inherit gnome flow-lossage

SRC_URI += "file://psion.patch;patch=1 \
	   file://gnumeric-xml.patch;patch=1;pnum=0 \
	   file://gnumeric-xml-2.patch;patch=1;pnum=0 \
	   file://desktop-nobble.patch;patch=1 \
	   file://ACLOCAL-fix.patch;patch=1;pnum=0 \
	   file://remove-ssconvert.patch;patch=1;pnum=0 \
	   file://gnumeric-pixbufs-create.patch;patch=1;pnum=0 \
	   file://fixed-toolbar.patch;patch=1 \
	   file://sheet.png \
	   file://gnumeric-psion-help.patch;patch=1;pnum=0"


EXTRA_OECONF = "--without-perl"

python populate_packages_prepend () {
	gnumeric_libdir = oe.data.expand('${libdir}/gnumeric/${PV}-psion/plugins', d)

	do_split_packages(d, gnumeric_libdir, '(.*)', 'gnumeric-plugin-%s', 'Gnumeric plugin for %s', allow_dirs=True)
}

do_compile_prepend() { 
        mv -f ${S}/../sheet.png ${S}/icons/gnome-gnumeric.png
}
