 void update_login_lock (GtkWidget *togglebutton,gpointer  user_data);
 
+static
+gboolean have_password(void)
+{
+	struct passwd *pw;
+	
+	pw = getpwuid(getuid());
+	
+	if (pw)
+		if ((pw->pw_passwd) && (strlen(pw->pw_passwd)))
+			return TRUE;
+	
+	return FALSE;
+}
