inherit gpe

PR = "r4"

DEPENDS = "libgpewidget libgpepimc libdisplaymigration libgpevtype libxml2 dbus psion-help"
SECTION = "gpe"
RDEPENDS = "gpe-icons"
RRECOMMENDS = "help-contacts"
DESCRIPTION = "GPE contacts manager"

FILES_${PN} += " ${datadir}/gpe ${datadir}/gpe-contacts"

SRC_URI = "${GPE_MIRROR}/${PN}-${PV}.tar.gz \
           file://contacts-no-properties.patch;patch=1;pnum=0 \
		   file://new-button-disabled-after-window-close.patch;patch=1;pnum=0 \
		   file://psion-contacts-add-help.patch;patch=1;pnum=0 \
                   file://filtered-paste.patch;patch=1;pnum=0 \
                   file://del-backspace.patch;patch=1;pnum=0 \
                   file://select-start.patch;patch=1;pnum=0 \ 
		   file://psion-icon.patch;patch=1;pnum=1 "

export ALTERNATE_LAYOUT=yes
