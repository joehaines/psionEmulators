+gboolean
+export_irda_available (void)
+{
+  dbus_bool_t r;
+
+  if (connection == NULL)
+    return FALSE;
+
+  r = dbus_bus_service_exists (connection, IRDA_SERVICE_NAME, NULL);
+
+  return r ? TRUE : FALSE;
+}
