PR = "r2nb1"

inherit gpe

DEPENDS = "gtk+ libdisplaymigration libgpewidget psion-help"
RRECOMMENDS = "help-editor"
MAINTAINER = "Phil Blundell <pb@handhelds.org>"
SECTION = "gpe"
DESCRIPTION = "Editor for the GPE Palmtop Environment"

FILES_${PN} += "${datadir}/application-registry"

SRC_URI = "${GPE_MIRROR}/gpe-edit-${PV}.tar.gz \
	file://desktop-categories.patch;patch=1 \
        file://paste-btn.patch;patch=1;pnum=0 \
	file://psion-editor-add-help.patch;patch=1;pnum=0 \
	file://text_editor.png"

do_compile_prepend() { 
        mv -f ${S}/../text_editor.png ${S}/gpe-edit.png
}
