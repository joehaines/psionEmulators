inherit gpe

PR = "r3"

DEPENDS = "libgpewidget sqlite gnome-vfs dbus"
SECTION = "gpe"
RDEPENDS = "gpe-icons gnome-vfs"
DESCRIPTION = "GPE file manager"

FILES_${PN} += " ${datadir}/gpe"

SRC_URI = "http://gpe.handhelds.org/pub/projects/gpe/source/gpe-filemanager-${PV}.tar.gz \
           file://gpe-filemanager-psion.patch;patch=1;pnum=0 \
           file://help-recursive.patch;patch=1;pnum=0 \
		   file://gpe-filemanager-psion-help.patch;patch=1;pnum=0 \
           file://fix-activation.patch;patch=1;pnum=0 \
           file://poll-mount.patch;patch=1;pnum=0"
