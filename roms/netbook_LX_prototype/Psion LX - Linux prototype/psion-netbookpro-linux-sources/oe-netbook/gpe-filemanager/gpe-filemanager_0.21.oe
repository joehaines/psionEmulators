inherit gpe

PR = "r4"

DEPENDS = "libgpewidget sqlite gnome-vfs dbus psion-help"
SECTION = "gpe"
RDEPENDS = "gpe-icons gnome-vfs"
RRECOMMENDS = "help-filemanager"
DESCRIPTION = "GPE file manager"

FILES_${PN} += " ${datadir}/gpe"

SRC_URI = "http://gpe.handhelds.org/pub/projects/gpe/source/gpe-filemanager-${PV}.tar.gz \
           file://gpe-filemanager-psion.patch;patch=1;pnum=0 \
           file://gpe-filemanager-psion-help.patch;patch=1;pnum=0 \
           file://mtab-link.patch;patch=1;pnum=0 \
           file://update.patch;patch=1;pnum=0 \
           file://params.patch;patch=1;pnum=0 \
           file://gpe-filemanager-psion-additional-help.patch;patch=1;pnum=0"
		   
