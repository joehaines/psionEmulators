 static void
+show_help (void)
+{
+	system("gpe-helpviewer /usr/share/help/gallery/index.html");
+}
+
+static gboolean
+key_press (GtkWidget *win, GdkEventKey *event)
+{
+	if (event->keyval == GDK_F1)
+	{
+		show_help();
+	}
+	return FALSE;
+}
