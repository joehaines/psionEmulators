inherit gpe

PR = "r5"
DESCRIPTION = "GPE to-do list"
DEPENDS = "gtk+ libdisplaymigration libgpewidget libgpepimc libtododb psion-help"
RRECOMMENDS = "help-todo"
MAINTAINER = "Phil Blundell <pb@handhelds.org>"
SECTION = "gpe"
PRIORITY = "optional"

SRC_URI = "http://gpe.handhelds.org/pub/projects/gpe/source/gpe-todo-${PV}.tar.gz \
           file://edit-modal.patch;patch=1;pnum=0 \
           file://add-sort.patch;patch=1;pnum=0 \
	   file://psion-todo-add-help.patch;patch=1;pnum=0 \
	   file://psion-icon.patch;patch=1;pnum=1 "
