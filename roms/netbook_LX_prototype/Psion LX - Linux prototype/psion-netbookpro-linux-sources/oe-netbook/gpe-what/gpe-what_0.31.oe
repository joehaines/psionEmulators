inherit gpe

PR = "r0nb1"

DESCRIPTION = "GPE modal help"
DEPENDS = "x11 xpm libmatchbox"
MAINTAINER = "Phil Blundell <pb@handhelds.org>"

SRC_URI += "file://help_icon.png"

do_install_append() {
	install -m 0644 ${WORKDIR}/help_icon.png ${D}${datadir}/pixmaps/gpe-what.png
	install -m 0644 ${WORKDIR}/help_icon.png ${D}${datadir}/pixmaps/gpe-what-active.png
}

