inherit gpe

PR = "r0nb1"

DESCRIPTION = "GPE modal help"
DEPENDS = "x11 xpm libmatchbox"
MAINTAINER = "Phil Blundell <pb@handhelds.org>"

SRC_URI += "file://gpe-what.session"

do_install_append() {
	install -d ${D}/etc/X11/Xsession.d
	install ${WORKDIR}/gpe-what.session ${D}/etc/X11/Xsession.d/50gpe-what
}

