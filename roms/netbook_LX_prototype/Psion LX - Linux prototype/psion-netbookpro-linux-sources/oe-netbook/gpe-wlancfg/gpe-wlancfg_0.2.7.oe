PR = "r4"

inherit gpe pkgconfig

DEPENDS = "libgpewidget flex"
SECTION = "gpe"
MAINTAINER = "Florian Boor <florian.boor@kernelconcepts.de>"
RDEPENDS = "gpe-su"

DESCRIPTION = "GPE wireless LAN configuration tool"
export CVSBUILD = no

SRC_URI = "${GPE_MIRROR}/${PN}-${PV}.tar.gz  \
           file://fix-errosmsgs.patch;patch=1;pnum=0 \
           file://exit-changes.patch;patch=1;pnum=0 \
           file://qexpert.patch;patch=1;pnum=0 \
           file://single-instance.patch;patch=1;pnum=0"
