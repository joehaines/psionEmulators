PR="r6"

DEPENDS = "gtk+ samba"
DESCRIPTION = "Samba Share Manager"
MAINTAINER = "Peter Naulls <peter@chocky.org>"

RDEPENDS = "smbclient"

SRC_URI = "http://ftp.debian.org/debian/pool/main/l/linneighborhood/linneighborhood_${PV}.orig.tar.gz \
	   file://gtk2.patch;patch=1 \
           file://gpe-fm.patch;patch=1 \
	   file://desktop-lossage.patch;patch=1 \
           file://short-name.patch;patch=1"

inherit autotools 

do_install_append() {
	install -d ${D}${datadir}/pixmaps
	mv ${D}${datadir}/icons/* ${D}${datadir}/pixmaps/
	rmdir ${D}${datadir}/icons
	install -d ${D}${datadir}/applications
	install LinNeighborhood.desktop ${D}${datadir}/applications/
}

