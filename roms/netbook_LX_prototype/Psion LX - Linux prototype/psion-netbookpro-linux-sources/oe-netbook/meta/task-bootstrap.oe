DESCRIPTION = "Core packages required for a basic installation"
MAINTAINER = "Phil Blundell <pb@handhelds.org>"
PR = "r7nb0"

ALLOW_EMPTY = 1
PACKAGES = "${PN}"

DEPENDS = 'base-files base-passwd-3.5.7 \
	busybox util-linux dropbear hotplug ipkg initscripts modutils netbase \
	sysvinit tinylogin lrzsz portmap \
	modutils-initscripts udev \
	${BOOTSTRAP_EXTRA_DEPENDS}'

RDEPENDS = 'base-files base-passwd busybox util-linux \
	hotplug ipkg initscripts modutils-depmod modutils-modinfo \
	netbase sysvinit tinylogin \
	modutils-initscripts udev \
	${BOOTSTRAP_EXTRA_RDEPENDS}'

RRECOMMENDS = 'dropbear lrzsz portmap \
	${BOOTSTRAP_EXTRA_RRECOMMENDS}'
