inherit gpe

PR = "r0nb0"

DESCRIPTION = "Clipboard management application"
DEPENDS = "x11"
MAINTAINER = "Phil Blundell <pb@handhelds.org>"

SRC_URI += "file://miniclipboard.xsession"

do_install_append() {
	install -d ${D}/etc/X11/Xsession.d/
	install ${WORKDIR}/miniclipboard.xsession ${D}/etc/X11/Xsession.d/70miniclipboard
}

