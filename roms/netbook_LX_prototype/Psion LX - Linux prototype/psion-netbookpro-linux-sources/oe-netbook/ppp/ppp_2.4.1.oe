DESCRIPTION = "Point-to-Point Protocol (PPP) daemon"
PR = "r8"
SRC_URI = "http://freshmeat.net/redir/pppd/8313/url_tgz/ppp-2.4.1.tar.gz \
	file://pppd.patch;patch=1 \
	file://man.patch;patch=1 \
	file://pon \
	file://poff \
        file://ip-down \
        file://ip-up \
        file://options.patch;patch=1;pnum=0"
	
inherit autotools libtool

EXTRA_OEMAKE = "STRIPPROG=arm-linux-strip"
EXTRA_OECONF = --disable-strip

do_install_append () {
	install -d ${D}${bindir}/
 	install -m 0755 ${WORKDIR}/pon ${D}${bindir}/pon
	install -m 0755 ${WORKDIR}/poff ${D}${bindir}/poff
	install -d ${D}${sysconfdir}/ppp
 	install -m 0755 ${WORKDIR}/ip-up ${D}${sysconfdir}/ppp/ip-up
 	install -m 0755 ${WORKDIR}/ip-down ${D}${sysconfdir}/ppp/ip-down
	install -d ${D}${sysconfdir}/ppp/ip-up.d
	install -d ${D}${sysconfdir}/ppp/ip-down.d
 	install -m 0755 ${FILESDIR}/ip-up.d/0000usepeerdns ${D}${sysconfdir}/ppp/ip-up.d/
 	install -m 0755 ${FILESDIR}/ip-down.d/0000usepeerdns ${D}${sysconfdir}/ppp/ip-down.d/
        install -m 0600 ${FILESDIR}/pap-secrets ${D}${sysconfdir}/ppp/pap-secrets
	install -d ${D}${sysconfdir}/ppp/peers
 	install -m 0644 ${FILESDIR}/peers/Voda_GPRS ${D}${sysconfdir}/ppp/peers/Voda_GPRS
 	install -m 0644 ${FILESDIR}/peers/Orange_GPRS ${D}${sysconfdir}/ppp/peers/Orange_GPRS
 	install -m 0644 ${FILESDIR}/peers/Tmobile_GPRS ${D}${sysconfdir}/ppp/peers/Tmobile_GPRS
 	install -m 0644 ${FILESDIR}/peers/O2_GPRS ${D}${sysconfdir}/ppp/peers/O2_GPRS
	install -d ${D}${sysconfdir}/chatscripts
 	install -m 0644 ${FILESDIR}/chatscripts/Voda_GPRS ${D}${sysconfdir}/chatscripts/Voda_GPRS
 	install -m 0644 ${FILESDIR}/chatscripts/Orange_GPRS ${D}${sysconfdir}/chatscripts/Orange_GPRS
 	install -m 0644 ${FILESDIR}/chatscripts/Tmobile_GPRS ${D}${sysconfdir}/chatscripts/Tmobile_GPRS
 	install -m 0644 ${FILESDIR}/chatscripts/O2_GPRS ${D}${sysconfdir}/chatscripts/O2_GPRS
}
