PV = "1.6"

SRC_URI = "file://ejector.png file://eject.sh file://psion-card-ejector"

do_install() {
	install -d ${D}${datadir}/pixmaps
	install -m 0644 ${WORKDIR}/ejector.png ${D}${datadir}/pixmaps/
	install -d ${D}${bindir}
	install ${WORKDIR}/eject.sh ${D}${bindir}/
	install ${WORKDIR}/psion-card-ejector ${D}${bindir}/
}

