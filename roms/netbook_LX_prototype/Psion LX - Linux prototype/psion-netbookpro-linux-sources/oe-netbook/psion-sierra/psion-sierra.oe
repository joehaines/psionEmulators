PV = "2"

SRC_URI = "file://aircard.conf file://SW_7xx_SER.dat file://globetrotter.conf"

do_install() {
	install -d ${D}/etc/pcmcia
	install -m 0644 ${WORKDIR}/aircard.conf ${D}/etc/pcmcia/
	install -m 0644 ${WORKDIR}/globetrotter.conf ${D}/etc/pcmcia/
	install -d ${D}/etc/pcmcia/cis
	install -m 0644 ${WORKDIR}/SW_7xx_SER.dat ${D}/etc/pcmcia/cis/
}

