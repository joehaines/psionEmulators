PV = "1.1"
FILES_${PN} = "${datadir}/tutorial"

SRC_URI = "file://tutorial_00.html file://tutorial_01.html \
file://tutorial_02.html file://tutorial_02A.html \
file://tutorial_03.html file://tutorial_04.html \
file://tutorial_04A.html file://tutorial_05.html file://tutorial_06.html \
file://tutorial_06A.html file://tutorial_07.html \
file://tutorial_08.html file://tutorial_09.html \
file://tutorial_10.html file://tutorial_11.html \
file://tutorial_12.html"

do_install() {
	install -d ${D}${datadir}/tutorial/
	install -m 0644 ${WORKDIR}/*.html ${D}${datadir}/tutorial/
}
