DESCRIPTION = "Synchonization Service for the Psion LX"
SECTION = "base"
PRIORITY = "optional"
LICENSE = "GPL"
DEPENDS = "zenity sqlite"

SRC_URI = " \
           file://Makefile \
           file://sync_serv.c \
           file://lx_sync.sh"

do_configure () {
	install -m 0644 ${WORKDIR}/Makefile Makefile
	install -m 0644 ${WORKDIR}/sync_serv.c sync_serv.c
}

do_install () {
        install -d ${D}/${bindir}
	install -m 0755 sync_serv ${D}/${bindir}
	install -m 0755 ${WORKDIR}/lx_sync.sh ${D}/${bindir}
}
