DESCRIPTION = "A client for the Cisco3000 VPN Concentrator"
SECTION = "base"
PRIORITY = "optional"
LICENSE = "GPL"
DEPENDS = "zenity libgcrypt"

SRC_URI = "http://www.unix-ag.uni-kl.de/~massar/vpnc/vpnc-${PV}.tar.gz \
           file://vpnc.sh \
           file://vpnc-connect.patch;patch=1 \
           file://attribute.patch;patch=1"

do_configure () {
	install ${WORKDIR}/vpnc.sh vpnc.sh
}

CFLAGS_append = ' -DVERSION=\\"${PV}\\"'
LDFLAGS_append = " -lgcrypt -lgpg-error"

do_install () {
        install -d ${D}/${sbindir}
	install -m 0755 vpnc ${D}/${sbindir}
	install -m 0755 vpnc-connect ${D}/${sbindir}
	install -m 0755 vpnc-disconnect ${D}/${sbindir}
	install -m 0755 vpnc.sh ${D}/${sbindir}
}
