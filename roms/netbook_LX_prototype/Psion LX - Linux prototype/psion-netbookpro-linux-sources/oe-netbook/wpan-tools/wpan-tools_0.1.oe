DESCRIPTION = "WPAN tools \
IrDA and Bluetooth connection scripts"
SECTION = "base"
PRIORITY = "optional"
LICENSE = "GPL"
DEPENDS = "zenity"

SRC_URI = " \
           file://bt_connect.sh \
           file://ir_connect.sh"

do_install () {
        install -d ${D}/${sbindir}
	install -m 0755 ${WORKDIR}/bt_connect.sh ${D}/${sbindir}
	install -m 0755 ${WORKDIR}/ir_connect.sh ${D}/${sbindir}
}
