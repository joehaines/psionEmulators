#!/bin/sh

# this script copies /etc/gpe/psion.mbdock into ~/.matchbox/mbdock.session
# before /etc/X11/Xsession.d/98standard-apps copies /etc/gpe/gpe.mbdock,
# which doesn't have the right things for a netbook, nor our custom
# buttonbar. this also neatly avoids the annoying welcome screen and
# timezone setter, but gives us ample scope to add our own if we so
# desire. :)

if [ ! -f "$HOME/.matchbox/mbdock.session" ]; then
  mkdir -p "$HOME/.matchbox"
  cp /etc/gpe/psion.mbdock "$HOME/.matchbox/mbdock.session"
fi
