# desc.appindex
# Author: Frederic Peters <fpeters@tiscalinet.be>
# Purpose: Freshmeat appindex database
# Comment:
#   It provides support for FreshMeat appindex database file, as used by
#   <a href="http://www.penguin.cz/~mhi/appindex/">appindex</a>.

Begin tables
	Appindex
		name:
		category:
		ver_stable:
		ver_devel:
		license:
		homepage:
		download:
		changelog:
		deb:
		rpm:
		link:
		oneliner:
		description:strings
		author:
		coauthor:
		dependancy:
End

Begin subtables
	Concise:Appindex
		viewable as xlist.
		with only the following fields
			name:
			category:
			oneliner:
	Full:Appindex
		viewable as form.
		with every fields.
End

Begin locations
	Appindex
		/var/lib/appindex/appindex.db.bz2
			format = appindex
			read-only
End

