# desc.apt
# Author: Frederic Peters <fpeters@tiscalinet.be>
# Purpose: Debian packages file

Begin tables
	Packages
		Package:
		Priority:
		Section:
		Installed-Size:
		Maintainer:
		Architecture:
		Source:
		Version:
		Replaces:
		Depends:
		Suggests:
		Recommends:
		Conflicts:
		Filename:
		Size:
		MD5sum:
		Description (short):
		Description (long):Strings
End

Begin locations
	Packages
		/var/lib/dpkg/available
			format = dpkg
			read-only
End

Begin subtables
	Packages:Packages
		viewable as xlist.
		with only the following fields
			Package:Package
			Section:Section
			Description (short):Description
	Packages (long):Packages
		viewable as form,xlist.
		with only the following fields
			Package:Package
			Priority:Priority
			Section:Section
			Maintainer:Maintainer
			Version:Version
			Description (short):Description (short)
			Description (long):Description (long)
End

Begin actions
	Number of records
		stat_count(Packages)
End

Begin misc
	Main window
		form:Packages (long)
End

