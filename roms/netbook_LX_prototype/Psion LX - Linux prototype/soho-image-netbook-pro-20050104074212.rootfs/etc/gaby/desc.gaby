			i18n_nl=Stad/gemeente
			i18n_no=By
			i18n_sv=Stad
			i18n_fi=Postitoimipaikka
			i18n_de=Stadt
		State / Province:string
			i18n_fr=Etat / Province
			i18n_nl=Staat / Provincie
			i18n_no=Stat / Provins
			i18n_sv=Stat / Provins
			i18n_fi=Osavaltio / Provinssi
