# desc.gaby
# Author: Frederic Peters <fpeters@tiscalinet.be>
# Purpose: addressbook
# Translations: Dutch, Finnish, French, German, Norwegian
# Comment:
#   It has the same name as the app 'cause it was the first one; it is a fairly
#   complete addressbook, providing actions (such as 'mail to'), support for
#   multiple files (different system-wide and user addressbooks), ...

Begin tables
	AddressBook:AB
		First Name:string
			i18n_fr=Pr√©nom
			i18n_nl=Voornaam
			i18n_no=Fornavn
			i18n_sv=Fˆrnamn
			i18n_fi=Etunimi
			i18n_de=Vorname
		Last Name:string
			i18n_fr=Nom
			i18n_nl=Naam
			i18n_no=Etternavn
			i18n_sv=Efternamn
			i18n_fi=Sukunimi
			i18n_de=Name
		(More...):string
			i18n_fr=(autre...)
			i18n_nl=(andere...)
			i18n_no=(Mer...)
			i18n_sv=(Mer...)
			i18n_fi=(Muuta...)
			i18n_de=(andere...)
