		Cell Phone:string
			i18n_fr=GSM
			i18n_nl=GSM
			i18n_no=Mobil
			i18n_sv=Mobil
			i18n_fi=Matkapuhelin
			i18n_de=Mobil-Telefon
		Fax:string
			i18n_fr=Fax
			i18n_nl=Fax
			i18n_no=Faks
			i18n_sv=Fax
			i18n_fi=Faksi
			i18n_de=Fax
		E-Mail:string
			i18n_fr=E-Mail
			i18n_nl=E-Mail
			i18n_no=E-post
			i18n_sv=E-post
			i18n_fi=S‰hkˆposti
