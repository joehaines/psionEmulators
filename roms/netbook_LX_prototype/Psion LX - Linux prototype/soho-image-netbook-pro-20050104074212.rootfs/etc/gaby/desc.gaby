	Zip
		Zip code:string
		City:string
End

Begin subtables
	Phone Book:AddressBook
		i18n_fr=R√©pertoire t√©l√©phonique
		i18n_fi=Puhelinmuistio
		i18n_de=Telefonbuch
		i18n_no=Telefonliste
		i18n_sv=Telefonlista
		viewable as form, list, xlist.
		with only the following fields
			First Name:
			Last Name:
			Private Phone:Phone
				i18n_fr=T√©l√©phone
				i18n_nl=Telefoon
				i18n_no=Telefon
				i18n_sv=Telefon
				i18n_fi=Puhelin
				i18n_de=Telefon
	Address Book:AddressBook
		i18n_fr=Carnet d'adresse
		i18n_fi=Osoitemuistio
		i18n_de=Adreﬂbuch
		i18n_no=Adressebok
		i18n_sv=Adressbok
		viewable as form,list,filter,search.
		with every fields.
	Zip List:Zip
		i18n_fr=Liste des codes postaux
		i18n_fi=Postinumeroluoettelo
		i18n_de=Postleitzahlen-Liste
		i18n_no=Postnummerliste
		i18n_sv=Postnummerlista
		viewable as list,xlist.
		absolutely not viewable as form.
		with every fields.
End

Begin actions
	Mail to ...
		i18n_fr=Envoyer un e-mail √† ...
		i18n_nl=Mail naar ...
		i18n_no=E-post til ...
		i18n_sv=E-post till ...
		i18n_fi=L‰het‰ s‰hkˆpostia ...
		i18n_de=Mail senden ...
		net_mail(AB:First Name, AB:Last Name, AB:E-Mail)
	Phone to (private) ...
		i18n_fr=T√©l√©phoner √† (priv√©) ...
		i18n_fi=Soita kotipuhelimeen ...
		i18n_de=Telefonieren (privat) ...
		i18n_no=Ring til (privat) ...
		i18n_sv=Ring till (privat) ...
		net_phone(AB:Private Phone)
	Phone to (work) ...
		i18n_fr=T√©l√©phoner √† (travail) ...
		i18n_fi=Soita tyˆpuhelimeen ...
		i18n_de=Telefonieren (gesch‰ftl.)
		i18n_no=Ring til (arbeid) ...
		i18n_sv=Ring till (arbete) ...
		net_phone(AB:Work Phone)
	Number of records
		stat_count(AddressBook)
	gnome-pim_init
		event = startup
		gnomepim_init(AddressBook)
End

Begin locations
	AddressBook
		~/.gaby/
		~/.gnome/GnomeCard.gcrd
			format = vcard
		/var/state/gaby/
			reread = 10
			read-only
	Zip
		~/.gaby/
			read-only
End

Begin misc
	Main window
		form:Address Book
			size = 400x500
			bind to
				xlist:Phone Book
	Other windows
		xlist:Phone Book
			visible = yes
			size = 400x500
			bind to
				form:Address Book
End

