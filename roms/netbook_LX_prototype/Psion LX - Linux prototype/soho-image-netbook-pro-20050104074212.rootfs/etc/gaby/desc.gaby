			i18n_sv=Land
			i18n_fi=Maa
			i18n_de=Land
		Birthday:date
			i18n_fr=Date de naissance
			i18n_nl=Geboortedatum
			i18n_no=F¯dselsdag
			i18n_sv=Fˆdselsdag
			i18n_fi=Syntym‰p‰iv‰
			i18n_de=Geburtsdatum
		Private Phone:string
			i18n_fr=T√©l√©phone (priv√©)
			i18n_nl=Telefoon (priv√©)
