# desc.gaby
# Author: Frederic Peters <fpeters@tiscalinet.be>
# Purpose: addressbook
# Translations: Dutch, Finnish, French, German, Norwegian
# Comment:
#   It has the same name as the app 'cause it was the first one; it is a fairly
#   complete addressbook, providing actions (such as 'mail to'), support for
#   multiple files (different system-wide and user addressbooks), ...

Begin tables
	AddressBook:AB
		First Name:string
			i18n_fr=Prénom
			i18n_nl=Voornaam
			i18n_no=Fornavn
			i18n_sv=Förnamn
			i18n_fi=Etunimi
			i18n_de=Vorname
		Last Name:string
			i18n_fr=Nom
			i18n_nl=Naam
			i18n_no=Etternavn
			i18n_sv=Efternamn
			i18n_fi=Sukunimi
			i18n_de=Name
		(More...):string
			i18n_fr=(autre...)
			i18n_nl=(andere...)
			i18n_no=(Mer...)
			i18n_sv=(Mer...)
			i18n_fi=(Muuta...)
			i18n_de=(andere...)
			description = Title, company, ...
			description_fr = Titre, société, ...
			description_fi = Arvonimi, yritys, ...
			description_de = Titel, Firma, ...
			description_no = Tittel, firma, ...
			description_sv = Titel, firma, ...
		Street:string
			i18n_fr=Rue
			i18n_nl=Straat
			i18n_no=Gate
			i18n_sv=Gata
			i18n_fi=Katuosoite
			i18n_de=Firma
		Zip:string
			i18n_fr=Code postal
			i18n_nl=Postcode
			i18n_no=Postnummer
			i18n_sv=Postnummer
			i18n_fi=Postinumero
			i18n_de=Postleitzahl
		City:string
			i18n_fr=Ville
			i18n_nl=Stad/gemeente
			i18n_no=By
			i18n_sv=Stad
			i18n_fi=Postitoimipaikka
			i18n_de=Stadt
		State / Province:string
			i18n_fr=Etat / Province
			i18n_nl=Staat / Provincie
			i18n_no=Stat / Provins
			i18n_sv=Stat / Provins
			i18n_fi=Osavaltio / Provinssi
			i18n_de=Bundesland / Provinz
		Country:string
			i18n_fr=Pays
			i18n_nl=Land
			i18n_no=Land
			i18n_sv=Land
			i18n_fi=Maa
			i18n_de=Land
		Birthday:date
			i18n_fr=Date de naissance
			i18n_nl=Geboortedatum
			i18n_no=Fødselsdag
			i18n_sv=Födselsdag
			i18n_fi=Syntymäpäivä
			i18n_de=Geburtsdatum
		Private Phone:string
			i18n_fr=Téléphone (privé)
			i18n_nl=Telefoon (privé)
			i18n_no=Telefon (privat)
			i18n_sv=Telefon (privat)
			i18n_fi=Kotipuhelin
			i18n_de=Telefon (privat)
		Work Phone:string
			i18n_fr=Téléphone (travail)
			i18n_nl=Telefoon (werk)
			i18n_no=Telefon (Arbeid)
			i18n_sv=Telefon (Arbete)
			i18n_fi=Työpuhelin
			i18n_de=Telefon (geschäftl.)
		Cell Phone:string
			i18n_fr=GSM
			i18n_nl=GSM
			i18n_no=Mobil
			i18n_sv=Mobil
			i18n_fi=Matkapuhelin
			i18n_de=Mobil-Telefon
		Fax:string
			i18n_fr=Fax
			i18n_nl=Fax
			i18n_no=Faks
			i18n_sv=Fax
			i18n_fi=Faksi
			i18n_de=Fax
		E-Mail:string
			i18n_fr=E-Mail
			i18n_nl=E-Mail
			i18n_no=E-post
			i18n_sv=E-post
			i18n_fi=Sähköposti
			i18n_de=E-Mail
			format=email
		Web Site:string
			i18n_fr=Site web
			i18n_nl=Web site
			i18n_no=Hjemmeside
			i18n_sv=Hemsida
			i18n_fi=Kotisivu
			i18n_de=Web Seite
			format=website
			default=http://
		Category:string
			i18n_fr=Catégorie
			i18n_nl=Categorie
			i18n_no=Kategori
			i18n_sv=Kategori
			i18n_fi=Luokitus
			i18n_de=Kategorie
		Remarks:strings
			i18n_fr=Remarques
			i18n_nl=Opmerkingen
			i18n_no=Kommentarer
			i18n_sv=Kommentarer
			i18n_fi=Muistiinpanoja
			i18n_de=Bemerkungen
End


Begin subtables
	Address Book:AddressBook
		viewable as xlist, gladeform.
		absolutely not viewable as form.
		with every fields.
End

Begin locations
	AddressBook
		~/.gaby/
End

Begin misc
	Main window
		gladeform:Address Book
End

Begin plugins_options
	GladeForm:Address Book
		filename=gabyform.glade
End

