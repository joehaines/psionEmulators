# desc.videobase
# Author: Ron Bessems <R.E.M.W.Bessems@stud.tue.nl>
# Purpose: videobase
# Translations: Dutch, Finnish, French, German
# Comment:
#   It provides a <a href="http://www.stack.nl/~stilgar/videobase.html">videobase</a>
#   implementation using Gaby.

Begin tables
	videobase
		name:String
			i18n_nl=Naam
			i18n_fi=Nimi
			i18n_fr=Titre
			i18n_de=Titel
			description_nl=Titel van de film
			description_fi=Elokuvan nimi
			description_de=Filmtitel
			description=Title
		director:String
			i18n_nl=Regiseur
			i18n_fi=Ohjaaja
			i18n_fr=Réalisateur
			i18n_de=Regisseur
			description_nl=Regiseur van de film
			description_fi=Elokuvan ohjaaja
			description_de=Regisseur des Films
			description=The guy who directed this movie
		cast:String
			i18n_nl=Cast
			i18n_fi=Näyttelijät
			i18n_fr=Cast
			i18n_de=Besetzung
		length:Integer
			i18n_nl=Speelduur
			i18n_fi=Pituus
			i18n_fr=Durée
			i18n_de=Länge
			default=0
		releasedate:Date
			i18n_nl=Release datum
			i18n_fi=Julkaisupäivä
			i18n_fr=Date de sortie
			i18n_de=Freigabe-Datum
		dateseen:Date
			i18n_nl=Datum gezien
			i18n_fi=Ensikatseluni päivä 
			i18n_fr=Date de vision
			i18n_de=gesehen am
		genre:String
			i18n_nl=Genre
			i18n_fi=Tyylilaji
			i18n_fr=Genre
			i18n_de=Genre
		tape:String
			i18n_nl=Band
			i18n_fi=Nauha
			i18n_fr=Cassette
			i18n_de=Kassette
		counter:String
			i18n_nl=Band teller
			i18n_fi=Nauhan laskuri
			i18n_fr=Position
			i18n_de=Zähler
		remarks:Strings
			i18n_nl=Opmerkingen
			i18n_fi=Muistiinpanoja
			i18n_fr=Remarques
			i18n_de=Bemerkungen
End

Begin subtables
	videobase:videobase
		viewable as form.
		with only the following fields
			name:name
			director:director
			cast:cast
			length:length
			releasedate:releasedate
			dateseen:dateseen
			genre:genre
			tape:tape
			counter:counter
			remarks:remarks
	list:videobase
		i18n_nl=lijst
		i18n_fi=luettelo
		i18n_fr=liste
		i18n_de=Liste
		viewable as xlist,list.
		with only the following fields
			name:name
			director:director
			releasedate:releasedate
			genre:genre
			dateseen:dateseen
			tape:tape
End

Begin misc
	Main window
		list:list
			visible = yes
	Other windows
		form:videobase
			visible = yes
End
