      </locale>

      <locale name="en_CA">
        <short>trash URL handler</short>
        
      </locale>

      <locale name="en_GB">
        <short>wastebasket URL handler</short>
        
      </locale>

      <locale name="es">
        <short>Manipulador de URL trash</short>
        
      </locale>

      <locale name="fi">
        <short>trash-URL:ien käsittelin</short>
        
      </locale>

      <locale name="fr">
        <short>Gestionnaire d&apos;URLs trash</short>
        
      </locale>

      <locale name="gu">
        <short>કચરાપેટી URL handler</short>
        
      </locale>

      <locale name="hr">
        <short>rukovatelj odbačenog URL-a</short>
        
      </locale>

      <locale name="it">
        <short>Gestore URL trash</short>
        
      </locale>

      <locale name="ja">
        <short>trash URL ハンドラ</short>
        
      </locale>

      <locale name="ko">
        <short>trash URL 핸들러</short>
        
      </locale>

      <locale name="lt">
        <short>trash adresų programa</short>
        
      </locale>

      <locale name="mn">
        <short>trash URL тодорхойлогч</short>
        
      </locale>

      <locale name="ms">
        <short>Pengendali URL trash</short>
        
      </locale>

      <locale name="nl">
        <short>Actie voor trash URL</short>
        
      </locale>

      <locale name="nn">
        <short>handsamar for papirkorg-URL-ar</short>
        
      </locale>

      <locale name="no">
        <short>trash URL-håndterer</short>
        
      </locale>

      <locale name="pa">
        <short>trash ਯੂਅਾਰਅੈਲ਼ ਹੈਡਲਟ</short>
        
      </locale>

      <locale name="pl">
        <short>Program obsługujący adresy URL typu trash</short>
        
      </locale>

      <locale name="pt">
        <short>Manipulador de URL de lixo</short>
        
      </locale>

      <locale name="pt_BR">
        <short>Manipulador de URL lixeira</short>
        
      </locale>

      <locale name="ro">
        <short>gestionar adrese trash:</short>
        
      </locale>

      <locale name="ru">
        <short>Обработчик ссылок (URLs) типа trash</short>
        
      </locale>

      <locale name="sk">
        <short>Podpora URL pre kôš</short>
        
      </locale>

      <locale name="sq">
        <short>trajtues URL trash</short>
        
      </locale>

      <locale name="sr">
        <short>Руковалац trash адресама</short>
        
      </locale>

      <locale name="sr@Latn">
        <short>Rukovalac trash adresama</short>
        
      </locale>

      <locale name="sr@ije">
        <short>Руковалац trash адресама</short>
        
      </locale>

      <locale name="sv">
        <short>Hanterare för trash-URL:er</short>
        
      </locale>

      <locale name="th">
        <short>ตัวจัดการ trash URL</short>
        
      </locale>

      <locale name="tr">
        <short>trash URL işleticisi</short>
        
      </locale>

      <locale name="uk">
        <short>Обробник посилань (URL) типу trash</short>
        
      </locale>

      <locale name="vi">
        <short>Bộ xử lý URL trash</short>
        
      </locale>

      <locale name="zh_CN">
        <short>trash URL 处理程序</short>
        
