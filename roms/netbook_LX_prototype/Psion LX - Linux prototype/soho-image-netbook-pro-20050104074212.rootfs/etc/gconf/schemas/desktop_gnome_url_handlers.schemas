<?xml version="1.0"?>
<gconfschemafile>
  <schemalist>

    <schema>   
      <key>/schemas/desktop/gnome/url-handlers/trash/enabled</key>
      <applyto>/desktop/gnome/url-handlers/trash/enabled</applyto>
      <owner>gnome</owner>
      <type>bool</type>
      <default>true</default>
      <locale name="C">
        <short>Handle trash URLs</short>
        <long>Set to true to have a program specified in "command" handle trash URLs.</long>
      </locale>

      <locale name="af">
        <short>Hanteer trash-URL&apos;e</short>
        <long>Merk as waar sodat &apos;n program in &quot;command&quot; gespesifiseer trash-URL&apos;e hanteer.</long>
      </locale>

      <locale name="ar">
        <short>معالجة عناوين سلة المهملات</short>
        <long>إضبط لـ true لتخصيص برنامج لأمر معاينة عناوين trash (سلة المهملات).</long>
      </locale>

      <locale name="az">
        <short>trash URL-lərini aç</short>
        <long>Set to true to have a program specified in &quot;command&quot; handle trash URLs.</long>
      </locale>

      <locale name="bn">
        <short>trash ইউ-আর-এল সামলাও</short>
        <long>trash ইউ-আর-এল সামলানোর জন্য &quot;কম্যান্ড&quot;-এ নির্দিষ্ট প্রোগ্রাম ব্যবহার করার জন্য সত্য হিসাবে নির্ধারণ করুন</long>
      </locale>

      <locale name="ca">
        <short>Gestiona les URL trash</short>
        <long>Establiu a vertader per a que un programa especificat en «command» gestione les URL trash.</long>
      </locale>

      <locale name="cs">
        <short>Obsluhovat URL trash</short>
        <long>Nastavte na true, aby program určený v &quot;command&quot; obsluhoval URL trash.</long>
      </locale>

      <locale name="cy">
        <short>Ymdrin â LAU sbwriel</short>
        <long>Gosodwch hyn yn wir er mwyn i&apos;r rhaglen a benodir yn &quot;command&quot; i ymdrin â LAU sbwriel.</long>
      </locale>

      <locale name="da">
        <short>Håndtér trash-adresser</short>
        <long>Sæt til sand for at få programmet angiv i &quot;command&quot; til at håndtere trash-adresser.</long>
      </locale>

      <locale name="de">
        <short>trash-URLs handhaben</short>
        <long>Falls dieser Schlüssel wahr ist, handhabt das in »command« angegebene Programm trash-URLs.</long>
      </locale>

      <locale name="el">
        <short>Χειρισμός trash URLs</short>
        <long>Ορισμός σε true για  να έχετε ένα πρόγραμμα καθορισμένο στην &quot;εντολή&quot; για το χειρισμό trash URLs.</long>
      </locale>

      <locale name="en_CA">
        <short>Handle trash URLs</short>
        <long>Set to true to have a program specified in &quot;command&quot; handle trash URLs.</long>
      </locale>

      <locale name="en_GB">
        <short>Handle wastebasket URLs</short>
        <long>Set to true to have a program specified in &quot;command&quot; handle wastebasket URLs.</long>
      </locale>

      <locale name="es">
        <short>Manipula las URLs trash</short>
        <long>Establecer a «true» para tener un programa especificado en «comando» que manipule las URLs trash.</long>
      </locale>

      <locale name="fi">
        <short>Käsittele trash-URL:t</short>
        <long>Aseta todeksi, jos avaimessa &quot;command&quot; annettu komento käsittelee trash-URL:eja.</long>
      </locale>

      <locale name="fr">
        <short>Gère les URLs trash</short>
        <long>Définir à vrai pour que le programme spécifié dans « command » gère les URLs trash.</long>
      </locale>

      <locale name="gu">
        <short>હેન્ડલ કચરાપેટી URLs</short>
        <long>સાચુ સુયોજિત કરો માટે &quot;આદેશ&quot; હેન્ડલ કચરાપેટી URLsમાં કાર્યક્રમ સ્પષ્ટ કરેલ છે.</long>
      </locale>

      <locale name="hr">
        <short>Rukuje s odbačenim URL-ovima</short>
        <long>Postavite kako biste imali program određen u rukovatelju &quot;naredbe&quot; za odbačene URL-ove.</long>
      </locale>

      <locale name="it">
        <short>Gestione di URL trash</short>
        <long>Impostare a vero affiché in programma specificato in &quot;trash/command&quot; gestisca gli URL trash.</long>
      </locale>

      <locale name="ja">
        <short>&apos;trash URL&apos; の扱い方</short>
        <long>&apos;trash URL&apos; を扱うコマンドで指定したプログラムがある場合は TRUE にします。</long>
      </locale>

      <locale name="ko">
        <short>trash URL을 처리합니다</short>
        <long>참이면 &quot;command&quot;에 trash URL을 처리하는 프로그램이 들어갑니다.</long>
      </locale>

      <locale name="lt">
        <short>Apdoroja trash adresus</short>
        <long>Nustatykite teigiamai norėdami, kad nurodyta programa apdorotų trash adresus.</long>
      </locale>

      <locale name="mn">
        <short>trash URLs тодорхойлогч</short>
        <long>Энэ түлхүүр үнэн бол, програмд trash URLs-н тодорхойлогчийг »command« -д өгнө.</long>
      </locale>

      <locale name="ms">
        <short>Mengendali URL trash</short>
        <long>Ditetapkan sebagai benar untuk mempunyai program dinyatakan di &quot;command&quot; mengendali URL trash.</long>
      </locale>

      <locale name="nl">
        <short>trash URL&apos;s afhandelen</short>
        <long>Indien waar handelt het programma gegeven in &quot;opdracht&quot; de trash URL&apos;s af.</long>
      </locale>

      <locale name="nn">
        <short>Handsama papirkorg-URL-ar</short>
        <long>Sett til «true» for å la programmet i «command» handsama papirkorg-URL-ar.</long>
      </locale>

      <locale name="no">
        <short>Håndter papirkurv-URLer</short>
        <long>Sett til sann for å la et program oppgitt i «command» håndtere trash-URLer.</long>
      </locale>

      <locale name="pa">
        <short>ਹੈਡਲ trash ਯੂਅਾਰਅੈਲ਼</short>
        <long>ਸਹੀ ਕਰ ਦਿੳੁ ਤ੾ ਕਿ ਕਾਰਜ ਜੋ ਕਿ &quot;ਕਮ੾ਡ&quot; ਵਿੱਚ ਨਿਰਧਾਰਿਤ ਹੈ, trash ਯੂਅਾਰਅੈਲ਼ ਨੰੂ ਵਰਤ ਸਕੇ</long>
      </locale>

      <locale name="pl">
        <short>Obsługuje adresy URL typu trash</short>
        <long>Określa, czy program podany w &quot;poleceniu&quot; ma obsługiwać adresy URL typu trash.</long>
      </locale>

      <locale name="pt">
        <short>Manipulador de URLs de lixo</short>
        <long>Definir como verdadeiro para que a aplicação especificada em &quot;command&quot; manipule URLs de lixo.</long>
      </locale>

      <locale name="pt_BR">
        <short>Manipular URLs lixeira</short>
        <long>Marque verdadeiro para que o programa especificado no &quot;comando&quot; trate URLs lixeira.</long>
      </locale>

      <locale name="ro">
        <short>Gestionează adresele trash:</short>
        <long>TRUE pentru ca programul „command” să gestioneze adresele trash.</long>
      </locale>

      <locale name="ru">
        <short>Обрабатывать ссылки (URLs) типа trash</short>
        <long>Если этот ключ установлен, то программа, определённая в ключе &quot;command&quot;, будет обрабатывать ссылки (URLs) типа trash.</long>
      </locale>

      <locale name="sk">
        <short>Podpora URL pre kôš</short>
        <long>Nastavte na true, ak program zadaný v &quot;príkaz&quot; podporuje URL pre kôš.</long>
      </locale>

      <locale name="sq">
        <short>Trajton URLtë trash</short>
        <long>Vendose në &quot;true&quot; për të patur një program të caktuar tek &quot;komanda&quot; që trajton URLtë trash.</long>
      </locale>

      <locale name="sr">
        <short>Баратај trash адресама</short>
        <long>Укључите ако желите да програм наведен у „command“ барата trash адресама.</long>
      </locale>

      <locale name="sr@Latn">
        <short>Barataj trash adresama</short>
        <long>Uključite ako želite da program naveden u „command“ barata trash adresama.</long>
      </locale>

      <locale name="sr@ije">
        <short>Баратај trash адресама</short>
        <long>Укључите ако желите да програм наведен у „command“ барата trash адресама.</long>
      </locale>

      <locale name="sv">
        <short>Hantera trash-URL:er</short>
        <long>Sätt detta till sant för att ett program som är angivet i &quot;command&quot; ska hantera trash-URL:er.</long>
      </locale>

      <locale name="th">
        <short>จัดการ URL ชนิด trash</short>
        <long>ตั้งเป็น true ถ้าต้องการให้โปรแกรมใน &quot;command&quot; จัดการ URL ชนิด trash</long>
      </locale>

      <locale name="tr">
        <short>Trash URL&apos;lerini işlet</short>
        <long>Eğer seçiliyse, &quot;command&quot; da belirtilen programın trash URL&apos;lerini işletmesi için ayalalanır.</long>
      </locale>

      <locale name="uk">
        <short>Обробляти посилання (URL) типу trash</short>
        <long>Якщо ввімкнено, тоді вказана у ключі &quot;command&quot; програма буде обробляти посилання (URL) типу trash.</long>
      </locale>

      <locale name="vi">
        <short>Xử lý URL Sọt rác</short>
        
      </locale>

      <locale name="zh_CN">
        <short>处理 trash URL</short>
        <long>设为真可在“命令”中指定一个程序来处理 trash URL。</long>
      </locale>
    </schema>
    <schema>
      <key>/schemas/desktop/gnome/url-handlers/trash/command</key>
      <applyto>/desktop/gnome/url-handlers/trash/command</applyto>
      <owner>gnome</owner>
      <type>string</type>
      <default>nautilus "%s"</default>
      <locale name="C">
        <short>trash URL handler</short>
        <long></long>
      </locale>

      <locale name="af">
        <short>trash-URL-hanteerder</short>
        
      </locale>

      <locale name="ar">
        <short>معالج عناوين سلات المهملات</short>
        
      </locale>

      <locale name="az">
