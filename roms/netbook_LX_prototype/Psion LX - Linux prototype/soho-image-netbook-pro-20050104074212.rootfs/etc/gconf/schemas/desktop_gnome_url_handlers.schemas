   <schema>   
     <key>/schemas/desktop/gnome/url-handlers/ghelp/enabled</key>
     <applyto>/desktop/gnome/url-handlers/ghelp/enabled</applyto>
     <owner>gnome</owner>
     <type>bool</type>
     <default>true</default>
     <locale name="C">
       <short>Handle ghelp URLs</short>
       <long>Set to true to have a program specified in "command" handle ghelp URLs.</long>
     </locale>

     <locale name="af">
       <short>Hanteer ghelp-URL&apos;e</short>
       <long>Merk as waar sodat &apos;n program in &quot;command&quot; gespesifiseer ghelp-URL&apos;e hanteer.</long>
     </locale>

     <locale name="ar">
       <short>معالجة عناوين جهالب</short>
