   <schema>   
     <key>/schemas/desktop/gnome/url-handlers/man/enabled</key>
     <applyto>/desktop/gnome/url-handlers/man/enabled</applyto>
     <owner>gnome</owner>
     <type>bool</type>
     <default>true</default>
     <locale name="C">
       <short>Handle man URLs</short>
       <long>Set to true to have a program specified in "command" handle man URLs.</long>
     </locale>

     <locale name="af">
       <short>Hanteer man-URL&apos;e</short>
       <long>Merk as waar sodat &apos;n program in &quot;command&quot; gespesifiseer man-URL&apos;e hanteer.</long>
