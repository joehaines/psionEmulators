   <schema>   
     <key>/schemas/desktop/gnome/url-handlers/https/enabled</key>
     <applyto>/desktop/gnome/url-handlers/https/enabled</applyto>
     <owner>gnome</owner>
     <type>bool</type>
     <default>true</default>
