<?xml version="1.0" encoding="UTF-8"?>
<plugin id="Gnumeric_fnerlang">
	<information>
		<name>Erlang Functions</name>
		<name xml:lang="en_CA">Erlang Functions</name>
		<name xml:lang="ja">アーラン関数</name>
		<name xml:lang="nl">Erlang functies</name>
		<description>Functions to help Erlang Analysis</description>
		<description xml:lang="en_CA">Functions to help Erlang Analysis</description>
		<description xml:lang="ja">アーラン解析を補助するための関数</description>
		<description xml:lang="nl">Functies voor hulp bij Erlang-analyse</description>
	</information>
	<loader type="Gnumeric_Builtin:module">
		<attribute value="erlang.la" name="module_file"/>
	</loader>
	<services>
		<service type="function_group" id="erlang">
			<category>Erlang</category>
			<category xml:lang="cs">Erlang</category>
			<category xml:lang="en_CA">Erlang</category>
			<category xml:lang="ja">アーラン</category>
			<category xml:lang="nl">Erlang</category>
			<functions>
				<function name="probblock"/>
				<function name="offtraf"/>
				<function name="dimcirc"/>
				<function name="offcap"/>
			</functions>
		</service>
	</services>
</plugin>