<?xml version="1.0" encoding="UTF-8"?>
<plugin id="GOffice_plot_barcol">
	<information>
		<name>Charting : Bar/Col/Line/Area</name>
		<name xml:lang="cs">Kreslení grafů: pruh/sloup/čáry/oblast</name>
		<name xml:lang="en_CA">Charting : Bar/Col/Line/Area</name>
		<name xml:lang="en_GB">Charting : Bar/Col/Line/Area</name>
		<name xml:lang="es">Diagrama: Bar/Col/Linea/Área</name>
		<name xml:lang="ja">グラフ: 棒/列/行/エリア</name>
		<name xml:lang="pt_BR">Gráficos: Barra/Col/Linha/Área</name>
		<name xml:lang="sv">Grafritning : Stapel/Kolumn/Linje/Yta</name>
		<description>Line, Area, Bar and Column plots</description>
		<description xml:lang="cs">Čárové, plošné, pruhové a sloupcové grafy</description>
		<description xml:lang="en_CA">Line, Area, Bar and Column plots</description>
		<description xml:lang="en_GB">Line, Area, Bar and Column plots</description>
		<description xml:lang="es">Diagramas de línea, área, barras y columnas</description>
		<description xml:lang="ja">線、エリア、棒、列でプロットします</description>
		<description xml:lang="nb">Linje-, område-, søyle- og kolonneplott</description>
		<description xml:lang="nl">Lijn, gebied, balk en kolom-diagrammen</description>
		<description xml:lang="no">Linje-, område-, søyle- og kolonneplott</description>
		<description xml:lang="pt_BR">Gráficos de Linha, Área, Barra e Coluna</description>
		<description xml:lang="sv">Linje, area, stapel och kolumngrafer</description>
	</information>
	<loader type="Gnumeric_Builtin:module">
		<attribute value="barcol" name="module_file"/>
	</loader>
	<services>
		<service type="plot_engine" id="GogLinePlot">
			<information>
				<description>Line plotting engine</description>
				<description xml:lang="cs">Engine kreslení čar</description>
				<description xml:lang="de">Liniengraph-Engine</description>
				<description xml:lang="en_CA">Line plotting engine</description>
				<description xml:lang="en_GB">Line plotting engine</description>
				<description xml:lang="es">Motor de dibujo de líneas</description>
				<description xml:lang="hr">Sustav za iscrtavanje linija</description>
				<description xml:lang="ja">線プロットエンジン</description>
				<description xml:lang="nl">Lijn plot-motor</description>
				<description xml:lang="pl">Mechanizm rysowania linii</description>
				<description xml:lang="pt">Motor gráficos linhas</description>
				<description xml:lang="pt_BR">Ferramenta de plotagem de linha</description>
				<description xml:lang="sk">Nástroj na kreslenie čiarových grafov</description>
				<description xml:lang="sr">Систем за исцртавање линија</description>
				<description xml:lang="sr@Latn">Sistem za iscrtavanje linija</description>
				<description xml:lang="sv">Linjediagramsritmotor</description>
			</information>
		</service>
		<service type="plot_engine" id="GogAreaPlot">
			<information>
				<description>Area plotting engine</description>
				<description xml:lang="cs">Engine kreslení oblastí</description>
				<description xml:lang="de">Flächengraph-Engine</description>
				<description xml:lang="en_CA">Area plotting engine</description>
				<description xml:lang="en_GB">Area plotting engine</description>
				<description xml:lang="es">Motor de dibujo de áreas</description>
				<description xml:lang="hr">Sistem za iscrtavanje područja.</description>
				<description xml:lang="ja">エリアプロットエンジン</description>
				<description xml:lang="nb">Motor for områdeplott</description>
				<description xml:lang="nl">Gebied plot-motor</description>
				<description xml:lang="no">Motor for områdeplott</description>
				<description xml:lang="pt">Motor gráficos área</description>
				<description xml:lang="pt_BR">Ferramenta de plotagem de área</description>
				<description xml:lang="sk">Nástroj pre kreslenie oblastí</description>
				<description xml:lang="sr">Систем за исцртавање области</description>
				<description xml:lang="sr@Latn">Sistem za iscrtavanje oblasti</description>
				<description xml:lang="sv">Cirkeldiagramsritmotor</description>
			</information>
		</service>
		<service type="plot_engine" id="GogBarColPlot">
			<information>
				<description>Bar/Col plotting engine</description>
				<description xml:lang="ca">Motor de Traçador de Bar/Col</description>
				<description xml:lang="cs">Engine kreslení pruhů/sloupců</description>
				<description xml:lang="de">Balken-/Säulengraph-Engine</description>
				<description xml:lang="en_CA">Bar/Col plotting engine</description>
				<description xml:lang="en_GB">Bar/Col plotting engine</description>
				<description xml:lang="es">Motor de dibujo de barras/columnas</description>
				<description xml:lang="fr">Moteur de dessin barres/colonnes</description>
				<description xml:lang="hr">Sistem za iscrtavanje traka/kolona</description>
				<description xml:lang="ja">棒/列プロットエンジン</description>
				<description xml:lang="nl">Balk/Kolom plot-motor</description>
				<description xml:lang="pt">Motor de gráficos Barras/Colunas</description>
				<description xml:lang="pt_BR">Ferramenta de plotagem de Bar/Col</description>
				<description xml:lang="sk">Nástroj na kreslenie pruhov</description>
				<description xml:lang="sr">Систем за исцртавање трака/колона</description>
				<description xml:lang="sr@Latn">Sistem za iscrtavanje traka/kolona</description>
				<description xml:lang="sv">Stapel/kolumn ritmotor</description>
			</information>
		</service>
		<service type="plot_type" id="1.5d">
			<file>plot-types.xml</file>
			<information>
				<description>Default 1.5d plot types</description>
				<description xml:lang="cs">Implicitní typy grafů 1.5d</description>
				<description xml:lang="de">1.5d-Vorgabediagrammtypen</description>
				<description xml:lang="en_CA">Default 1.5d plot types</description>
				<description xml:lang="en_GB">Default 1.5d plot types</description>
				<description xml:lang="es">Tipos de gráficas preestablecidas para 1.5d</description>
				<description xml:lang="hr">Vrste uobičajenog 1.5d crtanja</description>
				<description xml:lang="ja">デフォルト 1.5d プロットタイプ</description>
				<description xml:lang="nb">Forvalgte typer 1.5d plott</description>
				<description xml:lang="nl">Standaard 1.5d plot-types</description>
				<description xml:lang="no">Forvalgte typer 1.5d plott</description>
				<description xml:lang="pl">Domyślne typy wykresu 1.5d</description>
				<description xml:lang="pt">Tipos de gráficos 1.5d por omissão</description>
				<description xml:lang="pt_BR">Tipos de Gráficos de 1.5d padrão</description>
				<description xml:lang="sk">Štandardné typy 1.5d</description>
				<description xml:lang="sr">Подразумеване врсте 1,5D исцртавања</description>
				<description xml:lang="sr@Latn">Podrazumevane vrste 1,5D iscrtavanja</description>
				<description xml:lang="sv">Standard 1.5d-graftyper</description>
			</information>
		</service>
	</services>
</plugin>