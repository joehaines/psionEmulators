<?xml version="1.0" encoding="UTF-8"?>
<plugin id="GOffice_plot_pie">
	<information>
		<name>Charting : Pie/Ring</name>
		<name xml:lang="cs">Kreslení grafů : Koláč/prstenec</name>
		<name xml:lang="en_CA">Charting : Pie/Ring</name>
		<name xml:lang="en_GB">Charting : Pie/Ring</name>
		<name xml:lang="es">Diagrama: Tarta/Anillo</name>
		<name xml:lang="ja">グラフ: パイ/円</name>
		<name xml:lang="pt_BR">Gráficos: Pizza/Anel</name>
		<name xml:lang="sv">Graf: cirkel/ring</name>
		<description>Pie and Ring plots</description>
		<description xml:lang="cs">Koláčové a prstencové grafy</description>
		<description xml:lang="en_CA">Pie and Ring plots</description>
		<description xml:lang="en_GB">Pie and Ring plots</description>
		<description xml:lang="es">Diag de tartas y anillos</description>
		<description xml:lang="ja">パイと円でプロットします。</description>
		<description xml:lang="pt_BR">Gráficos do tipo Pizza e Anel</description>
		<description xml:lang="sv">Cirkel och ringgrafer</description>
	</information>
	<loader type="Gnumeric_Builtin:module">
		<attribute value="pie" name="module_file"/>
	</loader>
	<services>
		<service type="plot_engine" id="GogRingPlot">
			<information>
				<description>Ring plotting engine</description>
				<description xml:lang="cs">Engine kreslení prstenců</description>
				<description xml:lang="de">Ringgraph-Engine</description>
				<description xml:lang="en_CA">Ring plotting engine</description>
				<description xml:lang="en_GB">Ring plotting engine</description>
				<description xml:lang="es">Motor de dibujo de anillos</description>
				<description xml:lang="fr">Moteur de dessin d'anneau</description>
				<description xml:lang="hr">Sustav za iscrtavanje prstena</description>
				<description xml:lang="ja">円グラフプロットエンジン</description>
				<description xml:lang="nl">Ring plot-motor</description>
				<description xml:lang="pt">Motor desenho círculos</description>
				<description xml:lang="pt_BR">Mecanismo de plotar Anéis</description>
				<description xml:lang="ru">Модуль отображения кольцевой диаграммы</description>
				<description xml:lang="sk">Kruhové grafy</description>
				<description xml:lang="sr">Систем за исцртавање прстена</description>
				<description xml:lang="sr@Latn">Sistem za iscrtavanje prstena</description>
				<description xml:lang="sv">Ringdiagramsritmotor</description>
			</information>
		</service>
		<service type="plot_engine" id="GogPiePlot">
			<information>
				<description>Pie plotting engine</description>
				<description xml:lang="ca">Motor de traçador de pastissos</description>
				<description xml:lang="cs">Engine kreslení koláčů</description>
				<description xml:lang="de">Kreisgraph-Engine</description>
				<description xml:lang="en_CA">Pie plotting engine</description>
				<description xml:lang="en_GB">Pie plotting engine</description>
				<description xml:lang="es">Motor de dibujo de tartas</description>
				<description xml:lang="fr">Moteur de dessin de camembert</description>
				<description xml:lang="hr">Sustav za iscrtavanje pita</description>
				<description xml:lang="ja">パイグラフプロットエンジン</description>
				<description xml:lang="nl">Taart plot-motor</description>
				<description xml:lang="pt">Motor desenho queijos</description>
				<description xml:lang="pt_BR">Mecanismo de plotar Pizzas</description>
				<description xml:lang="ru">Модуль отображения круговой диаграммы</description>
				<description xml:lang="sk">Koláčové grafy</description>
				<description xml:lang="sr">Систем за исцртавање пита</description>
				<description xml:lang="sr@Latn">Sistem za iscrtavanje pita</description>
				<description xml:lang="sv">Cirkeldiagramsritmotor</description>
			</information>
		</service>
		<service type="plot_type" id="pie">
			<file>plot-types.xml</file>
			<information>
				<description>Default pie types</description>
				<description xml:lang="ca">Tipus de pastís per defecte</description>
				<description xml:lang="cs">Výchozí typ koláče</description>
				<description xml:lang="de">Vorgabe-Kreistypen</description>
				<description xml:lang="en_CA">Default pie types</description>
				<description xml:lang="en_GB">Default pie types</description>
				<description xml:lang="es">Tipos de tarta predeterminados</description>
				<description xml:lang="fr">Types de camemberts par défaut</description>
				<description xml:lang="hr">Uobičajeni tip pite</description>
				<description xml:lang="ja">デフォルトパイグラフタイプ</description>
				<description xml:lang="nb">Forvalgte kaketyper</description>
				<description xml:lang="nl">Standaard taarttypen</description>
				<description xml:lang="no">Forvalgte kaketyper</description>
				<description xml:lang="pt">Tipos de queijo por omissão</description>
				<description xml:lang="pt_BR">Tipos padrão de pizza</description>
				<description xml:lang="ru">Типы круговых диаграмм по умолчанию</description>
				<description xml:lang="sk">Štandardné typy koláčových</description>
				<description xml:lang="sr">Подразумеване врсте „пите“</description>
				<description xml:lang="sr@Latn">Podrazumevane vrste „pite“</description>
				<description xml:lang="sv">Standard-cirkeltyper</description>
			</information>
		</service>
	</services>
</plugin>