### Window operation short cuts 

# <Alt>n=next
# <Alt>p=prev
# <Alt>c=close
<mod3>d=desktop
# <Alt>m=!mbcontrol -mbmenu

### App launching.

# <ctrl><alt>x=!xterm
# <ctrl><alt>r=!rxvt
<mod3>c=!xtscal
<mod3>Alt_L=!gkdial
<ctrl><alt>BackSpace=!reset.sh

### App launching with startup notify

# <ctrl><alt>e=!!gpe-calender

### windows style key shortcuts

<alt>Tab=next
<alt><shift>Tab=prev

# <alt>space=taskmenu
<alt>escape=desktop
<alt>4=close

